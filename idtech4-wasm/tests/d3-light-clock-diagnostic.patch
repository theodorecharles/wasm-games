+// TEST-ONLY: retained diagnostic image, never part of the production patch.
+static int d3LightMode = -1;
+static int d3LightSamples = 0;
+static int d3LightNonzero = 0;
+static float d3LightMax = 0.0f;
+static int d3LightLastRecord = -1000;
+float D3LightDiagnosticAmplitude(float amplitude) {
+	++d3LightSamples;
+	if (amplitude > 0.0f) ++d3LightNonzero;
+	if (amplitude > d3LightMax) d3LightMax = amplitude;
+	return d3LightMode == 0 ? 0.0f : amplitude;
+}
+static void D3LightZero_f(const idCmdArgs &) {
+	d3LightMode = 0;
+	d3LightLastRecord = -1000;
+	console->Close();
+}
+static void D3LightNormal_f(const idCmdArgs &) {
+	d3LightMode = -1;
+	d3LightLastRecord = -1000;
+	console->Close();
+}
+void D3LightDiagnosticView(const renderView_t *view, int health, bool spectating) {
+	const int now = Sys_Milliseconds();
+	if (view && now - d3LightLastRecord >= 500) {
+		d3LightLastRecord = now;
+		common->Printf("D3LIGHT {\"at\":%d,\"clock\":%d,\"mode\":%d,\"health\":%d,\"spectating\":%d,\"samples\":%d,\"nonzero\":%d,\"maxAmplitude\":%.6f,\"origin\":[%.6f,%.6f,%.6f],\"axis\":[%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f],\"fov\":[%.6f,%.6f]}\n",
+			now, soundSystemLocal.GetCurrent44kHzTime(), d3LightMode, health, int(spectating),
+			d3LightSamples, d3LightNonzero, d3LightMax,
+			view->vieworg[0], view->vieworg[1], view->vieworg[2],
+			view->viewaxis[0][0], view->viewaxis[0][1], view->viewaxis[0][2],
+			view->viewaxis[1][0], view->viewaxis[1][1], view->viewaxis[1][2],
+			view->viewaxis[2][0], view->viewaxis[2][1], view->viewaxis[2][2], view->fov_x, view->fov_y);
+	}
+	d3LightSamples = d3LightNonzero = 0;
+	d3LightMax = 0.0f;
+}
 
