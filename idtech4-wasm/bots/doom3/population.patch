+// A zero setting leaves explicit/manual bot commands alone. Positive settings
+// request that many bots; -1 fills the configured match capacity. Humans always
+// have priority, including spectators who still occupy a network-client slot.
+int botAi::PopulationTarget(int requested, int maximum, int humans)
+{
+    if (requested == 0) return -1;
+    const int capacity = Min(Max(maximum, 0), MAX_CLIENTS);
+    const int room = Max(0, capacity - Max(0, humans));
+    const int wanted = requested < 0 ? BOT_MAX_BOTS : Min(requested, BOT_MAX_BOTS);
+    return Min(wanted, room);
+}
+
+void botAi::MaintainPopulation(void)
+{
+    if (!BOT_ENABLED() || harm_si_autoFillBots.GetInteger() == 0) return;
+
+    int humans = 0, liveBots = 0;
+    for (int slot = 0; slot < MAX_CLIENTS; ++slot) {
+        idPlayer *player = FindBotClient(slot);
+        if (!player) continue;
+        if (!player->IsBot()) ++humans;
+        else if (player->IsBotAvailable()) ++liveBots;
+        else RemoveBot(slot); // Do not count an orphan body as a working bot.
+    }
+    const int target = PopulationTarget(harm_si_autoFillBots.GetInteger(),
+        gameLocal.serverInfo.GetInt("si_maxPlayers"), humans);
+
+    // Removal is immediate; never remove a human and never exceed capacity
+    // while waiting for the next bounded spawn retry.
+    for (int slot = BOT_START_INDEX; liveBots > target && slot < MAX_CLIENTS; ++slot) {
+        idPlayer *player = FindBotClient(slot);
+        if (player && player->IsBotAvailable() && RemoveBot(slot)) --liveBots;
+    }
+    if (liveBots >= target) return;
+
+    // Map time can reset. Retry missing navigation/definitions at most once a
+    // second, rather than spamming warnings/spawns every engine frame.
+    static int lastAttempt = -1000;
+    if (gameLocal.time >= lastAttempt &&
+        static_cast<unsigned int>(gameLocal.time) - static_cast<unsigned int>(lastAttempt) < 1000u) return;
+    lastAttempt = gameLocal.time;
+    if (!AllowBotOperation()) return;
+
+    idStrList definitions;
+    const int count = GetBotDefs(definitions);
+    if (count <= 0) return;
+    while (liveBots < target) {
+        const int index = gameLocal.random.RandomInt(count);
+        if (AddBot(definitions[index]) < 0) break;
+        ++liveBots;
+    }
+}
