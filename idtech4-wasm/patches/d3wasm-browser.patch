+AL_API void AL_APIENTRY alSourcei( ALuint id, ALenum param, ALint value ) {
+	d3wasmALSource_t *source = D3WASM_Source( id );
+	if ( !source ) return;
+	if ( param == AL_BUFFER ) {
+		source->buffer = value;
+		source->queueCount = 0;
+	} else if ( param == AL_LOOPING ) {
+		source->looping = value == AL_TRUE;
+	}
+	D3WASM_AudioSourceInt( id, param, value );
+}
