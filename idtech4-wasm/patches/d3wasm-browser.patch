+	Testmodel console commands
+
+***********************************************************************/
+
+/*
+=================
+idTestModel::KeepTestModel_f
+
+Makes the current test model permanent, allowing you to place
+multiple test models
+=================
+*/
+void idTestModel::KeepTestModel_f( const idCmdArgs &args ) {
