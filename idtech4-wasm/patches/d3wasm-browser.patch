+AL_API void AL_APIENTRY alBufferData( ALuint id, ALenum format, const ALvoid *data, ALsizei size, ALsizei frequency ) {
+	d3wasmALBuffer_t *buffer = D3WASM_Buffer( id );
+	if ( !buffer || !data || size <= 0 || frequency <= 0 ) {
+		d3wasmLastError = AL_INVALID_VALUE;
+		return;
+	}
+	const int channels = ( format == AL_FORMAT_STEREO8 || format == AL_FORMAT_STEREO16 ) ? 2 : 1;
+	const int bytesPerSample = ( format == AL_FORMAT_MONO8 || format == AL_FORMAT_STEREO8 ) ? 1 : 2;
+	const int frameBytes = channels * bytesPerSample;
+	const int frames = size / ( frameBytes > 1 ? frameBytes : 1 );
+	const int durationMsec = ( frames * 1000 ) / frequency;
+	buffer->durationMsec = durationMsec > 1 ? durationMsec : 1;
+	D3WASM_AudioBufferData( id, format, data, size, frequency );
+}
