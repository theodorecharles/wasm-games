+AL_API void AL_APIENTRY alDeleteBuffers( ALsizei count, const ALuint *buffers ) {
+	for ( int i = 0; i < count; ++i ) {
+		const ALuint id = buffers[i];
+		if ( id > 0 && id < D3WASM_MAX_AL_BUFFERS && d3wasmBuffers[id].alive ) {
