+static int d3wasmLastBrowserState = -1;
+static int d3wasmLastResumeAvailable = -1;
+
+static int D3WASM_CurrentBrowserState() {
+	if ( console->Active() ) {
+		return 3;
+	}
+	if ( !sessLocal.mapSpawned ) {
+		return 0;
+	}
+	return sessLocal.guiActive != NULL ? 2 : 1;
+}
+
+static void D3WASM_ReportBrowserState() {
+	const int state = D3WASM_CurrentBrowserState();
+	const int resumeAvailable = sessLocal.mapSpawned &&
+		( state == 3 || sessLocal.guiActive == sessLocal.guiMainMenu );
+	if ( state == d3wasmLastBrowserState && resumeAvailable == d3wasmLastResumeAvailable ) {
+		return;
+	}
+	d3wasmLastBrowserState = state;
+	d3wasmLastResumeAvailable = resumeAvailable;
+	EM_ASM( {
+		postMessage( {
+			type: 'engine-state',
+			state: $0 === 1 ? 'gameplay' : ($0 === 0 ? 'menu' : 'paused'),
+			inputMode: $0 === 1 ? 'gameplay' : ($0 === 3 ? 'console' : 'menu'),
+			resumeAvailable: $1 !== 0
+		} );
+	}, state, resumeAvailable );
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void D3WASM_BrowserOpenMenu() {
+	// Pointer lock loss is how browsers deliver Escape while captured.  Route
+	// it through the session's normal Escape handling so an in-game cinematic
+	// is skipped via game->HandleESC(), while ordinary gameplay opens the menu.
+	sysEvent_t event;
+	memset( &event, 0, sizeof( event ) );
+	event.evType = SE_KEY;
+	event.evValue = K_HOME;
+	event.evValue2 = 1;
+	sessLocal.ProcessEvent( &event );
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void D3WASM_BrowserCapture( int captured ) {
+	Sys_GrabMouseCursor( captured != 0 );
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void D3WASM_BrowserPointer( int x, int y, int relative ) {
+	if ( !relative && sessLocal.guiActive != NULL ) {
+		sessLocal.guiActive->SetCursor( x, y );
+		return;
+	}
+	SDL_Event event;
+	memset( &event, 0, sizeof( event ) );
+	event.type = SDL_MOUSEMOTION;
+	event.motion.xrel = x;
+	event.motion.yrel = y;
+	SDL_PushEvent( &event );
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void D3WASM_BrowserPointerButton( int browserButton, int down ) {
+	SDL_Event event;
+	memset( &event, 0, sizeof( event ) );
+	event.type = down ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+	event.button.state = down ? SDL_PRESSED : SDL_RELEASED;
+	event.button.button = browserButton == 1 ? SDL_BUTTON_MIDDLE
+		: ( browserButton == 2 ? SDL_BUTTON_RIGHT : static_cast<Uint8>( SDL_BUTTON_LEFT + browserButton ) );
+	SDL_PushEvent( &event );
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void D3WASM_BrowserKey( int scan, int key, int down, int repeat ) {
+	if ( down && scan == SDL_SCANCODE_ESCAPE && sessLocal.mapSpawned &&
+		sessLocal.guiActive == sessLocal.guiMainMenu && !console->Active() ) {
+		sessLocal.ExitMenu();
+		D3WASM_ReportBrowserState();
+		return;
+	}
+	SDL_Event event;
+	memset( &event, 0, sizeof( event ) );
+	event.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+	event.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+	event.key.repeat = repeat ? 1 : 0;
+	event.key.keysym.scancode = static_cast<SDL_Scancode>( scan );
+	event.key.keysym.sym = key != 0 ? static_cast<SDL_Keycode>( key ) : SDL_GetKeyFromScancode( event.key.keysym.scancode );
+	SDL_PushEvent( &event );
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void D3WASM_BrowserText( int codepoint ) {
+	if ( codepoint <= 0 || codepoint > 0x7f ) {
+		return;
+	}
+	SDL_Event event;
+	memset( &event, 0, sizeof( event ) );
+	event.type = SDL_TEXTINPUT;
+	event.text.text[0] = static_cast<char>( codepoint );
+	event.text.text[1] = '\0';
+	SDL_PushEvent( &event );
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void D3WASM_BrowserCommand( const char *command ) {
+	if ( command == NULL || command[0] == '\0' ) {
+		return;
+	}
+	cmdSystem->BufferCommandText( CMD_EXEC_APPEND, command );
+	cmdSystem->BufferCommandText( CMD_EXEC_APPEND, "\n" );
+}
