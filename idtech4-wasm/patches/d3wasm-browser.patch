+AL_API void AL_APIENTRY alSourceQueueBuffers( ALuint id, ALsizei count, const ALuint *buffers ) {
+	d3wasmALSource_t *source = D3WASM_Source( id );
+	if ( !source || !buffers || count <= 0 ) return;
+	const int available = D3WASM_MAX_AL_QUEUE - source->queueCount;
+	const int appendCount = static_cast<int>( count ) < available ? static_cast<int>( count ) : available;
+	for ( int i = 0; i < appendCount; ++i ) {
+		source->queue[source->queueCount++] = buffers[i];
+	}
+	D3WASM_AudioSourceQueue( id, appendCount, buffers );
+}
+
+AL_API void AL_APIENTRY alSourceUnqueueBuffers( ALuint id, ALsizei count, ALuint *buffers ) {
+	d3wasmALSource_t *source = D3WASM_Source( id );
+	if ( !source || count <= 0 ) return;
+	const int removeCount = static_cast<int>( count ) < source->queueCount ? static_cast<int>( count ) : source->queueCount;
+	int removedDuration = 0;
+	for ( int i = 0; i < removeCount; ++i ) {
+		if ( buffers ) buffers[i] = source->queue[i];
+		removedDuration += D3WASM_BufferDuration( source->queue[i] );
+	}
+	for ( int i = removeCount; i < source->queueCount; ++i ) {
+		source->queue[i - removeCount] = source->queue[i];
+	}
+	source->queueCount -= removeCount;
+	source->startedMsec += removedDuration;
+	D3WASM_AudioSourceUnqueue( id, removeCount );
+}
+
+AL_API void AL_APIENTRY alGetSourcei( ALuint id, ALenum param, ALint *value ) {
+	if ( !value ) return;
+	d3wasmALSource_t *source = D3WASM_Source( id );
+	if ( !source ) {
+		*value = 0;
+		return;
+	}
+	if ( param == AL_BUFFERS_PROCESSED ) {
+		*value = D3WASM_ProcessedBuffers( source );
+		return;
+	}
+	if ( param == AL_SOURCE_STATE ) {
+		if ( source->playing && !source->paused && source->queueCount == 0 && !source->looping ) {
+			if ( emscripten_get_now() - source->startedMsec >= D3WASM_BufferDuration( source->buffer ) ) {
+				source->playing = false;
+			}
+		}
+		*value = source->paused ? AL_PAUSED : ( source->playing ? AL_PLAYING : AL_STOPPED );
+		return;
+	}
+	*value = 0;
+}
+
+AL_API void AL_APIENTRY alSourcePlay( ALuint id ) {
+	d3wasmALSource_t *source = D3WASM_Source( id );
+	if ( !source ) return;
+	source->playing = true;
+	source->paused = false;
+	source->startedMsec = emscripten_get_now();
+	D3WASM_AudioSourceAction( id, 1 );
+}
+
+AL_API void AL_APIENTRY alSourceStop( ALuint id ) {
+	d3wasmALSource_t *source = D3WASM_Source( id );
+	if ( !source ) return;
+	source->playing = false;
+	source->paused = false;
+	D3WASM_AudioSourceAction( id, 0 );
+}
+
+AL_API void AL_APIENTRY alSourcePause( ALuint id ) {
+	d3wasmALSource_t *source = D3WASM_Source( id );
+	if ( !source ) return;
+	source->playing = false;
+	source->paused = true;
+	D3WASM_AudioSourceAction( id, 2 );
+}
