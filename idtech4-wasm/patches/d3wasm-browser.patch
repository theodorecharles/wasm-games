diff --git a/neo/sys/openal_emscripten.cpp b/neo/sys/openal_emscripten.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0b8029ef6fa233ca284f17f3e634575ab4914019
--- /dev/null
+++ b/neo/sys/openal_emscripten.cpp
@@ -0,0 +1,441 @@
+/*
+===========================================================================
+
+Browser OpenAL bridge for the Doom 3 WebAssembly client.
+
+The engine runs in a dedicated worker so rendering and synchronous owner-data
+access cannot stall the page.  WebAudio's AudioContext is window-only, which
+means Emscripten's regular OpenAL implementation cannot open a device there.
+This file keeps the small OpenAL state machine Doom 3 needs in the worker and
+forwards buffer/source commands to a WebAudio renderer owned by the page.
+
+===========================================================================
+*/
+
+#include "sys/platform.h"
+#include "sound/snd_local.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+// Emscripten's compact OpenAL headers declare plain C symbols and intentionally
+// omit the desktop OpenAL calling-convention decoration macros.
+#ifndef AL_API
+#define AL_API
+#endif
+#ifndef AL_APIENTRY
+#define AL_APIENTRY
+#endif
+#ifndef ALC_API
+#define ALC_API
+#endif
+#ifndef ALC_APIENTRY
+#define ALC_APIENTRY
+#endif
+
+namespace {
+
+static const int D3WASM_MAX_AL_SOURCES = 512;
+static const int D3WASM_MAX_AL_BUFFERS = 16384;
+static const int D3WASM_MAX_AL_QUEUE = 32;
+
+struct d3wasmALBuffer_t {
+	bool alive;
+	int durationMsec;
+};
+
+struct d3wasmALSource_t {
+	bool alive;
+	bool playing;
+	bool paused;
+	bool looping;
+	ALuint buffer;
+	ALuint queue[D3WASM_MAX_AL_QUEUE];
+	int queueCount;
+	double startedMsec;
+};
+
+static d3wasmALBuffer_t d3wasmBuffers[D3WASM_MAX_AL_BUFFERS] = {};
+static d3wasmALSource_t d3wasmSources[D3WASM_MAX_AL_SOURCES] = {};
+static ALenum d3wasmLastError = AL_NO_ERROR;
+static int d3wasmDeviceToken = 1;
+static int d3wasmContextToken = 1;
+
+EM_JS( void, D3WASM_AudioInit, (), {
+	postMessage( { type: 'audio-init' } );
+} );
+
+EM_JS( void, D3WASM_AudioBufferData, ( int id, int format, const void *data, int size, int frequency ), {
+	const bytes = HEAPU8.slice( data, data + size );
+	postMessage( { type: 'audio-buffer', id, format, frequency, data: bytes.buffer }, [ bytes.buffer ] );
+} );
+
+EM_JS( void, D3WASM_AudioDeleteBuffer, ( int id ), {
+	postMessage( { type: 'audio-delete-buffer', id } );
+} );
+
+EM_JS( void, D3WASM_AudioCreateSource, ( int id ), {
+	postMessage( { type: 'audio-create-source', id } );
+} );
+
+EM_JS( void, D3WASM_AudioDeleteSource, ( int id ), {
+	postMessage( { type: 'audio-delete-source', id } );
+} );
+
+EM_JS( void, D3WASM_AudioSourceInt, ( int id, int param, int value ), {
+	postMessage( { type: 'audio-source-int', id, param, value } );
+} );
+
+EM_JS( void, D3WASM_AudioSourceFloat, ( int id, int param, float value ), {
+	postMessage( { type: 'audio-source-float', id, param, value } );
+} );
+
+EM_JS( void, D3WASM_AudioSourcePosition, ( int id, float x, float y, float z ), {
+	postMessage( { type: 'audio-source-position', id, x, y, z } );
+} );
+
+EM_JS( void, D3WASM_AudioSourceQueue, ( int id, int count, const ALuint *buffers ), {
+	const values = Array.from( HEAPU32.subarray( buffers >> 2, ( buffers >> 2 ) + count ) );
+	postMessage( { type: 'audio-source-queue', id, buffers: values } );
+} );
+
