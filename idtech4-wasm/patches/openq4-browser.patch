diff --git a/tools/cross/emscripten.ini b/tools/cross/emscripten.ini
new file mode 100644
index 00000000..9db5e2c8
--- /dev/null
+++ b/tools/cross/emscripten.ini
@@ -0,0 +1,20 @@
+# openQ4 browser cross file.
+# Activate an Emscripten SDK before configuring, so emcc/em++ and the SDL3
+# port are selected from the caller's PATH.
+
+[binaries]
+c = 'emcc'
+cpp = 'em++'
+ar = 'emar'
+strip = 'emstrip'
+ranlib = 'emranlib'
+pkg-config = '/usr/bin/false'
+
+[host_machine]
+system = 'emscripten'
+cpu_family = 'wasm32'
+cpu = 'wasm32'
+endian = 'little'
+
+[properties]
+needs_exe_wrapper = true
