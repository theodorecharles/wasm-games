+# openQ4 browser cross file.
+# Activate an Emscripten SDK before configuring, so emcc/em++ and the SDL3
+# port are selected from the caller's PATH.
+
+[binaries]
+c = 'emcc'
+cpp = 'em++'
+ar = 'emar'
+strip = 'emstrip'
+ranlib = 'emranlib'
+pkg-config = '/usr/bin/false'
+
+[host_machine]
+system = 'emscripten'
+cpu_family = 'wasm32'
+cpu = 'wasm32'
+endian = 'little'
+
+[properties]
+needs_exe_wrapper = true
