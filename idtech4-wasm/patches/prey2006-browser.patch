+/*
+===============
+idFileSystemLocal::MountDeferredPaks
+
+Adds Prey's large gameplay archives to the live search path on demand.  The
+files are already local WORKERFS blobs; this only parses their zip directories.
+===============
+*/
+bool idFileSystemLocal::MountDeferredPaks( void ) {
+#ifndef PREYWASM_CLIENT
+	return true;
+#else
+	static bool mounted = false;
+	if ( mounted ) {
+		return true;
+	}
+
+	searchpath_t *baseSearch = NULL;
+	for ( searchpath_t *search = searchPaths; search; search = search->next ) {
+		if ( search->dir && !search->dir->path.Icmp( fs_basepath.GetString() ) &&
+			 !search->dir->gamedir.Icmp( BASE_GAMEDIR ) ) {
+			baseSearch = search;
+			break;
+		}
+	}
+	if ( !baseSearch ) {
+		common->Warning( "Unable to find browser base search path for deferred Prey archives" );
+		return false;
+	}
+
+	const char *deferredNames[] = {
+		"pak001.pk4", "pak002.pk4", "pak003.pk4", "pak004.pk4"
+	};
+	common->Printf( "Mounting deferred Prey gameplay archives...\n" );
+	for ( int i = 0; i < 4; ++i ) {
+		idStr fullPath = BuildOSPath( fs_basepath.GetString(), BASE_GAMEDIR, deferredNames[i] );
+		pack_t *pak = LoadZipFile( fullPath );
+		if ( !pak ) {
+			common->Warning( "Unable to mount deferred pk4 %s", fullPath.c_str() );
+			return false;
+		}
+
+		// Packs are searched in descending filename order. Insert this archive
+		// among the already-mounted base packs rather than appending it at lower
+		// priority, so official patches retain their native override semantics.
+		searchpath_t **insertAt = &baseSearch->next;
+		while ( *insertAt && !( *insertAt )->dir ) {
+			idStr existingName = ( *insertAt )->pack->pakFilename;
+			existingName.StripPath();
+			if ( existingName.Icmp( deferredNames[i] ) < 0 ) {
+				break;
+			}
+			insertAt = &( *insertAt )->next;
+		}
+
+		searchpath_t *node = new searchpath_t;
+		node->dir = NULL;
+		node->pack = pak;
+		node->next = *insertAt;
+		*insertAt = node;
+		common->Printf( "Mounted deferred pk4 %s with checksum 0x%x\n", fullPath.c_str(), pak->checksum );
+	}
+
+	mounted = true;
+	common->Printf( "Deferred Prey gameplay archives are ready\n" );
+	return true;
+#endif
+}
