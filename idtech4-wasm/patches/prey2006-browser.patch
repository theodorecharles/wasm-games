+	event.type = SDL_MOUSEMOTION;
+	event.motion.x = relative ? 0 : x;
+	event.motion.y = relative ? 0 : y;
+	event.motion.xrel = relative ? x : 0;
+	event.motion.yrel = relative ? y : 0;
+	SDL_PushEvent( &event );
