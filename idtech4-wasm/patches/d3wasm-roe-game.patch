+/*
+===============
+idClip::RestoreTraceModels
+===============
+*/
+void idClip::RestoreTraceModels( idRestoreGame *savefile ) {
+	// Init created a default model before the saved cache is read. These two
+	// clip-owned models are not restored with the entities: release their old
+	// references before replacing the cache, then reacquire the default by
+	// shape. Saved indices may differ and must remain intact for the entities.
+	FreeTraceModels();
+	idClipModel::RestoreTraceModels( savefile );
+	defaultClipModel.LoadModel( idTraceModel( idBounds( idVec3( 0, 0, 0 ) ).Expand( 8 ) ) );
 }
 
