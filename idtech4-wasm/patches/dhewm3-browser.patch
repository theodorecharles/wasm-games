+#define D3WASM_UNIFORM(field, name) d3wasmInteraction.field = glGetUniformLocation( program, name )
+	D3WASM_UNIFORM( modelViewMatrix, "uModelViewMatrix" ); D3WASM_UNIFORM( projectionMatrix, "uProjectionMatrix" );
+	D3WASM_UNIFORM( localLightOrigin, "uLocalLightOrigin" ); D3WASM_UNIFORM( localViewOrigin, "uLocalViewOrigin" );
+	D3WASM_UNIFORM( lightProjectionS, "uLightProjectionS" ); D3WASM_UNIFORM( lightProjectionT, "uLightProjectionT" );
+	D3WASM_UNIFORM( lightProjectionQ, "uLightProjectionQ" ); D3WASM_UNIFORM( lightFalloffS, "uLightFalloffS" );
+	D3WASM_UNIFORM( bumpMatrixS, "uBumpMatrixS" ); D3WASM_UNIFORM( bumpMatrixT, "uBumpMatrixT" );
+	D3WASM_UNIFORM( diffuseMatrixS, "uDiffuseMatrixS" ); D3WASM_UNIFORM( diffuseMatrixT, "uDiffuseMatrixT" );
+	D3WASM_UNIFORM( specularMatrixS, "uSpecularMatrixS" ); D3WASM_UNIFORM( specularMatrixT, "uSpecularMatrixT" );
+	D3WASM_UNIFORM( colorModulate, "uColorModulate" ); D3WASM_UNIFORM( colorAdd, "uColorAdd" );
+	D3WASM_UNIFORM( diffuseColor, "uDiffuseColor" ); D3WASM_UNIFORM( specularColor, "uSpecularColor" );
+#undef D3WASM_UNIFORM
+	glUseProgram( program );
+	glUniform1i( glGetUniformLocation( program, "uBumpMap" ), 1 );
+	glUniform1i( glGetUniformLocation( program, "uFalloffMap" ), 2 );
+	glUniform1i( glGetUniformLocation( program, "uProjectionMap" ), 3 );
+	glUniform1i( glGetUniformLocation( program, "uDiffuseMap" ), 4 );
+	glUniform1i( glGetUniformLocation( program, "uSpecularMap" ), 5 );
+	glUseProgram( 0 );
+	common->Printf( "WebGL2 GLSL ES interaction program linked successfully\n" );
+	return true;
+}
