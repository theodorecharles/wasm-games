+    document.addEventListener('keyup', event => {
+      if (!started) return;
+      const scan = keyScan(event.code);
+      if (scan) post({ type: 'key', scan, key: event.key.length === 1 ? event.key.charCodeAt(0) : 0, down: false });
+    }, true);
