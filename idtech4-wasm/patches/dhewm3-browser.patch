+      bindPersistenceLifecycle();
+    },
+
+    async start(ctx) {
+      if (started) return;
+      void ctx.shell.resumeAudio();
+      ctx.setLoading('Preparing Doom 3…', '', 5);
+      const data = await ctx.dataClient.load(ownerData, {
+        onProgress(detail) {
+          if (detail.phase === 'checking-cache') ctx.setLoading('Preparing Doom 3…');
