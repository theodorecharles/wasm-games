+	GLint bumpMatrixT;
+	GLint diffuseMatrixS;
+	GLint diffuseMatrixT;
+	GLint specularMatrixS;
+	GLint specularMatrixT;
+	GLint colorModulate;
+	GLint colorAdd;
+	GLint diffuseColor;
+	GLint specularColor;
+} d3wasmWebGL2Interaction_t;
+
+static d3wasmWebGL2Interaction_t d3wasmInteraction = {};
+
+static const char *d3wasmInteractionVertexShader =
+	"#version 300 es\n"
+	"precision highp float;\n"
+	"layout(location=0) in vec3 a_position;\n"
+	"layout(location=2) in vec4 a_color;\n"
+	"layout(location=8) in vec2 attr_TexCoord;\n"
+	"layout(location=9) in vec3 attr_Tangent;\n"
+	"layout(location=10) in vec3 attr_Bitangent;\n"
+	"layout(location=11) in vec3 attr_Normal;\n"
+	"uniform mat4 uModelViewMatrix; uniform mat4 uProjectionMatrix;\n"
+	"uniform vec4 uLocalLightOrigin; uniform vec4 uLocalViewOrigin;\n"
+	"uniform vec4 uLightProjectionS; uniform vec4 uLightProjectionT;\n"
+	"uniform vec4 uLightProjectionQ; uniform vec4 uLightFalloffS;\n"
+	"uniform vec4 uBumpMatrixS; uniform vec4 uBumpMatrixT;\n"
+	"uniform vec4 uDiffuseMatrixS; uniform vec4 uDiffuseMatrixT;\n"
+	"uniform vec4 uSpecularMatrixS; uniform vec4 uSpecularMatrixT;\n"
+	"uniform vec4 uColorModulate; uniform vec4 uColorAdd;\n"
+	"out vec2 vBump; out vec2 vDiffuse; out vec2 vSpecular;\n"
+	"out vec3 vProjection; out vec2 vFalloff; out vec3 vLight; out vec3 vHalf; out vec4 vColor;\n"
+	"vec3 tangentVector(vec3 v) { return vec3(dot(attr_Tangent,v),dot(attr_Bitangent,v),dot(attr_Normal,v)); }\n"
+	"void main(){ vec4 p=vec4(a_position,1.0); vec4 st=vec4(attr_TexCoord,0.0,1.0);\n"
+	" vec3 l=uLocalLightOrigin.xyz-p.xyz; vec3 v=uLocalViewOrigin.xyz-p.xyz;\n"
+	" vLight=tangentVector(l); vHalf=tangentVector(normalize(l)+normalize(v));\n"
+	" vBump=vec2(dot(st,uBumpMatrixS),dot(st,uBumpMatrixT));\n"
+	" vDiffuse=vec2(dot(st,uDiffuseMatrixS),dot(st,uDiffuseMatrixT));\n"
+	" vSpecular=vec2(dot(st,uSpecularMatrixS),dot(st,uSpecularMatrixT));\n"
+	" vProjection=vec3(dot(p,uLightProjectionS),dot(p,uLightProjectionT),dot(p,uLightProjectionQ));\n"
+	" vFalloff=vec2(dot(p,uLightFalloffS),0.5); vColor=a_color*uColorModulate+uColorAdd;\n"
