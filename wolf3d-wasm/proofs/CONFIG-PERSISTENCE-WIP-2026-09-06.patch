+#ifdef WOLF4SDL_WEB
+static boolean WolfWebHasKeyBinding(int key)
+{
+    for (int i = 0; i < 4; ++i)
+        if (dirscan[i] == key) return true;
+    for (int i = 0; i < NUMBUTTONS; ++i)
+        if (buttonscan[i] == key) return true;
+    return false;
+}
+#endif
+
 void PollKeyboardMove (void)
 {
     int delta = buttonstate[bt_run] ? RUNMOVE * tics : BASEMOVE * tics;
 
 #ifdef WOLF4SDL_WEB
-    // Modern browser movement while preserving the original arrow keys for
-    // turning. Do not also bind WASD through dirscan: that made W/S apply
-    // movement twice and A/D both strafe and turn.
-    if (IN_GameplayKeyDown(sc_W))
+    // WASD is a fallback, not a second action layered over a custom binding.
+    // Explicit movement/action bindings take precedence and are sampled once.
+    if (!WolfWebHasKeyBinding(sc_W) && IN_GameplayKeyDown(sc_W))
         controly -= delta;
-    if (IN_GameplayKeyDown(sc_S))
+    if (!WolfWebHasKeyBinding(sc_S) && IN_GameplayKeyDown(sc_S))
         controly += delta;
-    if (IN_GameplayKeyDown(sc_A))
+    if (!WolfWebHasKeyBinding(sc_A) && IN_GameplayKeyDown(sc_A))
         buttonstate[bt_strafeleft] = true;
-    if (IN_GameplayKeyDown(sc_D))
+    if (!WolfWebHasKeyBinding(sc_D) && IN_GameplayKeyDown(sc_D))
         buttonstate[bt_straferight] = true;
 #endif
 
