+#ifdef WOLF4SDL_WEB
+static const uint32_t WolfWebConfigVersion = 0x57424331u;
+
+static void WolfWebRestoreDirections(uint32_t configVersion)
+{
+    // Migrate only the exact layout once seeded by the browser port. New
+    // configs carry a trailing marker so intentionally customized WASD stays.
+    if (configVersion != WolfWebConfigVersion &&
+        dirscan[di_north] == sc_W && dirscan[di_east] == sc_D &&
+        dirscan[di_south] == sc_S && dirscan[di_west] == sc_A)
+    {
+        dirscan[di_north] = sc_UpArrow;
+        dirscan[di_east] = sc_RightArrow;
+        dirscan[di_south] = sc_DownArrow;
+        dirscan[di_west] = sc_LeftArrow;
+    }
+}
+#endif
