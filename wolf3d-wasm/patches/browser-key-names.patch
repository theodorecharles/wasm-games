diff --git a/id_in.cpp b/id_in.cpp
--- a/id_in.cpp
+++ b/id_in.cpp
@@ -118,6 +118,19 @@
 
 extern "C" EMSCRIPTEN_KEEPALIVE void WolfWasm_BrowserControllerKey(int keycode, int pressed)
 {
+    // The adapter's stable controller seam uses legacy SDL 1 codes. Translate
+    // special keys to the values in the active SDK; ASCII is already portable.
+    switch (keycode)
+    {
+        case 273: keycode = sc_UpArrow; break;
+        case 274: keycode = sc_DownArrow; break;
+        case 275: keycode = sc_RightArrow; break;
+        case 276: keycode = sc_LeftArrow; break;
+        case 304: keycode = sc_LShift; break;
+        case 306: keycode = sc_Control; break;
+        case 308: keycode = sc_Alt; break;
+        default: break;
+    }
     if (keycode <= sc_None || keycode >= SDLK_LAST)
         return;
     Keyboard[keycode] = pressed != 0;
