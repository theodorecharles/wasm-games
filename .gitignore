# ---------------------------------------------------------------------------
# wasm-games is SOURCE ONLY: code, patches, manifests, Dockerfiles, templates.
# Compiled binaries, game data, and build artifacts are never committed.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
/wasm-game-framework/
/wasm-game-lab/
/jill-wasm/
**/.work/

# Build output / artifacts
build/
dist/
artifacts/
*.tsbuildinfo

# Compiled binaries (regenerated by engine build scripts)
*.wasm
*.so
*.a
*.o

# Generated site bundles
public/
/goldsource-wasm/web/assets/

# Game data — copyrighted, provisioned at runtime via volume mount.
# Never commit these.
*.pk3
*.pak
*.wad
*-owner.pk3
owner-data/
data/

# Runtime test evidence (screenshots, console captures, browser profiles)
browser-profile*/
*-profile-*/
test-results/

# Logs
logs/
*.log

# Editor / OS
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?
*.suo
*.jar
*.map
*.MAP
