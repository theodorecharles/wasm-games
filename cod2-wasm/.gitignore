output/*
!output/data_home_map.json
*.o
*.a
*.so
*.exe
*.pyc
__pycache__/
.DS_Store
toolchain/

# CMake out-of-source build dirs (one per target; see README.md)
/build-native/
/build-win32/
/build/msvc-x64
build/cmake/
build/msvc/
build/msvc-release/

# gfx_d3d renderer DLL build outputs (regenerated by scripts/build_gfx_dll.sh)
build/win32c/gfxdll/
build/win32c/*.dll
build/win32/*.dll
build/win32c/*.bak

# native build outputs (regenerable; never commit)
/cod2_linux
/cod2_linux.clean
/cod2_lnxded
/cod2.exe
/cod2_lnxded.exe
# compiled equiv-harness runner (built from native_equiv_runner.c)
utils/decomp/native_equiv_runner

# transient runtime / snapshot artifacts
servercache.dat
*.tar.gz

# downstream Emscripten build output (generated by scripts/build-web.sh)
/out/
/artifacts/runtime/
*.iwd
*.wasm
*.data

# generated native data blobs (regenerated by CMake into the source/build dirs)
build/win32c/
src/win32/sdl2/lib/*.a
# user-supplied SDL2 (MinGW .a above; MSVC .lib/.dll here) -- never committed
src/win32/sdl2/lib/*.lib
src/win32/sdl2/lib/*.dll
src/win32/sdl2/lib/*.pdb
# ...and the same dropped into third_party/
/third_party/SDL2-*/
/third_party/SDL2-*.zip
