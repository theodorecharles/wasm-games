-    var runtimeReady = false;
-    var busy = false;
-    var started = false;
-
-    // Mount roots differ by FS backend:
-    //   WORKERFS (zero-copy): picked folder's File objects mounted read-only at
-    //           /cod2/main; writable /cod2home backed by OPFS. No asset copy.
-    //   WASMFS: OPFS root mounted at /opfs; assets under /opfs/cod2, saves /opfs/home.
-    //   MEMFS:  assets streamed into /cod2; saves under /cod2home (IDBFS-persisted).
-    var FS_BASEPATH = '/cod2';
-    var FS_HOMEPATH = '/cod2home';
-    var idbfsHome = false;            // MEMFS only: /cod2home backed by IDBFS
-    var GAME_ARGS = [];               // built once the FS backend is known
-
-    function buildArgs() {
-      GAME_ARGS = ['+set', 'fs_basepath', FS_BASEPATH,
-                   '+set', 'fs_homepath', FS_HOMEPATH,
-                   '+set', 'fs_game', '',
-                   '+set', 'r_fullscreen', '0'];
-      if (window.Module) Module.arguments = GAME_ARGS;
-    }
-
-    function setMsg(t, isErr) {
-      msgEl.textContent = t || '';
-      msgEl.className = isErr ? 'error' : '';
-    }
-    function showBar(show) { barEl.style.display = show ? 'block' : 'none'; }
-    function setProgress(done, total, name) {
-      if (total > 0) barFill.style.width = Math.min(100, (done / total) * 100) + '%';
-      fileLine.textContent = name || '';
-    }
-    function fmtMB(n) { return (n / (1024 * 1024)).toFixed(1) + ' MB'; }
-
-    function setBusy(b) {
-      busy = b;
-      pickBtn.disabled = b || !runtimeReady;
-      resumeBtn.disabled = b || !runtimeReady;
-      changeBtn.disabled = b || !runtimeReady;
-      clearBtn.disabled = b || !runtimeReady;
-    }
-
-    // ---- emscripten FS helpers (legacy MEMFS path) ----------------------
-    function mkdirTree(path) {
-      var parts = path.split('/').filter(Boolean);
-      var cur = '';
-      for (var i = 0; i < parts.length; i++) {
-        cur += '/' + parts[i];
-        try { FS.mkdir(cur); }
-        catch (e) { if (!FS.analyzePath(cur).exists) throw e; }
-      }
-    }
-
-    function isWasmfsBuild() {
-      // The WASMFS build links src/web/cod2_wasmfs_mount.c, which exports
-      // _cod2_mount_opfs. Its presence selects the on-demand OPFS mount.
-      return typeof Module._cod2_mount_opfs === 'function';
-    }
-
-    function isWorkerfsBuild() {
-      // The WORKERFS zero-copy build links -lworkerfs.js (WORKERFS global) and
-      // runs main() on a worker (PROXY_TO_PTHREAD). WORKERFS provides the
-      // synchronous on-demand reads of the picked folder's File objects.
-      return typeof WORKERFS !== 'undefined';
-    }
-
-    // Pick mount roots + (MEMFS) persistent home, then build the launch args.
-    // Must run once the runtime is up (Module._cod2_mount_opfs is then known).
-    function configureFsBackend() {
-      if (isWorkerfsBuild()) {
-        // Zero-copy: read the iwds in place from disk. fs_homepath is a small
-        // OPFS-backed writable tree; assets are NOT copied anywhere.
-        FS_BASEPATH = '/cod2';
-        FS_HOMEPATH = '/cod2home';
-        idbfsHome = false;
-      } else if (isWasmfsBuild()) {
-        FS_BASEPATH = '/opfs/cod2';
-        FS_HOMEPATH = '/opfs/home';
-        idbfsHome = false;
-      } else {
-        FS_BASEPATH = '/cod2';
-        FS_HOMEPATH = '/cod2home';
-        // Persist savegames/config across reloads via IDBFS (MEMFS has no disk).
-        idbfsHome = (typeof IDBFS !== 'undefined');
-      }
-      buildArgs();
-    }
-
-    var homeSyncTimer = 0;
-    function setupIdbfsHome() {
-      if (!idbfsHome) return Promise.resolve();
-      mkdirTree(FS_HOMEPATH);
-      try { FS.mount(IDBFS, {}, FS_HOMEPATH); } catch (e) { if (e && e.errno !== undefined) {/* already */} }
-      return new Promise(function (resolve) {
-        FS.syncfs(true, function () {            // populate from IndexedDB
-          if (!homeSyncTimer) {
-            homeSyncTimer = setInterval(function () {
-              FS.syncfs(false, function () {});
-            }, 15000);
-          }
-          resolve();
-        });
-      });
-    }
-
-    // ---- Zero-copy WORKERFS mount (the preferred no-copy path) ----------
-    // Mount the picked folder's File objects read-only via WORKERFS so the
-    // engine reads iwd bytes on demand straight off disk -- NO copy to OPFS,
-    // NO full-RAM load. /cod2home is an OPFS-backed writable tree (savegames,
-    // config, players/) -- the only thing that is persisted.
-    async function setupWorkerfsHome() {
-      // WORKERFS is read-only, so /cod2home cannot be WORKERFS. Use the regular
-      // (MEMFS) writable FS for the home tree and seed/persist it via OPFS.
-      mkdirTree(FS_HOMEPATH);
-      if (!Cod2Fs.hasOpfs()) return;        // RAM-only home (not persisted)
-      try {
-        // Mirror the small OPFS "home/" tree into MEMFS on boot, then flush it
-        // back on an interval and at exit. (Home is tiny -- config + saves.)
-        await mirrorOpfsHomeIn();
-        if (!homeSyncTimer) {
-          homeSyncTimer = setInterval(function () { mirrorOpfsHomeOut(); }, 15000);
-        }
-        window.addEventListener('pagehide', function () { mirrorOpfsHomeOut(); });
-      } catch (e) { /* best-effort persistence */ }
-    }
-
-    async function mirrorOpfsHomeIn() {
-      var dir = await Cod2Fs.opfsHomeDir(true);
-      async function walk(handle, prefix) {
-        for await (var entry of handle.values()) {
-          var rel = prefix ? prefix + '/' + entry.name : entry.name;
-          if (entry.kind === 'directory') { mkdirTree(FS_HOMEPATH + '/' + rel); await walk(entry, rel); }
-          else {
-            var f = await entry.getFile();
-            FS.writeFile(FS_HOMEPATH + '/' + rel, new Uint8Array(await f.arrayBuffer()));
-          }
-        }
-      }
-      await walk(dir, '');
-    }
-
-    async function mirrorOpfsHomeOut() {
-      if (!Cod2Fs.hasOpfs()) return;
-      var dir = await Cod2Fs.opfsHomeDir(true);
-      function listFs(path, prefix, out) {
-        var ents;
-        try { ents = FS.readdir(path); } catch (e) { return; }
-        for (var i = 0; i < ents.length; i++) {
-          var n = ents[i]; if (n === '.' || n === '..') continue;
-          var p = path + '/' + n, rel = prefix ? prefix + '/' + n : n;
-          var st = FS.stat(p);
-          if (FS.isDir(st.mode)) listFs(p, rel, out);
-          else out.push({ rel: rel, data: FS.readFile(p) });
-        }
-      }
-      var files = [];
-      listFs(FS_HOMEPATH, '', files);
-      for (var i = 0; i < files.length; i++) {
-        var rel = files[i].rel, slash = rel.lastIndexOf('/');
-        var d = dir;
-        if (slash >= 0) {
-          var parts = rel.slice(0, slash).split('/');
-          for (var j = 0; j < parts.length; j++) d = await d.getDirectoryHandle(parts[j], { create: true });
-        }
-        var fh = await d.getFileHandle(rel.slice(slash + 1), { create: true });
-        var w = await fh.createWritable();
-        await w.write(files[i].data); await w.close();
-      }
-    }
-
-    // Mount the picked folder's live File objects (no copy) at /cod2.
-    async function mountDirect(install) {
-      mkdirTree(FS_BASEPATH);
-      // WORKERFS keys each node by its `name` (full '/'-separated rel path).
-      // install.files[i].path is "main/iw_00.iwd" etc.
-      var wf = install.files.map(function (rec) {
-        return { name: rec.path, data: rec.file };
-      });
-      setMsg('Mounting ' + wf.length + ' files (read-only, no copy)…');
-      FS.mount(WORKERFS, { files: wf }, FS_BASEPATH);
-      await setupWorkerfsHome();
-    }
-
-    // Mount the cached assets so FS_Startup sees <fs_basepath>/main/*.iwd.
-    // WASMFS  -> mount OPFS at /opfs (engine reads iwd bytes on demand).
-    // MEMFS   -> stream each cached file from OPFS into MEMFS once.
-    async function mountAssets(meta) {
-      if (isWasmfsBuild()) {
-        setMsg('Mounting OPFS at /opfs…');
-        var rc = Module.ccall('cod2_mount_opfs', 'number', [], []);
-        if (rc !== 0) throw new Error('OPFS mount failed (rc=' + rc + ')');
-        return;
-      }
-      // Legacy MEMFS: stream cached files from OPFS into the in-memory FS.
-      await setupIdbfsHome();
-      mkdirTree(FS_BASEPATH);
-      mkdirTree(FS_HOMEPATH);
-      var files = meta.files;
-      var total = 0, done = 0, i;
-      for (i = 0; i < files.length; i++) total += files[i].size;
-      showBar(true);
-      for (i = 0; i < files.length; i++) {
-        var rec = files[i];
-        var dst = FS_BASEPATH + '/' + rec.path;
-        var slash = dst.lastIndexOf('/');
-        if (slash >= 0) mkdirTree(dst.slice(0, slash));
-        var f = await Cod2Fs.readCached(rec.path);
-        var buf = new Uint8Array(await f.arrayBuffer());
-        FS.writeFile(dst, buf);
-        done += rec.size;
-        setMsg('Mounting ' + (i + 1) + '/' + files.length + ' (' + fmtMB(done) + ')');
-        setProgress(done, total, rec.path);
-        if ((i & 7) === 0) await new Promise(function (r) { setTimeout(r, 0); });
-      }
-      showBar(false);
-    }
-
-    // ---- Flow -----------------------------------------------------------
-    function onProgress(p) {
-      if (p.phase === 'scan')  { setMsg('Scanning install…'); showBar(false); return; }
-      if (p.phase === 'done')  { showBar(false); return; }
-      if (p.phase === 'copy' || p.phase === 'skip' || p.phase === 'progress') {
-        showBar(true);
-        setMsg((p.phase === 'skip' ? 'Cached ' : 'Copying ') +
-               p.fileIndex + '/' + p.fileCount + '  (' +
-               fmtMB(p.bytesDone) + ' / ' + fmtMB(p.bytesTotal) + ')');
-        setProgress(p.bytesDone, p.bytesTotal, p.fileName);
-      }
-    }
-
-    async function ingestAndBoot(handle) {
-      setBusy(true);
-      try {
-        if (isWorkerfsBuild()) {
-          // Zero-copy: enumerate the picked folder's File objects and mount
-          // them directly. The handle is remembered (inside enumerateInstall)
-          // so reloads re-mount with no re-pick and no copy.
-          setMsg('Reading your install…'); showBar(false);
-          var install = await Cod2Fs.enumerateInstall(handle);
-          await mountDirect(install);
-          setMsg('Starting…');
-          startGame();
-          return;
-        }
-        var meta = await Cod2Fs.ingestHandle(handle, onProgress);
-        await bootFromCache(meta);
-      } catch (err) {
-        setBusy(false);
-        setMsg((err && err.message) ? err.message : String(err), true);
-      }
-    }
-
-    async function bootFromCache(meta) {
-      if (!meta) meta = await Cod2Fs.getCacheMeta();
-      if (!meta) { setMsg('No cached assets. Select your CoD2 folder.', true); setBusy(false); return; }
-      await mountAssets(meta);
-      setMsg('Starting…');
-      startGame();
-    }
-
-    function startGame() {
-      if (started) return;
-      started = true;
-      overlay.style.display = 'none';
-      canvas.style.display = 'block';
-      canvas.focus();
-      try { Module.callMain(GAME_ARGS); }
-      catch (e) { console.error(e); }
-    }
-
-    // ---- Buttons --------------------------------------------------------
-    pickBtn.addEventListener('click', function () {
-      if (busy || !runtimeReady) return;
-      (async function () {
-        if (!Cod2Fs.hasFsAccess()) { pickFallback.style.display = 'block'; folderIn.click(); return; }
-        var handle;
-        try { handle = await Cod2Fs.pickDirectory(); }
-        catch (e) { if (e && e.name === 'AbortError') return; throw e; }
-        await ingestAndBoot(handle);
-      })().catch(function (err) { setMsg((err && err.message) || String(err), true); });
-    });
-
-    resumeBtn.addEventListener('click', function () {
-      if (busy || !runtimeReady) return;
-      (async function () {
-        var handle = await Cod2Fs.getSavedHandle();
-        if (!handle) return;
-        var perm = await Cod2Fs.requestHandlePermission(handle);
-        if (perm !== 'granted') {
-          // WORKERFS zero-copy has no asset cache: the folder is required.
-          if (!isWorkerfsBuild()) {
-            var meta = await Cod2Fs.getCacheMeta();
-            if (meta) { setBusy(true); await bootFromCache(meta); return; }
-          }
-          setMsg('Permission denied. Re-authorize your CoD2 folder to play.', true);
-          return;
-        }
-        await ingestAndBoot(handle);
-      })().catch(function (err) { setMsg((err && err.message) || String(err), true); });
-    });
-
-    changeBtn.addEventListener('click', function () {
-      if (busy || !runtimeReady) return;
-      (async function () {
-        if (!Cod2Fs.hasFsAccess()) { pickFallback.style.display = 'block'; folderIn.click(); return; }
-        var handle = await Cod2Fs.pickDirectory();
-        await ingestAndBoot(handle);
-      })().catch(function (err) { if (err && err.name === 'AbortError') return; setMsg((err && err.message) || String(err), true); });
-    });
-
-    clearBtn.addEventListener('click', function () {
-      if (busy || !runtimeReady) return;
-      (async function () {
-        await Cod2Fs.clearCache();
-        await Cod2Fs.forgetHandle();
-        setMsg('Cache cleared. Select your CoD2 folder.');
-        resumeBtn.style.display = 'none';
-        changeBtn.style.display = 'none';
-        clearBtn.style.display = 'none';
-      })().catch(function (err) { setMsg((err && err.message) || String(err), true); });
-    });
-
-    // Fallback <input webkitdirectory> path (non-Chromium): copies the picked
-    // files into OPFS via a synthetic handle-like adapter is overkill; for the
-    // fallback we just stream the selected files straight into MEMFS and boot.
-    folderIn.addEventListener('change', function () {
-      var files = Array.prototype.slice.call(folderIn.files || []);
-      if (!files.length) return;
-      (async function () {
-        setBusy(true);
-        mkdirTree(FS_BASEPATH); mkdirTree(FS_HOMEPATH);
-        // Keep only the wanted assets, mapped under main/ (strip the chosen
-        // root folder name, like the File System Access path does).
-        var wanted = files.filter(function (f) {
-          var rel = (f.webkitRelativePath || f.name).toLowerCase();
-          return /\.(iwd|cfg|dat|txt|menu|str|gsc|csc|arena|bik|roq)$/.test(rel);
-        });
-        if (!wanted.length) { setMsg('No game assets found in that folder.', true); setBusy(false); return; }
-        var total = 0, done = 0;
-        wanted.forEach(function (f) { total += f.size; });
-        showBar(true);
-        for (var i = 0; i < wanted.length; i++) {
-          var f = wanted[i];
-          var parts = (f.webkitRelativePath || f.name).split('/');
-          if (parts.length > 1) parts.shift();           // strip chosen-root
-          var rel = parts.join('/');
-          if (rel.toLowerCase().indexOf('main/') !== 0 && /\.iwd$/i.test(rel)) rel = 'main/' + rel;
-          var dst = FS_BASEPATH + '/' + rel;
-          var s = dst.lastIndexOf('/'); if (s >= 0) mkdirTree(dst.slice(0, s));
-          FS.writeFile(dst, new Uint8Array(await f.arrayBuffer()));
-          done += f.size;
-          setMsg('Loading ' + (i + 1) + '/' + wanted.length + ' (' + fmtMB(done) + ')');
-          setProgress(done, total, rel);
-          if ((i & 7) === 0) await new Promise(function (r) { setTimeout(r, 0); });
-        }
-        showBar(false);
-        setMsg('Starting…');
-        startGame();
-      })().catch(function (err) { setBusy(false); setMsg((err && err.message) || String(err), true); });
-    });
-
-    // ---- On runtime ready: try to resume silently -----------------------
-    async function afterRuntime() {
-      runtimeReady = true;
-      configureFsBackend();
-      setBusy(false);
-      pickBtn.disabled = false;
-
-      var fsa = Cod2Fs.hasFsAccess();
-      var opfs = Cod2Fs.hasOpfs();
-      var workerfs = isWorkerfsBuild();
-      if (!fsa) {
-        setMsg('Folder memory needs a Chromium browser. You can still load a ' +
-               'folder each session below.', true);
-      }
-      // The WORKERFS zero-copy build persists only the directory handle (in
-      // IndexedDB), not an OPFS asset cache -- so it resumes from the handle
-      // alone and never offers "play from cache".
-      var meta = workerfs ? null : (opfs ? await Cod2Fs.getCacheMeta() : null);
-      if (!workerfs && !opfs) { return; }   // no persistence available
-      var handle = fsa ? await Cod2Fs.getSavedHandle() : null;
-
-      if (handle) {
-        var perm = await Cod2Fs.queryHandlePermission(handle);
-        if (perm === 'granted') {
-          // Silent resume from disk (re-validates freshness, cheap if unchanged).
-          changeBtn.style.display = 'inline-block';
-          clearBtn.style.display = 'inline-block';
-          setBusy(true);
-          await ingestAndBoot(handle);
-          return;
-        }
-        if (perm === 'prompt') {
-          resumeBtn.textContent = 'Resume from "' + (handle.name || 'folder') + '"';
-          resumeBtn.style.display = 'inline-block';
-          changeBtn.style.display = 'inline-block';
-          clearBtn.style.display = 'inline-block';
-          setMsg('Welcome back. Resume to re-authorize your folder' +
-                 (meta ? ', or it will boot from the on-device cache.' : '.'));
-          return;
-        }
-      }
-
-      if (meta) {
-        // Disk handle gone but OPFS cache present -> offer straight boot.
-        resumeBtn.textContent = 'Play from cached assets';
-        resumeBtn.style.display = 'inline-block';
-        if (fsa) changeBtn.style.display = 'inline-block';
-        clearBtn.style.display = 'inline-block';
-        setMsg('Cached install found (' + meta.files.length + ' files). ' +
-               'Play from cache, or pick a folder to refresh.');
-        // Rewire resume to boot from cache directly.
-        resumeBtn.onclick = function () {
-          if (busy) return;
-          setBusy(true);
-          bootFromCache(meta).catch(function (err) {
-            setBusy(false); setMsg((err && err.message) || String(err), true);
-          });
-        };
-        return;
-      }
-
-      setMsg('Select your Call of Duty 2 folder to begin.');
-    }
-
-    // ---- emscripten Module ---------------------------------------------
-    window.Module = {
-      noInitialRun: true,
-      canvas: canvas,
-      arguments: GAME_ARGS,
-      print: function (t) { console.log(t); },
-      printErr: function (t) { console.error(t); },
-      onRuntimeInitialized: function () {
-        afterRuntime().catch(function (err) {
-          console.warn(err); setMsg((err && err.message) || String(err), true);
-          runtimeReady = true; pickBtn.disabled = false;
-        });
-      }
-    };
-  })();
-  </script>
