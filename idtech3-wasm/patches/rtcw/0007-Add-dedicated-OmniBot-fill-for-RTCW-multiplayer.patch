diff --git a/MP/code/game/g_omnibot.c b/MP/code/game/g_omnibot.c
new file mode 100644
index 0000000..5da677e
--- /dev/null
+++ b/MP/code/game/g_omnibot.c
@@ -0,0 +1,145 @@
+/*
+===========================================================================
+Dedicated OmniBot fill for the RTCW WASM arena.
+Server-side only: stock WolfMP protocol, no client fs_game, no botlib addbot.
+===========================================================================
+*/
+
+#include "g_local.h"
+
+static vmCvar_t g_omnibotEnable;
+static vmCvar_t g_omnibotPath;
+
+static int OmniBotClass( const char *name ) {
+	if ( !Q_stricmp( name, "medic" ) ) {
+		return PC_MEDIC;
+	}
+	if ( !Q_stricmp( name, "engineer" ) ) {
+		return PC_ENGINEER;
+	}
+	if ( !Q_stricmp( name, "lieutenant" ) || !Q_stricmp( name, "lt" ) || !Q_stricmp( name, "fieldops" ) ) {
+		return PC_LT;
+	}
+	return PC_SOLDIER;
+}
+
+static const char *OmniBotTeamArg( const char *name ) {
+	if ( !Q_stricmp( name, "allies" ) || !Q_stricmp( name, "blue" ) || !Q_stricmp( name, "b" ) ) {
+		return "blue";
+	}
+	return "red";
+}
+
+void G_OmniBot_Init( void ) {
+	trap_Cvar_Register( &g_omnibotEnable, "omnibot_enable", "1", CVAR_ARCHIVE | CVAR_LATCH );
+	trap_Cvar_Register( &g_omnibotPath, "omnibot_path", "/opt/omni-bot", CVAR_ARCHIVE );
+	if ( g_omnibotEnable.integer ) {
+		G_Printf( "OmniBot dedicated fill enabled path=%s\n", g_omnibotPath.string );
+	}
+}
+
+qboolean G_OmniBot_Active( void ) {
+	return g_omnibotEnable.integer ? qtrue : qfalse;
+}
+
+static void G_OmniBot_Add( const char *teamName, const char *className ) {
+	int clientNum;
+	int playerClass;
+	char userinfo[MAX_INFO_STRING];
+	char botName[MAX_NETNAME];
+	gentity_t *ent;
+	const char *teamArg;
+
+	if ( !G_OmniBot_Active() ) {
+		G_Printf( "OmniBot is disabled\n" );
+		return;
+	}
+
+	teamArg = OmniBotTeamArg( teamName );
+	playerClass = OmniBotClass( className );
+	Com_sprintf( botName, sizeof( botName ), "^o[BOT]^7%s%s",
+				 !Q_stricmp( teamArg, "blue" ) ? "Allies" : "Axis",
+				 playerClass == PC_MEDIC ? "Medic" :
+				 playerClass == PC_ENGINEER ? "Engineer" :
+				 playerClass == PC_LT ? "Lieutenant" : "Soldier" );
+
+	clientNum = trap_BotAllocateClient();
+	if ( clientNum == -1 ) {
+		G_Printf( "OmniBot: no free client slots\n" );
+		return;
+	}
+
+	userinfo[0] = '\0';
+	Info_SetValueForKey( userinfo, "name", botName );
+	Info_SetValueForKey( userinfo, "rate", "25000" );
+	Info_SetValueForKey( userinfo, "snaps", "20" );
+	Info_SetValueForKey( userinfo, "model", "multi" );
+	Info_SetValueForKey( userinfo, "skill", "3" );
+	Info_SetValueForKey( userinfo, "team", teamArg );
+	trap_SetUserinfo( clientNum, userinfo );
+
+	if ( ClientConnect( clientNum, qtrue, qtrue ) ) {
+		trap_DropClient( clientNum, "OmniBot connect rejected" );
+		return;
+	}
+
+	ent = &g_entities[clientNum];
+	if ( !ent->client ) {
+		return;
+	}
+	ent->r.svFlags |= SVF_BOT;
+	ent->client->sess.latchPlayerType = playerClass;
+	ent->client->sess.playerType = playerClass;
+	SetTeam( ent, teamArg );
+	ClientBegin( clientNum );
+	G_Printf( "OmniBot added %s %s as %s\n", teamArg, className, botName );
+}
+
+static void G_OmniBot_Kick( const char *name ) {
+	int i;
+	char compare[MAX_NETNAME];
+
+	if ( !name || !name[0] ) {
+		return;
+	}
+	for ( i = 0; i < level.maxclients; i++ ) {
+		if ( !g_entities[i].inuse || !g_entities[i].client ) {
+			continue;
+		}
+		if ( !( g_entities[i].r.svFlags & SVF_BOT ) ) {
+			continue;
+		}
+		Q_strncpyz( compare, g_entities[i].client->pers.netname, sizeof( compare ) );
+		if ( Q_stricmp( compare, name ) && !strstr( compare, name ) ) {
+			continue;
+		}
+		trap_DropClient( i, "OmniBot kicked" );
+		G_Printf( "OmniBot kicked %s\n", compare );
+		return;
+	}
+}
+
+qboolean G_OmniBot_ConsoleCommand( void ) {
+	char cmd[MAX_TOKEN_CHARS];
+	char arg1[MAX_TOKEN_CHARS];
+	char arg2[MAX_TOKEN_CHARS];
+
+	trap_Argv( 0, cmd, sizeof( cmd ) );
+	if ( Q_stricmp( cmd, "bot" ) ) {
+		return qfalse;
+	}
+	trap_Argv( 1, arg1, sizeof( arg1 ) );
+	trap_Argv( 2, arg2, sizeof( arg2 ) );
+	if ( !Q_stricmp( arg1, "addbot" ) ) {
+		char arg3[MAX_TOKEN_CHARS];
+		trap_Argv( 3, arg3, sizeof( arg3 ) );
+		G_OmniBot_Add( arg2, arg3[0] ? arg3 : "soldier" );
+		return qtrue;
+	}
+	if ( !Q_stricmp( arg1, "kickbot" ) ) {
+		G_OmniBot_Kick( arg2 );
+		return qtrue;
+	}
+	G_Printf( "OmniBot usage: bot addbot <axis|allies> <soldier|medic|engineer|lieutenant>\n" );
+	return qtrue;
+}
