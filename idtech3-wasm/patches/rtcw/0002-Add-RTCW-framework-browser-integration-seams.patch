+EMSCRIPTEN_KEEPALIVE int RTCW_BrowserControlsMask( void )
+{
+	int mask = 0;
+	if ( Key_GetBinding( 'w' ) && !Q_stricmp( Key_GetBinding( 'w' ), "+forward" ) ) mask |= 1;
+	if ( Key_GetBinding( 's' ) && !Q_stricmp( Key_GetBinding( 's' ), "+back" ) ) mask |= 2;
+	if ( Key_GetBinding( 'a' ) && !Q_stricmp( Key_GetBinding( 'a' ), "+moveleft" ) ) mask |= 4;
+	if ( Key_GetBinding( 'd' ) && !Q_stricmp( Key_GetBinding( 'd' ), "+moveright" ) ) mask |= 8;
+	if ( Key_GetBinding( K_MOUSE1 ) && !Q_stricmp( Key_GetBinding( K_MOUSE1 ), "+attack" ) ) mask |= 16;
+	if ( Key_GetBinding( K_SPACE ) && !Q_stricmp( Key_GetBinding( K_SPACE ), "+moveup" ) ) mask |= 32;
+	if ( Cvar_VariableIntegerValue( "cl_freelook" ) == 1 ) mask |= 64;
+	if ( Cvar_VariableIntegerValue( "m_filter" ) == 0 ) mask |= 128;
+	return mask;
+}
