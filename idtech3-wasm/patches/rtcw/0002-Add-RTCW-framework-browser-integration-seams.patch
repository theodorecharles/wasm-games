+EMSCRIPTEN_KEEPALIVE void RTCW_BrowserControllerKey( int browserKey, int down )
+{
+	int key;
+
+	if ( !rtcwBrowserStarted ) {
+		return;
+	}
+
+	key = RTCW_BrowserTranslateControllerKey( browserKey );
+	if ( !key || key >= RTCW_BROWSER_CONTROLLER_KEYS ||
+		rtcwBrowserControllerKeys[ key ] == ( down ? 1 : 0 ) ) {
+		return;
+	}
+
+	if ( down && key == K_ENTER && RTCW_BrowserRuntimeState() == 0 ) {
+		rtcwBrowserCaptureIntent = qtrue;
+	}
+	rtcwBrowserControllerKeys[ key ] = down ? 1 : 0;
+	CL_KeyEvent( key, down ? qtrue : qfalse, Sys_Milliseconds() );
+}
+
+EMSCRIPTEN_KEEPALIVE void RTCW_BrowserControllerReleaseAll( void )
+{
+	int key;
+
+	for ( key = 0; key < RTCW_BROWSER_CONTROLLER_KEYS; key++ ) {
+		if ( rtcwBrowserControllerKeys[ key ] ) {
+			CL_KeyEvent( key, qfalse, Sys_Milliseconds() );
+			rtcwBrowserControllerKeys[ key ] = 0;
+		}
+	}
+}
