+	Cvar_SetValue( "r_lodbias", 2 - quality );
+	Cvar_SetValue( "r_subdivisions", quality == 2 ? 4 : ( quality == 1 ? 8 : 16 ) );
+	Cvar_SetValue( "r_dynamiclight", quality > 0 ? 1 : 0 );
+	Cvar_SetValue( "com_maxfps", Com_Clamp( 20, 240, fps ) );
+}
