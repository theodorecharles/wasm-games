+	catcher = Key_GetCatcher();
+	if ( clc.state == CA_CINEMATIC ) {
+		return 3; /* cinematic/debrief */
+	}
+	if ( clc.state == CA_ACTIVE ) {
+		return catcher ? 2 : 1; /* paused/menu overlay or gameplay */
+	}
+	if ( clc.state >= CA_CONNECTING && clc.state < CA_ACTIVE ) {
+		return 4; /* loading/connecting */
+	}
+	return 0; /* native menu */
+}
