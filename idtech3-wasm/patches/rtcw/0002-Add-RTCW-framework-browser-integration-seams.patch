@@ -298,6 +298,9 @@ typedef struct qfile_us {
 typedef struct {
 	qfile_ut handleFiles;
 	qboolean handleSync;
+#ifdef __EMSCRIPTEN__
+	qboolean browserPersistentWrite;
+#endif
 	int fileSize;
 	int zipFilePos;
 	int zipFileLen;
@@ -307,6 +310,10 @@ typedef struct {
 
 static fileHandleData_t fsh[MAX_FILE_HANDLES];
 
+#ifdef __EMSCRIPTEN__
+extern void RTCW_BrowserPersistenceChanged( int immediate );
+#endif
+
 // TTimo - show_bug.cgi?id=540
 // wether we did a reorder on the current search path when joining the server
 static qboolean fs_reordered;
@@ -912,6 +919,11 @@ void FS_FCloseFile( fileHandle_t f ) {
 	if ( fsh[f].handleFiles.file.o ) {
 		fclose( fsh[f].handleFiles.file.o );
 	}
+#ifdef __EMSCRIPTEN__
+	if ( fsh[f].browserPersistentWrite ) {
+		RTCW_BrowserPersistenceChanged( !Q_stricmpn( fsh[f].name, "save/", 5 ) );
+	}
+#endif
 	Com_Memset( &fsh[f], 0, sizeof( fsh[f] ) );
 }
 
@@ -952,6 +964,9 @@ fileHandle_t FS_FOpenFileWrite( const char *filename ) {
 	Q_strncpyz( fsh[f].name, filename, sizeof( fsh[f].name ) );
 
 	fsh[f].handleSync = qfalse;
+#ifdef __EMSCRIPTEN__
+	fsh[f].browserPersistentWrite = qtrue;
+#endif
 	if ( !fsh[f].handleFiles.file.o ) {
 		f = 0;
 	}
@@ -994,6 +1009,9 @@ fileHandle_t FS_FOpenFileAppend( const char *filename ) {
 
 	fsh[f].handleFiles.file.o = Sys_FOpen( ospath, "ab" );
 	fsh[f].handleSync = qfalse;
+#ifdef __EMSCRIPTEN__
+	fsh[f].browserPersistentWrite = qtrue;
+#endif
 	if ( !fsh[f].handleFiles.file.o ) {
 		f = 0;
 	}
