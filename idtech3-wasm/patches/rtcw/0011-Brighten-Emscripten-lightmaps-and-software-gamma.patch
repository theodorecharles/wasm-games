From 9a7988f3a0ba817c09bcaee341f48228e264cc29 Mon Sep 17 00:00:00 2001
From: Ted Charles <me@tedcharles.net>
Date: Sat, 15 Aug 2026 14:35:00 -0400
Subject: [PATCH] Brighten Emscripten lightmaps and software gamma

WebGL has no hardware overbright, so depot interiors crush after
two-pass modulate. Lift lightmap samples and default gamma/intensity.
---
 MP/code/renderer/tr_bsp.c   | 17 +++++++++++++++++
 MP/code/renderer/tr_image.c |  8 ++++++++
 MP/code/renderer/tr_init.c  |  8 ++++++++
 3 files changed, 33 insertions(+)

diff --git a/MP/code/renderer/tr_bsp.c b/MP/code/renderer/tr_bsp.c
index 03a07ff..3709750 100644
--- a/MP/code/renderer/tr_bsp.c
+++ b/MP/code/renderer/tr_bsp.c
@@ -125,6 +125,23 @@ static void R_ColorShiftLightingBytes( byte in[4], byte out[4] ) {
 		b = b * 255 / max;
 	}
 
+#ifdef __EMSCRIPTEN__
+	/* No hardware gamma or overbright. Two-pass modulate of stock
+	 * lightmaps reads almost black in WebGL; lift them here. */
+	r = ( r * 3 ) / 2;
+	g = ( g * 3 ) / 2;
+	b = ( b * 3 ) / 2;
+	if ( r > 255 ) {
+		r = 255;
+	}
+	if ( g > 255 ) {
+		g = 255;
+	}
+	if ( b > 255 ) {
+		b = 255;
+	}
+#endif
+
 	out[0] = r;
 	out[1] = g;
 	out[2] = b;
diff --git a/MP/code/renderer/tr_image.c b/MP/code/renderer/tr_image.c
index 189b2eb..4f8a439 100644
--- a/MP/code/renderer/tr_image.c
+++ b/MP/code/renderer/tr_image.c
@@ -1619,6 +1619,14 @@ void R_SetColorMappings( void ) {
 	} else if ( r_gamma->value > 3.0f ) {
 		ri.Cvar_Set( "r_gamma", "3.0" );
 	}
+#ifdef __EMSCRIPTEN__
+	if ( r_gamma->value < 1.4f ) {
+		ri.Cvar_Set( "r_gamma", "1.5" );
+	}
+	if ( r_intensity->value < 1.3f ) {
+		ri.Cvar_Set( "r_intensity", "1.4" );
+	}
+#endif
 
 	g = r_gamma->value;
 
diff --git a/MP/code/renderer/tr_init.c b/MP/code/renderer/tr_init.c
index 6df01be..d3f9038 100644
--- a/MP/code/renderer/tr_init.c
+++ b/MP/code/renderer/tr_init.c
@@ -1239,7 +1239,11 @@ void R_Register( void ) {
 	ri.Cvar_CheckRange( r_displayRefresh, 0, 200, qtrue );
 	r_fullbright = ri.Cvar_Get ("r_fullbright", "0", CVAR_LATCH ); // JPW NERVE removed per atvi request
 	r_mapOverBrightBits = ri.Cvar_Get( "r_mapOverBrightBits", "2", CVAR_LATCH );
+#ifdef __EMSCRIPTEN__
+	r_intensity = ri.Cvar_Get( "r_intensity", "1.4", CVAR_LATCH );
+#else
 	r_intensity = ri.Cvar_Get( "r_intensity", "1", CVAR_LATCH );
+#endif
 	r_singleShader = ri.Cvar_Get( "r_singleShader", "0", CVAR_CHEAT | CVAR_LATCH );
 
 	//
@@ -1267,7 +1271,11 @@ void R_Register( void ) {
 	r_swapInterval = ri.Cvar_Get( "r_swapInterval", "0",
 					CVAR_ARCHIVE | CVAR_LATCH );
 
+#ifdef __EMSCRIPTEN__
+	r_gamma = ri.Cvar_Get( "r_gamma", "1.5", CVAR_ARCHIVE );
+#else
 	r_gamma = ri.Cvar_Get( "r_gamma", "1", CVAR_ARCHIVE ); // Varies by system and platform, so just default to 1
+#endif
 	r_facePlaneCull = ri.Cvar_Get( "r_facePlaneCull", "1", CVAR_ARCHIVE );
 
 	r_railWidth = ri.Cvar_Get( "r_railWidth", "16", CVAR_ARCHIVE );
-- 
