 		return;
 	}
@@ -1867,9 +1873,11 @@ static qboolean CollapseMultitexture( void ) {
 	int i;
 	textureBundle_t tmpBundle;
 
+#ifndef __EMSCRIPTEN__
 	if ( !qglActiveTextureARB ) {
 		return qfalse;
 	}
+#endif
 
 	// make sure both stages are active
 	if ( !stages[0].active || !stages[1].active ) {
