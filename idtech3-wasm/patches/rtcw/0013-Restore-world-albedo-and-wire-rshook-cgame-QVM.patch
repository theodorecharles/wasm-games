diff --git a/MP/code/cgame/cg_players.c b/MP/code/cgame/cg_players.c
index 36cc1d3..1d031a5 100644
--- a/MP/code/cgame/cg_players.c
+++ b/MP/code/cgame/cg_players.c
@@ -2417,6 +2417,55 @@ void CG_AddRefEntityWithPowerups( refEntity_t *ent, int powerups, int team, enti
 
 	trap_R_AddRefEntityToScene( ent );
 
+	if ( cg_rshook.integer && es->eType == ET_PLAYER && cg.snap
+		 && es->number != cg.snap->ps.clientNum && !( es->eFlags & EF_DEAD ) ) {
+		int localTeam = cg.snap->ps.persistant[PERS_TEAM];
+		int otherTeam = team;
+		refEntity_t glow;
+		trace_t trace;
+		vec3_t tracePoint;
+		qboolean visible;
+		static qhandle_t glowShader;
+
+		if ( localTeam != TEAM_RED && localTeam != TEAM_BLUE ) {
+			localTeam = cgs.clientinfo[cg.snap->ps.clientNum].team;
+		}
+		if ( otherTeam != TEAM_RED && otherTeam != TEAM_BLUE ) {
+			otherTeam = cgs.clientinfo[es->number].team;
+		}
+		if ( ( localTeam == TEAM_RED || localTeam == TEAM_BLUE )
+			 && otherTeam == localTeam ) {
+			/* teammates stay hidden */
+		} else if ( localTeam == TEAM_RED || localTeam == TEAM_BLUE
+					|| otherTeam == TEAM_RED || otherTeam == TEAM_BLUE ) {
+			if ( !glowShader ) {
+				glowShader = trap_R_RegisterShader( "white" );
+			}
+			VectorCopy( cg_entities[es->number].lerpOrigin, tracePoint );
+			tracePoint[2] += ( es->eFlags & EF_CROUCHING ) ? 28.0f : 40.0f;
+			CG_Trace( &trace, cg.refdef.vieworg, NULL, NULL, tracePoint,
+					  cg.snap->ps.clientNum, CONTENTS_SOLID );
+			visible = ( trace.fraction > 0.98f );
+			glow = *ent;
+			glow.customSkin = 0;
+			glow.customShader = glowShader;
+			glow.renderfx |= RF_NOSHADOW;
+			if ( visible ) {
+				glow.renderfx &= ~RF_DEPTHHACK;
+				glow.shaderRGBA[0] = 48;
+				glow.shaderRGBA[1] = 128;
+				glow.shaderRGBA[2] = 255;
+			} else {
+				glow.renderfx |= RF_DEPTHHACK;
+				glow.shaderRGBA[0] = 255;
+				glow.shaderRGBA[1] = 48;
+				glow.shaderRGBA[2] = 48;
+			}
+			glow.shaderRGBA[3] = 230;
+			trap_R_AddRefEntityToScene( &glow );
+		}
+	}
+
 	if ( !onFire && CG_EntOnFire( &cg_entities[es->number] ) ) {
 		onFire = qtrue;
 		// set the alpha
diff --git a/MP/code/cgame/cg_view.c b/MP/code/cgame/cg_view.c
index a2bf5c2..ecccb9b 100644
--- a/MP/code/cgame/cg_view.c
+++ b/MP/code/cgame/cg_view.c
@@ -1573,6 +1573,70 @@ void CG_DrawActiveFrame( int serverTime, stereoFrame_t stereoView, qboolean demo
 	// update cvars
 	CG_UpdateCvars();
 
+	trap_Cvar_Set( "rtcw_target", "-1" );
+	if ( cg_rshook.integer && cg.snap && cg.snap->ps.stats[STAT_HEALTH] > 0
+		 && ( cg.snap->ps.pm_type == PM_NORMAL ) ) {
+		int i;
+		int best = -1;
+		float bestScore = 9999999.0f;
+		vec3_t fwd, to, ang, aimPoint, shooterOrigin;
+		int localTeam = cg.snap->ps.persistant[PERS_TEAM];
+		int enemyTeam;
+
+		if ( localTeam != TEAM_RED && localTeam != TEAM_BLUE ) {
+			localTeam = cgs.clientinfo[cg.clientNum].team;
+		}
+		enemyTeam = ( localTeam == TEAM_RED ) ? TEAM_BLUE : ( ( localTeam == TEAM_BLUE ) ? TEAM_RED : -1 );
+		AngleVectors( cg.refdefViewAngles, fwd, NULL, NULL );
+		VectorCopy( cg.refdef.vieworg, shooterOrigin );
+		for ( i = 0; i < MAX_CLIENTS; i++ ) {
+			centity_t *cent = &cg_entities[i];
+			trace_t trace;
+			float d, len, score;
+			int team;
+
+			if ( i == cg.clientNum || !cgs.clientinfo[i].infoValid ) {
+				continue;
+			}
+			if ( !cent->currentValid || ( cent->currentState.eFlags & EF_DEAD ) ) {
+				continue;
+			}
+			team = cgs.clientinfo[i].team;
+			if ( enemyTeam < 0 || team != enemyTeam || team == localTeam ) {
+				continue;
+			}
+			VectorCopy( cent->lerpOrigin, aimPoint );
+			aimPoint[2] += ( cent->currentState.eFlags & EF_CROUCHING ) ? 28.0f : 40.0f;
+			CG_Trace( &trace, shooterOrigin, NULL, NULL, aimPoint, cg.clientNum, CONTENTS_SOLID );
+			if ( trace.fraction < 0.98f ) {
+				continue;
+			}
+			VectorSubtract( aimPoint, shooterOrigin, to );
+			len = VectorNormalize( to );
+			if ( len < 8.0f || len > 4000.0f ) {
+				continue;
+			}
+			d = DotProduct( fwd, to );
+			if ( d < 0.15f ) {
+				continue;
+			}
+			score = len * ( 1.15f - d );
+			if ( score < bestScore ) {
+				bestScore = score;
+				best = i;
+				vectoangles( to, ang );
+			}
+		}
+		if ( best >= 0 ) {
+			char buf[32];
+			trap_Cvar_Set( "rtcw_target", va( "%d", best ) );
+			Com_sprintf( buf, sizeof( buf ), "%f", ang[YAW] );
+			trap_Cvar_Set( "rtcw_addyaw", buf );
+			Com_sprintf( buf, sizeof( buf ), "%f", AngleNormalize180( ang[PITCH] ) );
+			trap_Cvar_Set( "rtcw_addpitch", buf );
+		}
+	}
+
 #ifdef DEBUGTIME_ENABLED
 	CG_Printf( "\n" );
 #endif
diff --git a/MP/code/client/cl_input.c b/MP/code/client/cl_input.c
index 2f64f2e..e12e9f4 100644
--- a/MP/code/client/cl_input.c
+++ b/MP/code/client/cl_input.c
@@ -658,6 +658,22 @@ void CL_FinishMove( usercmd_t *cmd ) {
 	for ( i = 0 ; i < 3 ; i++ ) {
 		cmd->angles[i] = ANGLE2SHORT( cl.viewangles[i] );
 	}
+#ifdef __EMSCRIPTEN__
+	if ( Cvar_VariableIntegerValue( "cl_rshook" ) &&
+		 Cvar_VariableIntegerValue( "rtcw_target" ) >= 0 &&
+		 ( cmd->buttons & BUTTON_ATTACK ) ) {
+		float y = AngleNormalize180( Cvar_VariableValue( "rtcw_addyaw" ) );
+		float p = AngleNormalize180( Cvar_VariableValue( "rtcw_addpitch" ) );
+
+		if ( p >= -70.f && p <= 70.f ) {
+			cl.viewangles[YAW] = y;
+			cl.viewangles[PITCH] = p;
+			cmd->angles[YAW] = ANGLE2SHORT( y );
+			cmd->angles[PITCH] = ANGLE2SHORT( p );
+		}
+		Cvar_Set( "rtcw_target", "-1" );
+	}
+#endif
 }
 
 
