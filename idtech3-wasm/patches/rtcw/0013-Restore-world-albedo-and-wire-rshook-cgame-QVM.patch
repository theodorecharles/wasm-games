+#ifdef __EMSCRIPTEN__
+static void CL_RsHook_f( void ) {
+	int on = !Cvar_VariableIntegerValue( "cl_rshook" );
+
+	Cvar_Get( "cl_rshook", "0", 0 );
+	Cvar_Set( "cl_rshook", on ? "1" : "0" );
+	Com_Printf( "rshook %s\n", on ? "on" : "off" );
+}
+#endif
