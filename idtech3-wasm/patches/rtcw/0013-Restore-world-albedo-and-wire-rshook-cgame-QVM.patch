 /*
 ====================
 CL_Init
@@ -4198,6 +4208,15 @@ void CL_Init( void ) {
 	Cmd_SetCommandCompletionFunc( "demo", CL_CompleteDemoName );
 	Cmd_AddCommand( "cinematic", CL_PlayCinematic_f );
 	Cmd_AddCommand( "stoprecord", CL_StopRecord_f );
+#ifdef __EMSCRIPTEN__
+	Cvar_Get( "cl_rshook", "0", 0 );
+	Cvar_Get( "rtcw_target", "-1", 0 );
+	Cvar_Get( "rtcw_addyaw", "0", 0 );
+	Cvar_Get( "rtcw_addpitch", "0", 0 );
+	Cmd_AddCommand( "rshook", CL_RsHook_f );
+	Cmd_AddCommand( "icebot", CL_RsHook_f );
+	Cmd_AddCommand( "ethook", CL_RsHook_f );
+#endif
 	Cmd_AddCommand( "connect", CL_Connect_f );
 	Cmd_AddCommand( "reconnect", CL_Reconnect_f );
 	Cmd_AddCommand( "localservers", CL_LocalServers_f );
diff --git a/MP/code/renderer/tr_backend.c b/MP/code/renderer/tr_backend.c
index 99f46c0..41dfe30 100644
--- a/MP/code/renderer/tr_backend.c
+++ b/MP/code/renderer/tr_backend.c
@@ -208,12 +208,18 @@ void GL_State( unsigned long stateBits ) {
 	// check depthFunc bits
 	//
 	if ( diff & GLS_DEPTHFUNC_EQUAL ) {
+#ifdef __EMSCRIPTEN__
+		/* WebGL depth precision makes GL_EQUAL fail; LEQUAL still
+		 * rejects fragments behind the first pass. */
+		qglDepthFunc( GL_LEQUAL );
+#else
 		if ( stateBits & GLS_DEPTHFUNC_EQUAL ) {
 			qglDepthFunc( GL_EQUAL );
 		} else
 		{
 			qglDepthFunc( GL_LEQUAL );
 		}
+#endif
 	}
 
 	//
diff --git a/MP/code/renderer/tr_shade.c b/MP/code/renderer/tr_shade.c
index 339372d..1a6b190 100644
--- a/MP/code/renderer/tr_shade.c
+++ b/MP/code/renderer/tr_shade.c
@@ -443,12 +443,14 @@ static void DrawMultitextured( shaderCommands_t *input, int stage ) {
 	}
 	qglTexCoordPointer( 2, GL_FLOAT, 0, input->svars.texcoords[0] );
 	R_BindAnimatedImage( &pStage->bundle[1] );
+	/* Default depth func is LEQUAL. GL_EQUAL often fails on WebGL
+	 * and left only the lightmap (gray world, colored lamps). */
 	if ( r_lightmap->integer ) {
-		GL_State( GLS_DEPTHFUNC_EQUAL );
+		GL_State( 0 );
 	} else if ( add ) {
-		GL_State( GLS_SRCBLEND_ONE | GLS_DSTBLEND_ONE | GLS_DEPTHFUNC_EQUAL );
+		GL_State( GLS_SRCBLEND_ONE | GLS_DSTBLEND_ONE );
 	} else {
-		GL_State( GLS_SRCBLEND_DST_COLOR | GLS_DSTBLEND_ZERO | GLS_DEPTHFUNC_EQUAL );
+		GL_State( GLS_SRCBLEND_DST_COLOR | GLS_DSTBLEND_ZERO );
 	}
 	R_DrawElements( input->numIndexes, input->indexes );
 	return;
diff --git a/MP/code/renderer/tr_shader.c b/MP/code/renderer/tr_shader.c
index 148c87e..268d5f1 100644
--- a/MP/code/renderer/tr_shader.c
+++ b/MP/code/renderer/tr_shader.c
@@ -1772,6 +1772,12 @@ static void ComputeStageIteratorFunc( void ) {
