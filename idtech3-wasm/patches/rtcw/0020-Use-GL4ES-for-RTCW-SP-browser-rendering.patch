@@ -125,6 +115,24 @@ QGL_ARB_vertex_array_object_PROCS;
 QGL_EXT_direct_state_access_PROCS;
 #undef GLE
 
+#ifdef __EMSCRIPTEN__
+static SDL_bool GLimp_GL4ESExtensionSupported( const char *name ) {
+	const char *extensions = (const char *)qglGetString( GL_EXTENSIONS );
+	const char *match;
+	size_t length = strlen( name );
+	if ( !extensions || !length || strchr( name, ' ' ) ) return SDL_FALSE;
+	match = extensions;
+	while ( ( match = strstr( match, name ) ) != NULL ) {
+		if ( ( match == extensions || match[-1] == ' ' ) &&
+		     ( match[length] == '\0' || match[length] == ' ' ) ) return SDL_TRUE;
+		match += length;
+	}
+	return SDL_FALSE;
+}
+/* Query translator capabilities, not the underlying browser GLES surface. */
+#define SDL_GL_ExtensionSupported GLimp_GL4ESExtensionSupported
+#endif
