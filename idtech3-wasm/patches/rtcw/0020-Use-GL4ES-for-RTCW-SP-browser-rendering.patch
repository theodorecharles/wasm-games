From a22b0594044f76e9748083bf60afe075763e9ce1 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 4 Sep 2026 16:40:00 -0400
Subject: [PATCH] Use GL4ES for RTCW SP browser rendering

---
 SP/Makefile                |  9 ++--
 SP/code/client/cl_main.c   | 10 ++++
 SP/code/renderer/tr_init.c | 31 +++++++++++-
 SP/code/sdl/sdl_glimp.c    | 99 +++++++++++++-------------------------
 scripts/build-web-sp.sh    |  2 +-
 5 files changed, 77 insertions(+), 74 deletions(-)

diff --git a/SP/Makefile b/SP/Makefile
index df72184..64f651a 100644
--- a/SP/Makefile
+++ b/SP/Makefile
@@ -1036,7 +1036,7 @@ ifeq ($(PLATFORM),emscripten)
   ifeq ($(USE_OPENGLES),1)
     BASE_CFLAGS += -DUSE_OPENGLES
   endif
-  CLIENT_CFLAGS += -sUSE_SDL=2
+  CLIENT_CFLAGS += -sUSE_SDL=2 -I$(GL4ES_PATH)/include
   OPTIMIZEVM = -O2
   OPTIMIZE = -O2
 
@@ -1046,16 +1046,13 @@ ifeq ($(PLATFORM),emscripten)
   SHLIBLDFLAGS=
   THREAD_LIBS=
   LIBS=
-  CLIENT_LIBS=
+  CLIENT_LIBS=$(GL4ES_PATH)/lib/libGL.a
   RENDERER_LIBS=
   SERVER_LIBS=
 
   CLIENT_LDFLAGS += \
     -sUSE_SDL=2 \
-    -sLEGACY_GL_EMULATION=1 \
-    -sGL_UNSAFE_OPTS=0 \
-    -sMIN_WEBGL_VERSION=2 \
-    -sMAX_WEBGL_VERSION=2 \
+    -sFULL_ES2=1 \
     -sALLOW_MEMORY_GROWTH=1 \
     -sINITIAL_MEMORY=268435456 \
     -sSTACK_SIZE=2097152 \
diff --git a/SP/code/client/cl_main.c b/SP/code/client/cl_main.c
index a5de411..991f813 100644
--- a/SP/code/client/cl_main.c
+++ b/SP/code/client/cl_main.c
@@ -1909,6 +1909,12 @@ void CL_Vid_Restart_f( void ) {
 
 	vmCvar_t musicCvar;
 
+#ifdef __EMSCRIPTEN__
+	/* GL4ES cannot safely recreate its context in place (see Wwasm). */
+	Com_Printf( "Save your game and reload the page to apply video settings.\n" );
+	return;
+#endif
+
 	// RF, don't show percent bar, since the memory usage will just sit at the same level anyway
 	Cvar_Set( "com_expectedhunkusage", "-1" );
 
@@ -2008,6 +2014,10 @@ handles will be invalid
 */
 void CL_Snd_Restart_f(void)
 {
+#ifdef __EMSCRIPTEN__
+	Com_Printf( "Save your game and reload the page to restart audio.\n" );
+	return;
+#endif
 	CL_Snd_Shutdown();
 	// sound will be reinitialized by vid_restart
 	CL_Vid_Restart_f();
