 	r_gamma = ri.Cvar_Get( "r_gamma", "1", CVAR_ARCHIVE ); // Varies by system and platform, so just default to 1
+#endif
 	r_facePlaneCull = ri.Cvar_Get( "r_facePlaneCull", "1", CVAR_ARCHIVE );
 
 	r_railWidth = ri.Cvar_Get( "r_railWidth", "16", CVAR_ARCHIVE );
@@ -1302,7 +1315,10 @@ void R_Register( void ) {
 	r_mapFogColor = ri.Cvar_Get( "r_mapFogColor", "0", CVAR_ROM );  //----(SA)	added
 	r_savegameFogColor = ri.Cvar_Get( "r_savegameFogColor", "0", CVAR_ROM );    //----(SA)	added
 
-#ifdef USE_OPENGLES
+#ifdef __EMSCRIPTEN__
+	/* Configuration scripts must not select strip/immediate-mode rendering. */
+	r_primitives = ri.Cvar_Get( "r_primitives", "2", CVAR_ROM );
+#elif defined(USE_OPENGLES)
 	r_primitives = ri.Cvar_Get( "r_primitives", "2", CVAR_ARCHIVE );
 #else
 	r_primitives = ri.Cvar_Get( "r_primitives", "0", CVAR_ARCHIVE );
@@ -1407,6 +1423,18 @@ void R_Init( void ) {
 
 	ri.Printf( PRINT_ALL, "----- R_Init -----\n" );
 
+#ifdef __EMSCRIPTEN__
+	/* Like Wwasm, initialize the static GL4ES translator before GL lookup. */
+	{
+		static qboolean gl4esStarted = qfalse;
+		extern void initialize_gl4es( void );
+		if ( !gl4esStarted ) {
+			initialize_gl4es();
+			gl4esStarted = qtrue;
+		}
+	}
+#endif
+
 	// clear all our internal state
 	memset( &tr, 0, sizeof( tr ) );
 	memset( &backEnd, 0, sizeof( backEnd ) );
@@ -1637,4 +1665,3 @@ refexport_t *GetRefAPI( int apiVersion, refimport_t *rimp ) {
 
 	return &re;
 }
