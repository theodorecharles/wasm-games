 	case UI_REFRESH:
 		_UI_Refresh( arg0 );
 		return 0;
@@ -6986,6 +6996,43 @@ void _UI_MouseEvent( int dx, int dy ) {
 
 }
 
+void UI_BrowserPointerPosition( int x, int y ) {
