From: Ted Charles <me@tedcharles.net>
Date: Sat, 15 Aug 2026 08:05:00 -0400
Subject: [PATCH] Fix RTCW browser viewport and legacy GL state

---
 MP/Makefile               |  1 +
 MP/code/cgame/cg_main.c   | 28 +++++++++++++++++++++++
 MP/code/cgame/cg_public.h |  2 ++
 MP/code/sys/sys_main.c    | 14 ++++++++++++
 MP/code/ui/ui_main.c      | 47 +++++++++++++++++++++++++++++++++++++++
 MP/code/ui/ui_public.h    |  4 +++-
 SP/Makefile               |  1 +
 SP/code/cgame/cg_main.c   | 28 +++++++++++++++++++++++
 SP/code/cgame/cg_public.h |  2 ++
 SP/code/sys/sys_main.c    | 14 ++++++++++++
 SP/code/ui/ui_main.c      | 47 +++++++++++++++++++++++++++++++++++++++
 SP/code/ui/ui_public.h    |  4 +++-
 12 files changed, 190 insertions(+), 2 deletions(-)

diff --git a/MP/Makefile b/MP/Makefile
index 8085ad8..8aa5afa 100644
--- a/MP/Makefile
+++ b/MP/Makefile
@@ -1064,6 +1064,7 @@ ifeq ($(PLATFORM),emscripten)
   CLIENT_LDFLAGS += \
     -sUSE_SDL=2 \
     -sLEGACY_GL_EMULATION=1 \
+    -sGL_UNSAFE_OPTS=0 \
     -sMIN_WEBGL_VERSION=2 \
     -sMAX_WEBGL_VERSION=2 \
     -sALLOW_MEMORY_GROWTH=1 \
diff --git a/MP/code/cgame/cg_main.c b/MP/code/cgame/cg_main.c
index 5728e16..3b38781 100644
--- a/MP/code/cgame/cg_main.c
+++ b/MP/code/cgame/cg_main.c
@@ -44,6 +44,7 @@ int autoReloadModificationCount = -1;
 
 void CG_Init( int serverMessageNum, int serverCommandSequence, int clientNum );
 void CG_Shutdown( void );
+void CG_BrowserResize( void );
 
 
 /*
@@ -86,6 +87,9 @@ Q_EXPORT intptr_t vmMain( intptr_t command, intptr_t arg0, intptr_t arg1, intptr
 		return CG_GetTag( arg0, (char *)arg1, (orientation_t *)arg2 );
 	case CG_CHECKCENTERVIEW:
 		return CG_CheckCenterView();
+	case CG_BROWSER_RESIZE:
+		CG_BrowserResize();
+		return 0;
 	default:
 		CG_Error( "vmMain: unknown command %li", (long)command );
 		break;
@@ -96,6 +100,30 @@ Q_EXPORT intptr_t vmMain( intptr_t command, intptr_t arg0, intptr_t arg1, intptr
 
 cg_t cg;
 cgs_t cgs;
+
+void CG_BrowserResize( void ) {
+	trap_GetGlconfig( &cgs.glconfig );
+	cgs.screenXScaleStretch = cgs.glconfig.vidWidth * ( 1.0 / 640.0 );
+	cgs.screenYScaleStretch = cgs.glconfig.vidHeight * ( 1.0 / 480.0 );
+	cgs.screenXBias = 0;
+	cgs.screenYBias = 0;
+	if ( cg_fixedAspect.integer ) {
+		cgs.screenXScale = cgs.screenXScaleStretch;
+		cgs.screenYScale = cgs.screenYScaleStretch;
+		if ( cgs.glconfig.vidWidth * 480 > cgs.glconfig.vidHeight * 640 ) {
+			cgs.screenXBias = 0.5 * ( cgs.glconfig.vidWidth -
+				( cgs.glconfig.vidHeight * ( 640.0 / 480.0 ) ) );
+			cgs.screenXScale = cgs.screenYScale;
+		} else {
+			cgs.screenYBias = 0.5 * ( cgs.glconfig.vidHeight -
+				( cgs.glconfig.vidWidth * ( 480.0 / 640.0 ) ) );
+			cgs.screenYScale = cgs.screenXScale;
+		}
+	} else {
+		cgs.screenXScale = cgs.screenXScaleStretch;
+		cgs.screenYScale = cgs.screenYScaleStretch;
+	}
+}
 centity_t cg_entities[MAX_GENTITIES];
 weaponInfo_t cg_weapons[MAX_WEAPONS];
 itemInfo_t cg_items[MAX_ITEMS];
diff --git a/MP/code/cgame/cg_public.h b/MP/code/cgame/cg_public.h
index df9869b..4084067 100644
--- a/MP/code/cgame/cg_public.h
+++ b/MP/code/cgame/cg_public.h
@@ -279,6 +279,8 @@ typedef enum {
 	CG_CHECKCENTERVIEW,
 //	qboolean CG_CheckCenterView();
 
+	CG_BROWSER_RESIZE,
+
 } cgameExport_t;
 
 //----------------------------------------------
diff --git a/MP/code/sys/sys_main.c b/MP/code/sys/sys_main.c
index 867d119..20ee596 100644
--- a/MP/code/sys/sys_main.c
+++ b/MP/code/sys/sys_main.c
@@ -189,6 +189,14 @@ EMSCRIPTEN_KEEPALIVE void RTCW_BrowserControllerLook( float x, float y )
 	}
 }
 
+EMSCRIPTEN_KEEPALIVE void RTCW_BrowserPointerPosition( float x, float y )
+{
+	if ( rtcwBrowserStarted && uivm && ( Key_GetCatcher() & KEYCATCH_UI ) ) {
+		VM_Call( uivm, UI_BROWSER_POINTER_POSITION,
+			(int)Com_Clamp( 0, 640, x ), (int)Com_Clamp( 0, 480, y ) );
+	}
+}
+
 EMSCRIPTEN_KEEPALIVE void RTCW_BrowserOpenMenu( void )
 {
 	if ( !rtcwBrowserStarted || RTCW_BrowserRuntimeState() != 1 ) {
@@ -280,6 +288,12 @@ EMSCRIPTEN_KEEPALIVE void RTCW_BrowserResize( int width, int height )
 	Cvar_SetValue( "r_mode", -1 );
 	Cvar_SetValue( "r_customwidth", width );
 	Cvar_SetValue( "r_customheight", height );
+	if ( uivm ) {
+		VM_Call( uivm, UI_BROWSER_RESIZE );
+	}
+	if ( cgvm ) {
+		VM_Call( cgvm, CG_BROWSER_RESIZE );
+	}
 }
 
 EMSCRIPTEN_KEEPALIVE int RTCW_BrowserRenderWidth( void )
