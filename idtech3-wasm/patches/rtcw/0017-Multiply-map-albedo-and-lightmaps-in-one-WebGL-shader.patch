From 1bf7b377e01c5ddb85572c9aeef34d864650dd82 Mon Sep 17 00:00:00 2001
From: Ted Charles <me@tedcharles.net>
Date: Sat, 15 Aug 2026 15:30:47 -0400
Subject: [PATCH] Multiply map albedo and lightmaps in one WebGL shader

Sequential framebuffer blend never applied the second pass, so the
world was either fullbright textures or lightmaps only. Sample both
in one program like WolfET.
---
 MP/Makefile                 |   1 +
 MP/code/renderer/tr_es2.c   | 325 ++++++++++++++++++++++++++++++++++++
 MP/code/renderer/tr_local.h |   7 +
 MP/code/renderer/tr_shade.c |  23 +--
 4 files changed, 340 insertions(+), 16 deletions(-)
 create mode 100644 MP/code/renderer/tr_es2.c

diff --git a/MP/Makefile b/MP/Makefile
index a6addb0..047ed28 100644
--- a/MP/Makefile
+++ b/MP/Makefile
@@ -2011,6 +2011,7 @@ Q3ROBJ = \
   $(B)/renderer/tr_noise.o \
   $(B)/renderer/tr_scene.o \
   $(B)/renderer/tr_shade.o \
+  $(B)/renderer/tr_es2.o \
