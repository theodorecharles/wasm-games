diff --git a/code/cgame/cg_view.c b/code/cgame/cg_view.c
index 0fc763a9..e70c66d3 100644
--- a/code/cgame/cg_view.c
+++ b/code/cgame/cg_view.c
@@ -746,6 +746,18 @@ static void CG_PlayBufferedSounds( void ) {
 
 //=========================================================================
 
+static void CG_ApplyWasmResize( void ) {
+	char serial[32];
+	char applied[32];
+
+	trap_Cvar_VariableStringBuffer( "cg_wasmResizeSerial", serial, sizeof(serial) );
+	trap_Cvar_VariableStringBuffer( "cg_wasmResizeApplied", applied, sizeof(applied) );
+	if( serial[0] && Q_stricmp( serial, applied ) ) {
+		trap_Cvar_Set( "cg_wasmResizeApplied", serial );
+		trap_SendConsoleCommand( "vid_restart fast\n" );
+	}
+}
