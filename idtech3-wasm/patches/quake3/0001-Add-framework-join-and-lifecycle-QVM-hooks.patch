diff --git a/Makefile b/Makefile
index 036dbba4..c76fb8f9 100644
--- a/Makefile
+++ b/Makefile
@@ -1381,7 +1381,10 @@ ifndef TOOLS_CC
   TOOLS_CC = gcc
 endif
 
-TOOLS_OPTIMIZE = -g -Wall -fno-strict-aliasing
+# The lcc host tools use identifiers which became C++ keywords in GCC's
+# implicit dialect.  Pin their intended C dialect so current toolchains build
+# the unchanged QVM compiler reliably.
+TOOLS_OPTIMIZE = -std=gnu17 -g -Wall -fno-strict-aliasing
 TOOLS_CFLAGS += $(TOOLS_OPTIMIZE) \
                 -DTEMPDIR=\"$(TEMPDIR)\" -DSYSTEM=\"\" \
                 -I$(Q3LCCSRCDIR) \
