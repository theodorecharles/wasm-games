@@ -30,6 +30,27 @@ Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
 uiStatic_t		uis;
 qboolean		m_entersound;		// after a frame, so caching won't disrupt the sound
 
+static void UI_ApplyWasmPointer( void ) {
+	char serial[32];
+	char applied[32];
+	char value[32];
+
+	trap_Cvar_VariableStringBuffer( "ui_wasmPointerSerial", serial, sizeof(serial) );
+	trap_Cvar_VariableStringBuffer( "ui_wasmPointerApplied", applied, sizeof(applied) );
+	if( !serial[0] || !Q_stricmp( serial, applied ) ) {
+		return;
+	}
+
+	uis.cursorx = Com_Clamp( 0, SCREEN_WIDTH, trap_Cvar_VariableValue( "ui_wasmPointerX" ) );
+	uis.cursory = Com_Clamp( 0, SCREEN_HEIGHT, trap_Cvar_VariableValue( "ui_wasmPointerY" ) );
+	Com_sprintf( value, sizeof(value), "%d", uis.cursorx );
+	trap_Cvar_Set( "ui_wasmPointerAppliedX", value );
+	Com_sprintf( value, sizeof(value), "%d", uis.cursory );
+	trap_Cvar_Set( "ui_wasmPointerAppliedY", value );
+	trap_Cvar_Set( "ui_wasmPointerApplied", serial );
+	UI_MouseEvent( 0, 0 );
+}
+
 void QDECL Com_Error( int level, const char *error, ... ) {
 	va_list		argptr;
 	char		text[1024];
@@ -102,6 +123,9 @@ void UI_PushMenu( menuframework_s *menu )
 	}
 
 	uis.activemenu = menu;
+	trap_Cvar_Set( "ui_nativeMenu", "1" );
+	trap_Cvar_Set( "ui_captureIntent", "0" );
+	trap_Cvar_Set( "ui_wasmCaptureTarget", "" );
 
 	// default cursor position
 	menu->cursor      = 0;
@@ -157,6 +181,8 @@ void UI_ForceMenuOff (void)
 	trap_Key_SetCatcher( trap_Key_GetCatcher() & ~KEYCATCH_UI );
 	trap_Key_ClearStates();
 	trap_Cvar_Set( "cl_paused", "0" );
+	trap_Cvar_Set( "ui_nativeMenu", "0" );
+	trap_Cvar_Set( "ui_wasmCaptureTarget", "" );
 }
 
 /*
@@ -851,6 +877,10 @@ void UI_KeyEvent( int key, int down ) {
 		return;
 	}
 
+	// The browser publishes an absolute point before its SDL button event. Apply
+	// that exact 640x480 position before Q3 resolves mouse focus and activation.
+	UI_ApplyWasmPointer();
+
 	if (!down) {
 		return;
 	}
@@ -1184,6 +1214,21 @@ void UI_UpdateScreen( void ) {
 	trap_UpdateScreen();
 }
 
+static void UI_ApplyWasmResize( void ) {
+	char serial[32];
+	char applied[32];
+
+	trap_Cvar_VariableStringBuffer( "ui_wasmResizeSerial", serial, sizeof(serial) );
+	trap_Cvar_VariableStringBuffer( "ui_wasmResizeApplied", applied, sizeof(applied) );
+	if( serial[0] && Q_stricmp( serial, applied ) ) {
+		trap_Cvar_Set( "ui_wasmResizeApplied", serial );
+		// The browser already published the new drawing buffer and forced mode
+		// cvars. Put QuakeJS's own fast mode update at the front of the native
+		// command buffer instead of waiting behind the desktop SDL debounce.
+		trap_Cmd_ExecuteText( EXEC_NOW, "vid_restart fast\n" );
+	}
+}
+
 /*
 =================
 UI_Refresh
@@ -1191,6 +1236,7 @@ UI_Refresh
 */
 void UI_Refresh( int realtime )
 {
+	UI_ApplyWasmResize();
 	uis.frametime = realtime - uis.realtime;
 	uis.realtime  = realtime;
 
@@ -1198,6 +1244,11 @@ void UI_Refresh( int realtime )
 		return;
 	}
 
+	// Apply browser absolute coordinates before hover state and menu draw. SDL's
+	// relative mouse path remains exclusively for captured gameplay look.
+	UI_ApplyWasmPointer();
+	trap_Cvar_Set( "ui_wasmCaptureTarget", "" );
+
 	UI_UpdateCvars();
 
 	if ( uis.activemenu )
