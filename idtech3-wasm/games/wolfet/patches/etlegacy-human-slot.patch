+/**
+ * @brief True for Omni-Bot / fill bots that should yield to a human.
+ */
+qboolean G_ClientIsFillBot(gentity_t *ent)
+{
+	if (!ent || !ent->inuse || !ent->client)
+	{
+		return qfalse;
+	}
+	if (ent->r.svFlags & SVF_BOT)
+	{
+		return qtrue;
+	}
+	if (Q_stristr(ent->client->pers.netname, "[BOT]"))
+	{
+		return qtrue;
+	}
+	return qfalse;
+}
+
+/**
+ * @brief Count humans on a team, ignoring fill bots and ignoreClientNum.
+ */
+int G_TeamCountHumans(int ignoreClientNum, team_t team)
+{
+	int i, ref, count = 0;
+
+	for (i = 0; i < level.numConnectedClients; i++)
+	{
+		ref = level.sortedClients[i];
+		if (ref == ignoreClientNum)
+		{
+			continue;
+		}
+		if (level.clients[ref].sess.sessionTeam != team)
+		{
+			continue;
+		}
+		if (G_ClientIsFillBot(g_entities + ref))
+		{
+			continue;
+		}
+		count++;
+	}
+
+	return count;
+}
+
+/**
+ * @brief Disconnect one bot on team so a human can take the slot.
+ *        Prefers a bot whose class matches playerType when that is valid.
+ * @return qtrue if a bot was removed
+ */
+qboolean G_YieldBotSlot(team_t team, int playerType)
+{
+	int       i, ref, fallback = -1, preferred = -1;
+	gentity_t *bot;
+
+	if (team != TEAM_AXIS && team != TEAM_ALLIES)
+	{
+		return qfalse;
+	}
+
+	for (i = 0; i < level.numConnectedClients; i++)
+	{
+		ref = level.sortedClients[i];
+		bot = g_entities + ref;
+
+		if (!G_ClientIsFillBot(bot))
+		{
+			continue;
+		}
+		if (bot->client->sess.sessionTeam != team)
+		{
+			continue;
+		}
+
+		if (playerType >= PC_SOLDIER && playerType <= PC_COVERTOPS &&
+		    (bot->client->sess.latchPlayerType == playerType ||
+		     bot->client->sess.playerType == playerType))
+		{
+			preferred = ref;
+			break;
+		}
+		if (fallback < 0)
+		{
+			fallback = ref;
+		}
+	}
+
+	ref = (preferred >= 0) ? preferred : fallback;
+	if (ref < 0)
+	{
+		return qfalse;
+	}
+
+	/* Move them off the team before the drop so TeamCount updates even if
+	 * the engine defers ClientDisconnect until the next frame. */
+	level.clients[ref].sess.sessionTeam    = TEAM_SPECTATOR;
+	level.clients[ref].sess.spectatorState = SPECTATOR_FREE;
+	G_LogPrintf("YieldBotSlot: dropping %i (%s) for human join on team %i\n",
+	            ref, level.clients[ref].pers.netname, team);
+	trap_DropClient(ref, "slot yielded to player", 0);
+	return qtrue;
+}
