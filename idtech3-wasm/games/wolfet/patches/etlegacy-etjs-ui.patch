+/**
+ * Charset status on the campaign side panel. Drawn last so it cannot lose
+ * to camp_side. Sized for the 200px-wide official text column.
+ */
+static void ETJS_DrawLoadStatus(void)
+{
+	const char *status;
+	const char *detail;
+	float      x = 464.f;
+	float      y = 28.f;
+
+	if (cls.state < CA_CONNECTING || cls.state > CA_PRIMED)
+	{
+		return;
+	}
+
+	switch (cls.state)
+	{
+	case CA_CONNECTING:
+		status = "Awaiting connection...";
+		break;
+	case CA_CHALLENGING:
+		status = "Awaiting challenge...";
+		break;
+	case CA_CONNECTED:
+		status = "Awaiting gamestate...";
+		break;
+	case CA_LOADING:
+	case CA_PRIMED:
+		detail = Cvar_VariableString("etjs_loadstatus");
+		status = (detail && detail[0]) ? detail : "LOADING";
+		break;
+	default:
+		status = "CONNECTING...";
+		break;
+	}
+
+	ETJS_DrawLoadLine(x, y, 10.f, 16.f, "CONNECTING...");
+	y += 22.f;
+	if (cls.servername[0])
+	{
+		ETJS_DrawLoadLine(x, y, 8.f, 12.f, cls.servername);
+		y += 18.f;
+	}
+	ETJS_DrawLoadLine(x, y, 8.f, 12.f, status);
+}
