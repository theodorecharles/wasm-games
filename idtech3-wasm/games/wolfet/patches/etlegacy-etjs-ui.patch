+static void ETJS_Contain640(float *x, float *y, float *w, float *h)
+{
+	float scale = MIN(cls.glconfig.vidWidth / 640.f, cls.glconfig.vidHeight / 480.f);
+	float xbias = (cls.glconfig.vidWidth - 640.f * scale) * 0.5f;
+	float ybias = (cls.glconfig.vidHeight - 480.f * scale) * 0.5f;
+
+	if (x)
+	{
+		*x = *x * scale + xbias;
+	}
+	if (y)
+	{
+		*y = *y * scale + ybias;
+	}
+	if (w)
+	{
+		*w *= scale;
+	}
+	if (h)
+	{
+		*h *= scale;
+	}
+}
+
+static void ETJS_DrawLoadLine(float x640, float y640, float cw, float ch, const char *text)
+{
+	float      x, y, w, h, startX;
+	const char *s;
+	int        maxChars, n;
+
+	if (!text || !text[0])
+	{
+		return;
+	}
+
+	/* camp_side is 440–640. Official TTF starts near 464. */
+	x = x640;
+	y = y640;
+	w = cw;
+	h = ch;
+	ETJS_Contain640(&x, &y, &w, &h);
+	startX    = x;
+	maxChars  = (int)((168.f / cw) + 0.5f);
+	if (maxChars < 8)
+	{
+		maxChars = 8;
+	}
+
+	/* Use the console charset so width/height stay under our control.
+	 * SRC_DrawSingleChar prefers the TTF console font and ignores size. */
+	re.SetColor(colorBlack);
+	x = startX + 1.f;
+	s = text;
+	n = 0;
+	while (*s && n < maxChars)
+	{
+		int   ch, row, col;
+
+		if (Q_IsColorString(s))
+		{
+			s += 2;
+			continue;
+		}
+		ch  = Q_UTF8_CodePoint(s) & 255;
+		row = ch >> 4;
+		col = ch & 15;
+		re.DrawStretchPic(x + 1.f, y + 1.f, w, h,
+		                  col * 0.0625f, row * 0.0625f,
+		                  col * 0.0625f + 0.0625f, row * 0.0625f + 0.0625f,
+		                  cls.charSetShader);
+		x += w;
+		s += Q_UTF8_Width(s);
+		n++;
+	}
+
+	re.SetColor(colorWhite);
+	x = startX;
+	s = text;
+	n = 0;
+	while (*s && n < maxChars)
+	{
+		int   ch, row, col;
+
+		if (Q_IsColorString(s))
+		{
+			s += 2;
+			continue;
+		}
+		ch  = Q_UTF8_CodePoint(s) & 255;
+		row = ch >> 4;
+		col = ch & 15;
+		re.DrawStretchPic(x, y, w, h,
+		                  col * 0.0625f, row * 0.0625f,
+		                  col * 0.0625f + 0.0625f, row * 0.0625f + 0.0625f,
+		                  cls.charSetShader);
+		x += w;
+		s += Q_UTF8_Width(s);
+		n++;
+	}
+	re.SetColor(NULL);
+}
