+	shell              = *ent;
+	shell.customSkin    = 0;
+	shell.customShader  = cgs.media.shoutcastLandmineShader;
+	shell.renderfx     |= RF_NOSHADOW;
+	shell.shaderRGBA[3] = 230;
+	if (visible)
+	{
+		shell.renderfx     &= ~RF_DEPTHHACK;
+		shell.shaderRGBA[0] = 48;
