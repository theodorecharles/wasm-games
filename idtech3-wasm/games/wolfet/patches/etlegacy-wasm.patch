+/**
+ * Immediate look offset from the page (mouse/keyboard). Updates the
+ * client viewangles so the next usercmd and predicted view rotate.
+ */
+EMSCRIPTEN_KEEPALIVE
+void ETJS_AddLook(float yaw, float pitch)
+{
+	static int lookLog;
+
+	/* Follow-cam: local mouse must not rotate the followed player's view. */
+	if (cls.state == CA_ACTIVE && cl.snap.valid && (cl.snap.ps.pm_flags & 4096))
+	{
+		return;
+	}
+	if (Cvar_VariableIntegerValue("etjs_resetlook"))
+	{
+		cl.viewangles[PITCH] = 0.f;
+		Cvar_Set("etjs_resetlook", "0");
+	}
+
+	/* Usercmd pitch is cyclic. Canonicalize hook-produced values such as 355
+	 * to -5 before applying the browser delta and the manual-look clamp. */
+	cl.viewangles[PITCH] = AngleNormalize180(cl.viewangles[PITCH]);
+	cl.viewangles[YAW]   += yaw;
+	cl.viewangles[PITCH] += pitch;
+	if (cl.viewangles[PITCH] > 89.f)
+	{
+		cl.viewangles[PITCH] = 89.f;
+	}
+	else if (cl.viewangles[PITCH] < -89.f)
+	{
+		cl.viewangles[PITCH] = -89.f;
+	}
+	/* Absolute angles for rshook. Do not also add these in cgame. */
+	Cvar_Set("etjs_addyaw", va("%f", cl.viewangles[YAW]));
+	Cvar_Set("etjs_addpitch", va("%f", cl.viewangles[PITCH]));
+	Cvar_Set("etjs_yaw", va("%d", (int)cl.viewangles[YAW]));
+	Cvar_Set("etjs_pitch", va("%d", (int)cl.viewangles[PITCH]));
+	if (lookLog < 8 && (yaw != 0.f || pitch != 0.f))
+	{
+		Com_DPrintf("ETJS look yaw=%.1f pitch=%.1f -> %.1f %.1f\n",
+		           yaw, pitch, cl.viewangles[YAW], cl.viewangles[PITCH]);
+		lookLog++;
+	}
+}
