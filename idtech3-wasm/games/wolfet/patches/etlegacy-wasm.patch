 		set(CMAKE_SHARED_MODULE_SUFFIX "")
+	elseif(EMSCRIPTEN)
+		target_link_libraries(os_libraries INTERFACE m)
+		set(LIB_SUFFIX ".mp.wasm.")
 	else()
 		target_link_libraries(os_libraries INTERFACE  m ${CMAKE_DL_LIBS} rt pthread)
 		set(LIB_SUFFIX ".mp.")
