+static void ETJS_AddDeployableHookShell(refEntity_t *ent, centity_t *cent)
+{
+	refEntity_t shell;
+	trace_t     trace;
+	qboolean    visible;
+
+	if (!ETJS_RevealEnemyDeployable(&cent->currentState) ||
+	    !cgs.media.shoutcastLandmineShader)
