+	if (uivm && (cls.keyCatchers & KEYCATCH_UI))
+	{
+		/* Pin then place so a page click hits the official 640-space control. */
+		VM_Call(uivm, UI_MOUSE_EVENT, -10000, -10000);
+		VM_Call(uivm, UI_MOUSE_EVENT, (int)x, (int)y);
+	}
+	else if (cgvm && (cls.keyCatchers & KEYCATCH_CGAME))
+	{
+		/* Cgame panels consume relative deltas. Pin and place the cursor so
+		 * browser coordinates remain exact across limbo/debrief transitions. */
+		VM_Call(cgvm, CG_MOUSE_EVENT, -10000, -10000);
+		VM_Call(cgvm, CG_MOUSE_EVENT, (int)x, (int)y);
+	}
+}
