+void ETJS_SetCursor(float x, float y)
+{
+	static float lastx = 320.f;
+	static float lasty = 240.f;
+	int          dx    = (int)(x - lastx);
+	int          dy    = (int)(y - lasty);
+
+	Cvar_Set("etjs_cx", va("%f", x));
+	Cvar_Set("etjs_cy", va("%f", y));
+	lastx = x;
+	lasty = y;
