+static void ETJS_TexImage2D(GLenum target, GLint level, GLint internalFormat,
+                            GLsizei width, GLsizei height, GLint border,
+                            GLenum format, GLenum type, const void *pixels)
+{
+	GLenum ifmt = ETJS_UnsizedFormat((GLenum)internalFormat);
+	GLenum fmt  = ETJS_UnsizedFormat(format);
