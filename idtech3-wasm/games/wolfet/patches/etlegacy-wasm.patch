+/**
+ * Open text or voice communication synchronously from the browser input
+ * bridge. Queuing these commands from JavaScript races pointer-lock loss and
+ * leaves the page guessing whether the UI catcher actually opened.
+ *
+ * mode 1: global chat, mode 2: team chat, mode 3: quick voice menu
+ */
+EMSCRIPTEN_KEEPALIVE
+int ETJS_OpenCommunication(int mode)
+{
+	const char *command;
+	int menu;
+	intptr_t activeMenu;
+	int opened;
+
+	Com_Printf("ETJS communication request mode=%d state=%d cg=%d ui=%d catchers=%d active=%ld\n",
+	           mode, (int)cls.state, cgvm ? 1 : 0, uivm ? 1 : 0,
+	           cls.keyCatchers,
+	           uivm ? (long)VM_Call(uivm, UI_GET_ACTIVE_MENU) : -1L);
+
+	if (cls.state != CA_ACTIVE || !cgvm || !uivm)
+	{
+		Com_Printf("ETJS communication unavailable (state=%d cg=%d ui=%d)\n",
+		           (int)cls.state, cgvm ? 1 : 0, uivm ? 1 : 0);
+		return 0;
+	}
+
+	switch (mode)
+	{
+		case 1:
+			command = "messagemode";
+			menu = UIMENU_INGAME_MESSAGEMODE;
+			break;
+		case 2:
+			command = "messagemode2";
+			menu = UIMENU_INGAME_MESSAGEMODE;
+			break;
+		case 3:
+			command = "mp_quickmessage";
+			menu = UIMENU_WM_QUICKMESSAGE;
+			break;
+		default: return 0;
+	}
+
+	/* Execute the stock cgame command synchronously.  In particular,
+	 * CG_QuickMessage_f clears cgame event handling before it asks the UI VM to
+	 * open the voice menu.  Calling UI_SET_ACTIVE_MENU here skipped that state
+	 * transition, so the next cgame frame immediately reclaimed input and T,
+	 * Y, V and Escape all appeared to do nothing in the browser. */
+	Cmd_ExecuteString(command);
+	activeMenu = VM_Call(uivm, UI_GET_ACTIVE_MENU);
+	opened = (cls.keyCatchers & KEYCATCH_UI) != 0 && activeMenu == menu;
+	Com_Printf("ETJS communication result mode=%d command=%s requested=%d active=%ld catchers=%d opened=%d\n",
+	           mode, command, menu, (long)activeMenu, cls.keyCatchers, opened);
+	return opened;
+}
