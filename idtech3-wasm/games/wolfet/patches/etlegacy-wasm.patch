+static void ETJS_Fill640(float x, float y, float w, float h, float r, float g, float b, float a)
+{
+	vec4_t color;
+
+	color[0] = r;
+	color[1] = g;
+	color[2] = b;
+	color[3] = a;
+	re.SetColor(color);
+	SCR_AdjustFrom640(&x, &y, &w, &h);
+	re.DrawStretchPic(x, y, w, h, 0, 0, 0, 0, cls.whiteShader);
+	re.SetColor(NULL);
+}
+
+static void ETJS_Pic640(float x, float y, float w, float h, qhandle_t shader)
+{
+	if (!shader)
+	{
+		return;
+	}
+	re.SetColor(NULL);
+	SCR_AdjustFrom640(&x, &y, &w, &h);
+	re.DrawStretchPic(x, y, w, h, 0, 0, 1, 1, shader);
+}
+
+static qhandle_t ETJS_SplashShader(void)
+{
+	if (etjsSplashSlide <= 0)
+	{
+		if (!etjsLogoId)
+		{
+			etjsLogoId = re.RegisterShaderNoMip("ui/assets/logo_id");
+		}
+		return etjsLogoId;
+	}
+	if (etjsSplashSlide == 1)
+	{
+		if (!etjsLogoSd)
+		{
+			etjsLogoSd = re.RegisterShaderNoMip("ui/assets/logo_sd");
+		}
+		return etjsLogoSd;
+	}
+	if (!etjsLogoEt)
+	{
+		etjsLogoEt = re.RegisterShaderNoMip("ui/assets/et_logo");
+	}
+	return etjsLogoEt;
+}
+
+static void ETJS_DrawEngineSplash(void)
+{
+	qhandle_t shader;
+	float     w, h, x, y;
+
+	re.SetColor(colorBlack);
+	re.DrawStretchPic(0, 0, cls.glconfig.vidWidth, cls.glconfig.vidHeight, 0, 0, 0, 0, cls.whiteShader);
+	re.SetColor(NULL);
+
+	if (!etjsSplashShown)
+	{
+		etjsSplashShown   = qtrue;
+		etjsSplashSlide   = 0;
+		etjsSplashSlideAt = cls.realtime;
+		Cvar_Set("etjs_splash", "1");
+		Com_Printf("ETJS splash start\n");
+	}
+
+	if (etjsSplashSlide < 2 && cls.realtime - etjsSplashSlideAt > 2500)
+	{
+		etjsSplashSlide++;
+		etjsSplashSlideAt = cls.realtime;
+		Com_DPrintf("ETJS splash slide %d\n", etjsSplashSlide);
+	}
+	else if (etjsSplashSlide >= 2 && cls.realtime - etjsSplashSlideAt > 2500)
+	{
+		Cvar_Set("etjs_splash", "2");
+		Com_DPrintf("ETJS splash skip\n");
+		return;
+	}
+
+	shader = ETJS_SplashShader();
+	if (shader)
+	{
+		w = (float)MIN(400, MIN(cls.glconfig.vidWidth, cls.glconfig.vidHeight));
+		h = w;
+		x = (cls.glconfig.vidWidth - w) * 0.5f;
+		y = (cls.glconfig.vidHeight - h) * 0.5f;
+		re.DrawStretchPic(x, y, w, h, 0, 0, 1, 1, shader);
+	}
