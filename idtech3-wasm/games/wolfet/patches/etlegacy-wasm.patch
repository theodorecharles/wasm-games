 void CG_AdjustFrom640(float *x, float *y, float *w, float *h)
 {
+#ifdef __EMSCRIPTEN__
+	if (cg_etjsContainUi.integer != 0)
+	{
+		float scale = MIN((float)cgs.glconfig.vidWidth / 640.0f,
+		                  (float)cgs.glconfig.vidHeight / 480.0f);
+		float xbias = (cgs.glconfig.vidWidth - 640.0f * scale) * 0.5f;
+		float ybias = (cgs.glconfig.vidHeight - 480.0f * scale) * 0.5f;
+
+		/* Loading/limbo/debrief panels were shifted into ETLegacy's extended
+		 * widescreen virtual space during setup. Undo that permanent shift
+		 * before applying the browser's contained 640x480 transform. */
+		*x = (*x - cgs.wideXoffset) * scale + xbias;
+		*y = *y * scale + ybias;
+		*w *= scale;
+		*h *= scale;
+		return;
+	}
+#endif
 	// scale for screen sizes
 	*x *= cgs.screenXScale;
 	*y *= cgs.screenYScale;
