+/**
+ * @brief Invalidate cached widescreen anchors after a live viewport resize.
+ */
+void CG_InvalidateHudPositions(void)
+{
+	unsigned int i, j;
+
+	for (i = 0; i < hudData.count; i++)
+	{
+		hudStucture_t *hud = hudData.list[i];
+
+		if (!hud)
+		{
+			continue;
+		}
+		hud->computed = qfalse;
+		for (j = 0; j < HUD_COMPONENTS_NUM; j++)
+		{
+			if (hud->components[j])
+			{
+				hud->components[j]->computed = qfalse;
+			}
+		}
+	}
+}
