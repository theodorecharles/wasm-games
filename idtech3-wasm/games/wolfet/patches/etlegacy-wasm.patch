+#ifdef GL_LUMINANCE
+	    && fmt != GL_LUMINANCE
+#endif
+#ifdef GL_LUMINANCE_ALPHA
+	    && fmt != GL_LUMINANCE_ALPHA
+#endif
+	    )
+	{
+		fmt = GL_RGBA;
+	}
+	if (ifmt != fmt)
+	{
+		ifmt = fmt;
+	}
