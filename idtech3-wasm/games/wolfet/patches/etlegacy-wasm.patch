+++ b/src/renderer/tr_es2.c
@@ -0,0 +1,704 @@
+/**
+ * @file renderer/tr_es2.c
+ * @brief WebGL / GLES2 tessellator submit. Applies the stock
+ * projection * modelview matrices as a uniform so the FFP matrix
+ * stack is not required (and is not used — it loses the WebGL context).
+ */
+
+#include "tr_local.h"
+
+#ifdef __EMSCRIPTEN__
+
+#ifndef GL_VERTEX_SHADER
+#define GL_VERTEX_SHADER        0x8B31
+#endif
+#ifndef GL_FRAGMENT_SHADER
+#define GL_FRAGMENT_SHADER      0x8B30
+#endif
+#ifndef GL_COMPILE_STATUS
+#define GL_COMPILE_STATUS       0x8B81
+#endif
+#ifndef GL_LINK_STATUS
+#define GL_LINK_STATUS          0x8B82
+#endif
+#ifndef GL_INFO_LOG_LENGTH
+#define GL_INFO_LOG_LENGTH      0x8B84
+#endif
+
+extern GLuint glCreateShader(GLenum type);
+extern void   glShaderSource(GLuint shader, GLsizei count, const char *const *string, const GLint *length);
+extern void   glCompileShader(GLuint shader);
+extern void   glGetShaderiv(GLuint shader, GLenum pname, GLint *params);
+extern void   glGetShaderInfoLog(GLuint shader, GLsizei bufSize, GLsizei *length, char *infoLog);
+extern GLuint glCreateProgram(void);
+extern void   glAttachShader(GLuint program, GLuint shader);
+extern void   glLinkProgram(GLuint program);
+extern void   glGetProgramiv(GLuint program, GLenum pname, GLint *params);
+extern void   glGetProgramInfoLog(GLuint program, GLsizei bufSize, GLsizei *length, char *infoLog);
+extern void   glUseProgram(GLuint program);
+extern GLint  glGetAttribLocation(GLuint program, const char *name);
+extern GLint  glGetUniformLocation(GLuint program, const char *name);
+extern void   glUniformMatrix4fv(GLint location, GLsizei count, GLboolean transpose, const float *value);
+extern void   glUniform1i(GLint location, GLint v0);
+extern void   glUniform1f(GLint location, float v0);
+extern void   glEnableVertexAttribArray(GLuint index);
+extern void   glDisableVertexAttribArray(GLuint index);
+extern void   glVertexAttribPointer(GLuint index, GLint size, GLenum type, GLboolean normalized, GLsizei stride, const void *pointer);
+extern void   glVertexAttrib4f(GLuint index, float x, float y, float z, float w);
+extern void   glBindBuffer(GLenum target, GLuint buffer);
+extern void   glGenBuffers(GLsizei n, GLuint *buffers);
+extern void   glBufferData(GLenum target, long size, const void *data, GLenum usage);
+extern void   glDepthMask(unsigned char flag);
+extern void   glDepthFunc(GLenum func);
+
+#ifndef GL_EQUAL
+#define GL_EQUAL  0x0202
+#endif
+#ifndef GL_LEQUAL
+#define GL_LEQUAL 0x0203
+#endif
+
+#ifndef GL_ARRAY_BUFFER
+#define GL_ARRAY_BUFFER 0x8892
+#endif
+#ifndef GL_ELEMENT_ARRAY_BUFFER
+#define GL_ELEMENT_ARRAY_BUFFER 0x8893
+#endif
+#ifndef GL_STREAM_DRAW
+#define GL_STREAM_DRAW 0x88E0
+#endif
+
+static GLuint    s_prog;
+static GLint     s_uMvp, s_uTex, s_uAlphaTest, s_aPos, s_aUv, s_aColor;
+static GLuint    s_lmProg;
+static GLint     s_lmUMvp, s_lmUTex0, s_lmUTex1, s_lmUAdd, s_lmUAlphaTest;
+static GLint     s_lmAPos, s_lmAUv0, s_lmAUv1, s_lmAColor;
+static GLuint    s_vbo, s_ibo;
+static float     s_ortho[16];
+static qboolean  s_ready;
+static qboolean  s_lmReady;
+static qboolean  s_failed;
+static int       s_logn;
+static int       s_lmLogn;
+static int       s_submits;
+
+typedef struct
+{
+	float         x, y, z;
+	float         u, v;
+	unsigned char r, g, b, a;
+} es2Vert_t;
+
+typedef struct
+{
+	float         x, y, z;
+	float         u0, v0;
+	float         u1, v1;
+	unsigned char r, g, b, a;
+} es2LmVert_t;
+
+static void MatIdent(float *m)
+{
+	Com_Memset(m, 0, 16 * sizeof(float));
+	m[0] = m[5] = m[10] = m[15] = 1.f;
+}
+
+static void MatOrtho(float *m, float l, float r, float b, float t, float n, float f)
+{
+	MatIdent(m);
+	m[0]  = 2.f / (r - l);
+	m[5]  = 2.f / (t - b);
+	m[10] = -2.f / (f - n);
+	m[12] = -(r + l) / (r - l);
+	m[13] = -(t + b) / (t - b);
+	m[14] = -(f + n) / (f - n);
+}
+
+static void MatMul(float *out, const float *a, const float *b)
+{
+	int i, j, k;
+	float tmp[16];
+
+	for (i = 0; i < 4; i++)
+	{
+		for (j = 0; j < 4; j++)
+		{
+			float s = 0.f;
+			for (k = 0; k < 4; k++)
+			{
+				s += a[k * 4 + j] * b[i * 4 + k];
+			}
+			tmp[i * 4 + j] = s;
+		}
+	}
+	Com_Memcpy(out, tmp, sizeof(tmp));
+}
+
+static GLuint Compile(GLenum type, const char *src)
+{
+	GLuint sh = glCreateShader(type);
+	GLint  ok = 0;
+	const char *p = src;
+
+	if (!sh)
+	{
+		return 0;
+	}
+	glShaderSource(sh, 1, &p, NULL);
+	glCompileShader(sh);
+	glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+	if (!ok)
+	{
+		char log[256];
+		log[0] = 0;
+		glGetShaderInfoLog(sh, sizeof(log) - 1, NULL, log);
+		ri.Printf(PRINT_ALL, "ES2 shader compile failed: %s\n", log);
+		return 0;
+	}
+	return sh;
+}
+
+void R_ES2_Init(void)
+{
+	static const char *vs =
+	    "attribute vec3 a_pos;\n"
+	    "attribute vec2 a_uv;\n"
+	    "attribute vec4 a_color;\n"
+	    "uniform mat4 u_mvp;\n"
+	    "varying highp vec2 v_uv;\n"
+	    "varying vec4 v_color;\n"
+	    "void main(){\n"
+	    "  gl_Position = u_mvp * vec4(a_pos, 1.0);\n"
+	    "  v_uv = a_uv;\n"
+	    "  v_color = a_color;\n"
+	    "}\n";
+	static const char *fs =
+	    "precision highp float;\n"
+	    "uniform sampler2D u_tex;\n"
+	    "uniform int u_alphaTest;\n"
+	    "varying highp vec2 v_uv;\n"
+	    "varying vec4 v_color;\n"
+	    "void main(){\n"
+	    "  vec4 c = texture2D(u_tex, v_uv) * v_color;\n"
+	    "  if (u_alphaTest == 1 && c.a <= 0.0) discard;\n"
+	    "  if (u_alphaTest == 2 && c.a >= 0.5) discard;\n"
+	    "  if (u_alphaTest == 3 && c.a < 0.5) discard;\n"
+	    "  gl_FragColor = c;\n"
+	    "}\n";
+	GLuint vsh, fsh;
+	GLint  ok = 0;
+
+	if (s_ready || s_failed)
+	{
+		return;
+	}
+
+	vsh = Compile(GL_VERTEX_SHADER, vs);
+	fsh = Compile(GL_FRAGMENT_SHADER, fs);
+	if (!vsh || !fsh)
+	{
+		s_failed = qtrue;
+		return;
+	}
+	s_prog = glCreateProgram();
+	glAttachShader(s_prog, vsh);
+	glAttachShader(s_prog, fsh);
+	glLinkProgram(s_prog);
+	glGetProgramiv(s_prog, GL_LINK_STATUS, &ok);
+	if (!ok)
+	{
+		char log[256];
+		log[0] = 0;
+		glGetProgramInfoLog(s_prog, sizeof(log) - 1, NULL, log);
+		ri.Printf(PRINT_ALL, "ES2 program link failed: %s\n", log);
+		s_failed = qtrue;
+		return;
+	}
+	s_aPos   = glGetAttribLocation(s_prog, "a_pos");
+	s_aUv    = glGetAttribLocation(s_prog, "a_uv");
+	s_aColor = glGetAttribLocation(s_prog, "a_color");
+	s_uMvp   = glGetUniformLocation(s_prog, "u_mvp");
+	s_uTex   = glGetUniformLocation(s_prog, "u_tex");
+	s_uAlphaTest = glGetUniformLocation(s_prog, "u_alphaTest");
+	s_ready  = qtrue;
+	glGenBuffers(1, &s_vbo);
+	glGenBuffers(1, &s_ibo);
+
+	{
+		static const char *lmvs =
+		    "attribute vec3 a_pos;\n"
+		    "attribute vec2 a_uv0;\n"
+		    "attribute vec2 a_uv1;\n"
+		    "attribute vec4 a_color;\n"
+		    "uniform mat4 u_mvp;\n"
+		    "varying highp vec2 v_uv0;\n"
+		    "varying highp vec2 v_uv1;\n"
+		    "varying vec4 v_color;\n"
+		    "void main(){\n"
+		    "  gl_Position = u_mvp * vec4(a_pos, 1.0);\n"
+		    "  v_uv0 = a_uv0;\n"
+		    "  v_uv1 = a_uv1;\n"
+		    "  v_color = a_color;\n"
+		    "}\n";
+		static const char *lmfs =
+		    "precision highp float;\n"
+		    "uniform sampler2D u_tex0;\n"
+		    "uniform sampler2D u_tex1;\n"
+		    "uniform float u_add;\n"
+		    "uniform int u_alphaTest;\n"
+		    "varying highp vec2 v_uv0;\n"
+		    "varying highp vec2 v_uv1;\n"
+		    "varying vec4 v_color;\n"
+		    "void main(){\n"
+		    "  vec4 d = texture2D(u_tex0, v_uv0);\n"
+		    "  vec4 l = texture2D(u_tex1, v_uv1);\n"
+		    "  vec4 c = (u_add > 0.5) ? (d + l) * v_color : d * l * v_color;\n"
+		    "  if (u_alphaTest == 1 && c.a <= 0.0) discard;\n"
+		    "  if (u_alphaTest == 2 && c.a >= 0.5) discard;\n"
+		    "  if (u_alphaTest == 3 && c.a < 0.5) discard;\n"
+		    "  if (u_alphaTest == 4 && c.a <= 0.0) discard;\n"
+		    "  gl_FragColor = c;\n"
+		    "}\n";
+		GLuint lmvsh = Compile(GL_VERTEX_SHADER, lmvs);
+		GLuint lmfsh = Compile(GL_FRAGMENT_SHADER, lmfs);
+		GLint  lmok  = 0;
+
+		if (lmvsh && lmfsh)
+		{
+			s_lmProg = glCreateProgram();
+			glAttachShader(s_lmProg, lmvsh);
+			glAttachShader(s_lmProg, lmfsh);
+			glLinkProgram(s_lmProg);
+			glGetProgramiv(s_lmProg, GL_LINK_STATUS, &lmok);
+			if (lmok)
+			{
+				s_lmAPos   = glGetAttribLocation(s_lmProg, "a_pos");
+				s_lmAUv0   = glGetAttribLocation(s_lmProg, "a_uv0");
+				s_lmAUv1   = glGetAttribLocation(s_lmProg, "a_uv1");
+				s_lmAColor = glGetAttribLocation(s_lmProg, "a_color");
+				s_lmUMvp   = glGetUniformLocation(s_lmProg, "u_mvp");
+				s_lmUTex0  = glGetUniformLocation(s_lmProg, "u_tex0");
+				s_lmUTex1  = glGetUniformLocation(s_lmProg, "u_tex1");
+				s_lmUAdd   = glGetUniformLocation(s_lmProg, "u_add");
+				s_lmUAlphaTest = glGetUniformLocation(s_lmProg, "u_alphaTest");
+				s_lmReady  = qtrue;
+			}
+			else
+			{
+				char log[256];
+				log[0] = 0;
+				glGetProgramInfoLog(s_lmProg, sizeof(log) - 1, NULL, log);
+				ri.Printf(PRINT_ALL, "ES2 lightmap program link failed: %s\n", log);
+			}
+		}
+	}
+
+	R_ES2_Set2D();
+	ri.Printf(PRINT_DEVELOPER, "ES2 tessellator ready lm=%i\n", s_lmReady ? 1 : 0);
+}
+
+static void ES2_ApplyDepth(void)
+{
+	unsigned long bits = glState.glStateBits;
+
+	if (bits & GLS_DEPTHTEST_DISABLE)
+	{
+		glDisable(GL_DEPTH_TEST);
+		return;
+	}
+	glEnable(GL_DEPTH_TEST);
+	glDepthFunc((bits & GLS_DEPTHFUNC_EQUAL) ? GL_EQUAL : GL_LEQUAL);
+	glDepthMask((bits & GLS_DEPTHMASK_TRUE) ? 1 : 0);
+}
+
+void R_ES2_BeginView(void)
+{
+	/* 2D/limbo leaves DEPTHTEST_DISABLE + no depth write. Force a fresh
+	 * 3D default so the world is not drawn into a disabled depth buffer
+	 * and then covered by the sky-blue clear. The 2D pass also leaves
+	 * SRC_ALPHA blending enabled. Merely resetting glState's cached bits
+	 * does not change WebGL, and legacy model textures often have unused
+	 * zero alpha; with stale blending those models disappear completely. */
+	glState.glStateBits = GLS_DEFAULT;
+	backEnd.projection2D = qfalse;
+	glDisable(GL_BLEND);
+	glEnable(GL_DEPTH_TEST);
+	glDepthFunc(GL_LEQUAL);
+	glDepthMask(1);
+}
+
+void R_ES2_BeginFrame(void)
+{
+	s_submits = 0;
+}
+
+void R_ES2_Set2D(void)
+{
+	int w = glConfig.vidWidth  > 0 ? glConfig.vidWidth  : 1280;
+	int h = glConfig.vidHeight > 0 ? glConfig.vidHeight : 800;
+
+	/* Match the native glOrtho(..., 0, 1) exactly. Some stock 2D shaders use
+	 * an alpha-tested depth-writing mask followed by depthFunc equal (the
+	 * circular compass map), so 2D cannot be forced depthless globally. */
+	MatOrtho(s_ortho, 0.f, (float)w, (float)h, 0.f, 0.f, 1.f);
+}
+
+void R_ES2_SetFlare2D(void)
+{
+	int w = glConfig.vidWidth  > 0 ? glConfig.vidWidth  : 1280;
+	int h = glConfig.vidHeight > 0 ? glConfig.vidHeight : 800;
+
+	/* Flare coordinates are produced in OpenGL's bottom-left window space,
+	 * unlike the regular top-left HUD coordinates. Keep a dedicated ortho so
+	 * lamp coronas land on their fixtures instead of being mirrored vertically. */
+	MatOrtho(s_ortho, 0.f, (float)w, 0.f, (float)h, -99999.f, 99999.f);
+}
+
+static void CurrentMvp(float *mvp)
+{
+	if (backEnd.projection2D)
+	{
+		Com_Memcpy(mvp, s_ortho, 16 * sizeof(float));
+		return;
+	}
+	MatMul(mvp, backEnd.viewParms.projectionMatrix, backEnd.orientation.modelMatrix);
+}
+
+static int CurrentAlphaTest(void)
+{
+	switch (glState.glStateBits & GLS_ATEST_BITS)
+	{
+	case GLS_ATEST_GT_0:
+		return 1;
+	case GLS_ATEST_LT_80:
+		return 2;
+	case GLS_ATEST_GE_80:
+		return 3;
+	default:
+		return 0;
+	}
+}
+
+static void BindProgram(const float *mvp)
+{
+	R_ES2_Init();
+	if (!s_ready)
+	{
+		return;
+	}
+	glUseProgram(s_prog);
+	glUniformMatrix4fv(s_uMvp, 1, GL_FALSE, mvp);
+	if (s_uTex >= 0)
+	{
+		glUniform1i(s_uTex, 0);
+	}
+	if (s_uAlphaTest >= 0)
+	{
+		glUniform1i(s_uAlphaTest, CurrentAlphaTest());
+	}
+}
+
+static void BindPacked(const es2Vert_t *verts, int nverts)
+{
+	const GLsizei stride = (GLsizei)sizeof(es2Vert_t);
+
+	glBindBuffer(GL_ARRAY_BUFFER, s_vbo);
+	glBufferData(GL_ARRAY_BUFFER, (long)nverts * (long)stride, verts, GL_STREAM_DRAW);
+	if (s_aPos >= 0)
+	{
+		glEnableVertexAttribArray((GLuint)s_aPos);
+		glVertexAttribPointer((GLuint)s_aPos, 3, GL_FLOAT, GL_FALSE, stride, (const void *)0);
+	}
+	if (s_aUv >= 0)
+	{
+		glEnableVertexAttribArray((GLuint)s_aUv);
+		glVertexAttribPointer((GLuint)s_aUv, 2, GL_FLOAT, GL_FALSE, stride, (const void *)(sizeof(float) * 3));
+	}
+	if (s_aColor >= 0)
+	{
+		glEnableVertexAttribArray((GLuint)s_aColor);
+		glVertexAttribPointer((GLuint)s_aColor, 4, GL_UNSIGNED_BYTE, GL_TRUE, stride, (const void *)(sizeof(float) * 5));
+	}
+}
+
+void R_ES2_DrawQuad(const float *xyz12, const float *uv8, const byte *rgba)
+{
+	float     mvp[16];
+	es2Vert_t v[4];
+	int       i;
+
+	CurrentMvp(mvp);
+	BindProgram(mvp);
+	if (!s_ready)
+	{
+		return;
+	}
+	if (s_uAlphaTest >= 0)
+	{
+		/* Direct HUD/overlay quads do not pass through the generic stage
+		 * iterator. Discard their fully transparent texels so an overlay's
+		 * transparent backing never becomes an opaque black rectangle. */
+		glUniform1i(s_uAlphaTest, 4);
+	}
+	for (i = 0; i < 4; i++)
+	{
+		v[i].x = xyz12[i * 3 + 0];
+		v[i].y = xyz12[i * 3 + 1];
+		v[i].z = xyz12[i * 3 + 2];
+		v[i].u = uv8[i * 2 + 0];
+		v[i].v = uv8[i * 2 + 1];
+		v[i].r = rgba ? rgba[0] : 255;
+		v[i].g = rgba ? rgba[1] : 255;
+		v[i].b = rgba ? rgba[2] : 255;
+		v[i].a = rgba ? rgba[3] : 255;
+	}
+	if (backEnd.projection2D)
+	{
+		glDisable(GL_DEPTH_TEST);
+	}
+	BindPacked(v, 4);
+	glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
+	glDrawArrays(GL_TRIANGLE_FAN, 0, 4);
+}
+
+void R_ES2_DrawTess(int numIndexes, const glIndex_t *indexes)
+{
+	static es2Vert_t packed[2046];
+	float            mvp[16];
+	int              i, out, packedCap;
+	unsigned         id0, id1, id2;
+
+	if (numIndexes < 3 || tess.numVertexes < 3 || !indexes)
+	{
+		return;
+	}
+
+	CurrentMvp(mvp);
+	BindProgram(mvp);
+	if (!s_ready)
+	{
+		return;
+	}
+
+	ES2_ApplyDepth();
+
+	packedCap = (int)(sizeof(packed) / sizeof(packed[0]));
+	i         = 0;
+	while (i + 2 < numIndexes)
+	{
+		out = 0;
+		while (i + 2 < numIndexes && out + 3 <= packedCap)
+		{
+			id0 = indexes[i];
+			id1 = indexes[i + 1];
+			id2 = indexes[i + 2];
+			i  += 3;
+			if (id0 >= (unsigned)tess.numVertexes
+			    || id1 >= (unsigned)tess.numVertexes
+			    || id2 >= (unsigned)tess.numVertexes)
+			{
+				continue;
+			}
+			packed[out].x = tess.xyz[id0][0];
+			packed[out].y = tess.xyz[id0][1];
+			packed[out].z = tess.xyz[id0][2];
+			packed[out].u = tess.svars.texcoords[0][id0][0];
+			packed[out].v = tess.svars.texcoords[0][id0][1];
+			packed[out].r = tess.svars.colors[id0][0];
+			packed[out].g = tess.svars.colors[id0][1];
+			packed[out].b = tess.svars.colors[id0][2];
+			packed[out].a = tess.svars.colors[id0][3];
+			out++;
+			packed[out].x = tess.xyz[id1][0];
+			packed[out].y = tess.xyz[id1][1];
+			packed[out].z = tess.xyz[id1][2];
+			packed[out].u = tess.svars.texcoords[0][id1][0];
+			packed[out].v = tess.svars.texcoords[0][id1][1];
+			packed[out].r = tess.svars.colors[id1][0];
+			packed[out].g = tess.svars.colors[id1][1];
+			packed[out].b = tess.svars.colors[id1][2];
+			packed[out].a = tess.svars.colors[id1][3];
+			out++;
+			packed[out].x = tess.xyz[id2][0];
+			packed[out].y = tess.xyz[id2][1];
+			packed[out].z = tess.xyz[id2][2];
+			packed[out].u = tess.svars.texcoords[0][id2][0];
+			packed[out].v = tess.svars.texcoords[0][id2][1];
+			packed[out].r = tess.svars.colors[id2][0];
+			packed[out].g = tess.svars.colors[id2][1];
+			packed[out].b = tess.svars.colors[id2][2];
+			packed[out].a = tess.svars.colors[id2][3];
+			out++;
+		}
+		if (out < 3)
+		{
+			break;
+		}
+		BindPacked(packed, out);
+		glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
+		glDrawArrays(GL_TRIANGLES, 0, out);
+		s_submits++;
+	}
+
+	if (s_logn < 8)
+	{
+		ri.Printf(PRINT_DEVELOPER, "ES2 tess draw idxs=%d verts=%d shader=%s org=%.0f %.0f %.0f surfs=%d\n",
+		          numIndexes, tess.numVertexes,
+		          tess.shader ? tess.shader->name : "?",
+		          backEnd.viewParms.orientation.origin[0],
+		          backEnd.viewParms.orientation.origin[1],
+		          backEnd.viewParms.orientation.origin[2],
+		          tr.refdef.numDrawSurfs);
+		s_logn++;
+	}
+}
+
+void R_ES2_DrawTessLightmap(int numIndexes, const glIndex_t *indexes, int addNotModulate)
+{
+	static es2LmVert_t packed[1536];
+	float              mvp[16];
+	int                i, out, packedCap;
+	unsigned           id0, id1, id2;
+	const GLsizei      stride = (GLsizei)sizeof(es2LmVert_t);
+
+	if (numIndexes < 3 || tess.numVertexes < 3 || !indexes)
+	{
+		return;
+	}
+
+	R_ES2_Init();
+	if (!s_lmReady)
+	{
+		R_ES2_DrawTess(numIndexes, indexes);
+		return;
+	}
+
+	CurrentMvp(mvp);
+	glUseProgram(s_lmProg);
+	glUniformMatrix4fv(s_lmUMvp, 1, GL_FALSE, mvp);
+	if (s_lmUTex0 >= 0)
+	{
+		glUniform1i(s_lmUTex0, 0);
+	}
+	if (s_lmUTex1 >= 0)
+	{
+		glUniform1i(s_lmUTex1, 1);
+	}
+	if (s_lmUAdd >= 0)
+	{
+		glUniform1f(s_lmUAdd, addNotModulate ? 1.f : 0.f);
+	}
+	if (s_lmUAlphaTest >= 0)
+	{
+		glUniform1i(s_lmUAlphaTest, CurrentAlphaTest());
+	}
+
+	ES2_ApplyDepth();
+
+	packedCap = (int)(sizeof(packed) / sizeof(packed[0]));
+	i         = 0;
+	while (i + 2 < numIndexes)
+	{
+		out = 0;
+		while (i + 2 < numIndexes && out + 3 <= packedCap)
+		{
+			id0 = indexes[i];
+			id1 = indexes[i + 1];
+			id2 = indexes[i + 2];
+			i  += 3;
+			if (id0 >= (unsigned)tess.numVertexes
+			    || id1 >= (unsigned)tess.numVertexes
+			    || id2 >= (unsigned)tess.numVertexes)
+			{
+				continue;
+			}
+			packed[out].x  = tess.xyz[id0][0];
+			packed[out].y  = tess.xyz[id0][1];
+			packed[out].z  = tess.xyz[id0][2];
+			packed[out].u0 = tess.svars.texcoords[0][id0][0];
+			packed[out].v0 = tess.svars.texcoords[0][id0][1];
+			packed[out].u1 = tess.svars.texcoords[1][id0][0];
+			packed[out].v1 = tess.svars.texcoords[1][id0][1];
+			packed[out].r  = tess.svars.colors[id0][0];
+			packed[out].g  = tess.svars.colors[id0][1];
+			packed[out].b  = tess.svars.colors[id0][2];
+			packed[out].a  = tess.svars.colors[id0][3];
+			out++;
+			packed[out].x  = tess.xyz[id1][0];
+			packed[out].y  = tess.xyz[id1][1];
+			packed[out].z  = tess.xyz[id1][2];
+			packed[out].u0 = tess.svars.texcoords[0][id1][0];
+			packed[out].v0 = tess.svars.texcoords[0][id1][1];
+			packed[out].u1 = tess.svars.texcoords[1][id1][0];
+			packed[out].v1 = tess.svars.texcoords[1][id1][1];
+			packed[out].r  = tess.svars.colors[id1][0];
+			packed[out].g  = tess.svars.colors[id1][1];
+			packed[out].b  = tess.svars.colors[id1][2];
+			packed[out].a  = tess.svars.colors[id1][3];
+			out++;
+			packed[out].x  = tess.xyz[id2][0];
+			packed[out].y  = tess.xyz[id2][1];
+			packed[out].z  = tess.xyz[id2][2];
+			packed[out].u0 = tess.svars.texcoords[0][id2][0];
+			packed[out].v0 = tess.svars.texcoords[0][id2][1];
+			packed[out].u1 = tess.svars.texcoords[1][id2][0];
+			packed[out].v1 = tess.svars.texcoords[1][id2][1];
+			packed[out].r  = tess.svars.colors[id2][0];
+			packed[out].g  = tess.svars.colors[id2][1];
+			packed[out].b  = tess.svars.colors[id2][2];
+			packed[out].a  = tess.svars.colors[id2][3];
+			out++;
+		}
+		if (out < 3)
+		{
+			break;
+		}
+		glBindBuffer(GL_ARRAY_BUFFER, s_vbo);
+		glBufferData(GL_ARRAY_BUFFER, (long)out * (long)stride, packed, GL_STREAM_DRAW);
+		if (s_lmAPos >= 0)
+		{
+			glEnableVertexAttribArray((GLuint)s_lmAPos);
+			glVertexAttribPointer((GLuint)s_lmAPos, 3, GL_FLOAT, GL_FALSE, stride, (const void *)0);
+		}
+		if (s_lmAUv0 >= 0)
+		{
+			glEnableVertexAttribArray((GLuint)s_lmAUv0);
+			glVertexAttribPointer((GLuint)s_lmAUv0, 2, GL_FLOAT, GL_FALSE, stride, (const void *)(sizeof(float) * 3));
+		}
+		if (s_lmAUv1 >= 0)
+		{
+			glEnableVertexAttribArray((GLuint)s_lmAUv1);
+			glVertexAttribPointer((GLuint)s_lmAUv1, 2, GL_FLOAT, GL_FALSE, stride, (const void *)(sizeof(float) * 5));
+		}
+		if (s_lmAColor >= 0)
+		{
+			glEnableVertexAttribArray((GLuint)s_lmAColor);
+			glVertexAttribPointer((GLuint)s_lmAColor, 4, GL_UNSIGNED_BYTE, GL_TRUE, stride, (const void *)(sizeof(float) * 7));
+		}
+		glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
+		glDrawArrays(GL_TRIANGLES, 0, out);
+		s_submits++;
+	}
+
+	if (s_lmAUv1 >= 0)
+	{
+		glDisableVertexAttribArray((GLuint)s_lmAUv1);
+	}
+
+	if (s_lmLogn < 8)
+	{
+		ri.Printf(PRINT_DEVELOPER, "ES2 lightmap draw idxs=%d verts=%d shader=%s add=%d\n",
+		          numIndexes, tess.numVertexes,
+		          tess.shader ? tess.shader->name : "?",
+		          addNotModulate);
+		s_lmLogn++;
+	}
+}
+
+void R_ES2_DrawSafeWorld(drawSurf_t *drawSurfs, int numDrawSurfs)
+{
+	(void)drawSurfs;
+	(void)numDrawSurfs;
+}
