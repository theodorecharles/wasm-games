+/**
+ * @brief ETJS second jump while airborne.
+ *
+ * The release requirement keeps a held space bar from spending both jumps in
+ * adjacent prediction frames.  doubleJumped is reset only after ground trace
+ * confirms a landing, so client prediction and the server make the same call.
+ */
+static qboolean PM_CheckDoubleJump(void)
+{
+	if (pml.walking || pm->ps->groundEntityNum != ENTITYNUM_NONE || pm->waterlevel > 1 || pml.ladder)
+	{
+		return qfalse;
+	}
+
+	if (pm->pmext->doubleJumped || pm->ps->jumpTime <= 0 ||
+	    pm->cmd.serverTime - pm->ps->jumpTime < PM_DOUBLE_JUMP_DELAY)
+	{
+		return qfalse;
+	}
+
+	if (pm->cmd.upmove < 10 || (pm->ps->pm_flags & PMF_JUMP_HELD) ||
+	    (pm->ps->eFlags & (EF_PRONE | EF_MOUNTEDTANK)))
+	{
+		return qfalse;
+	}
+
+	pm->pmext->doubleJumped = qtrue;
+	pm->ps->pm_flags       |= PMF_JUMP_HELD;
+	/* A reset to ordinary JUMP_VELOCITY barely changes anything while the
+	 * first jump is still rising. Preserve that momentum and add a bounded
+	 * second impulse so the extra press feels like an actual double jump. */
+	pm->ps->velocity[2] = MIN(MAX(pm->ps->velocity[2], 0.f) + PM_DOUBLE_JUMP_IMPULSE,
+	                          PM_DOUBLE_JUMP_MAX_VELOCITY);
+	pm->ps->jumpTime        = pm->cmd.serverTime;
+	PM_PlayJumpAnim();
+	return qtrue;
+}
