+	ETJS_Fill640(0, 0, 640, 480, 0.04f, 0.04f, 0.04f, 1.f);
+	if (etjsLogoEt)
+	{
+		ETJS_Pic640(220, 40, 200, 200, etjsLogoEt);
+	}
