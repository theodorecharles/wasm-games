+	CG_Trace(&trace, cg.refdef.vieworg, NULL, NULL, ent->origin,
+	         cg.snap->ps.clientNum, CONTENTS_SOLID);
+	visible = trace.fraction > 0.98f || trace.entityNum == cent->currentState.number;
