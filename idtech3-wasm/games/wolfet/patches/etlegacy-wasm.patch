+static void ETJS_DrawStartupMenu(void)
+{
+	float scale = cls.glconfig.vidHeight / 480.f;
+	float xoff  = (cls.glconfig.vidWidth - 640.f * scale) * 0.5f;
+	float tx, ty;
+
+	if (!etjsLogoEt)
+	{
