diff --git a/cmake/ETLEmscripten.cmake b/cmake/ETLEmscripten.cmake
new file mode 100644
index 000000000..e88220e14
--- /dev/null
+++ b/cmake/ETLEmscripten.cmake
@@ -0,0 +1,155 @@
+# ETJS: Emscripten / WebAssembly client
+# Forced after option() so a normal native build is unchanged.
+
+if(NOT EMSCRIPTEN)
+	return()
+endif()
+
+message(STATUS "ETJS: configuring Emscripten browser client")
+
+# ETJS exports application symbols at the final link. CMake's compiler-flag
+# probes build tiny programs that do not define those symbols, so keep every
+# try_compile check compile-only instead of inheriting the browser link flags.
+set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
+
+set(CROSS_COMPILE32 OFF CACHE BOOL "No -m32 on wasm32" FORCE)
+set(ENABLE_MULTI_BUILD OFF CACHE BOOL "" FORCE)
+
+set(BUILD_SERVER OFF CACHE BOOL "" FORCE)
+set(BUILD_CLIENT ON CACHE BOOL "" FORCE)
+set(BUILD_MOD ON CACHE BOOL "" FORCE)
+set(BUILD_CLIENT_MOD ON CACHE BOOL "" FORCE)
+set(BUILD_SERVER_MOD OFF CACHE BOOL "" FORCE)
+set(BUILD_MOD_PK3 OFF CACHE BOOL "" FORCE)
+
+set(BUNDLED_LIBS OFF CACHE BOOL "" FORCE)
+set(BUNDLED_SDL OFF CACHE BOOL "" FORCE)
+set(BUNDLED_ZLIB OFF CACHE BOOL "" FORCE)
+set(BUNDLED_MINIZIP OFF CACHE BOOL "" FORCE)
+set(BUNDLED_JPEG OFF CACHE BOOL "" FORCE)
+set(BUNDLED_GLEW OFF CACHE BOOL "" FORCE)
+set(BUNDLED_CURL OFF CACHE BOOL "" FORCE)
+set(BUNDLED_OPENSSL OFF CACHE BOOL "" FORCE)
+set(BUNDLED_WOLFSSL OFF CACHE BOOL "" FORCE)
+set(BUNDLED_LUA OFF CACHE BOOL "" FORCE)
+set(BUNDLED_OGG_VORBIS OFF CACHE BOOL "" FORCE)
+set(BUNDLED_THEORA OFF CACHE BOOL "" FORCE)
+set(BUNDLED_OPENAL OFF CACHE BOOL "" FORCE)
+set(BUNDLED_FREETYPE OFF CACHE BOOL "" FORCE)
+set(BUNDLED_PNG OFF CACHE BOOL "" FORCE)
+set(BUNDLED_SQLITE3 OFF CACHE BOOL "" FORCE)
+set(BUNDLED_CJSON OFF CACHE BOOL "" FORCE)
+
+# rendererGLES is GLES1 FFP (matrix stack + missing eglport.c) and cannot
+# drop LEGACY_GL_EMULATION. Keep renderer1 and submit through the GLES2
+# tessellator (FULL_ES2, no LEGACY_GL_EMULATION).
+set(FEATURE_RENDERER1 ON CACHE BOOL "" FORCE)
+set(FEATURE_RENDERER2 OFF CACHE BOOL "" FORCE)
+set(FEATURE_RENDERER_GLES OFF CACHE BOOL "" FORCE)
+set(FEATURE_RENDERER_VULKAN OFF CACHE BOOL "" FORCE)
+set(RENDERER_DYNAMIC OFF CACHE BOOL "" FORCE)
+
+set(FEATURE_CURL OFF CACHE BOOL "" FORCE)
+set(FEATURE_SSL OFF CACHE BOOL "" FORCE)
+set(FEATURE_OGG_VORBIS OFF CACHE BOOL "" FORCE)
+set(FEATURE_THEORA OFF CACHE BOOL "" FORCE)
+set(FEATURE_OPENAL OFF CACHE BOOL "" FORCE)
+set(FEATURE_FREETYPE OFF CACHE BOOL "" FORCE)
+set(FEATURE_PNG OFF CACHE BOOL "" FORCE)
+set(FEATURE_TRACKER OFF CACHE BOOL "" FORCE)
+set(FEATURE_AUTOUPDATE OFF CACHE BOOL "" FORCE)
+set(FEATURE_IPV6 OFF CACHE BOOL "" FORCE)
+set(FEATURE_IRC_CLIENT OFF CACHE BOOL "" FORCE)
+set(FEATURE_IRC_SERVER OFF CACHE BOOL "" FORCE)
+set(FEATURE_DBMS OFF CACHE BOOL "" FORCE)
+set(FEATURE_AUTH OFF CACHE BOOL "" FORCE)
+set(FEATURE_OMNIBOT OFF CACHE BOOL "" FORCE)
+set(FEATURE_LUA OFF CACHE BOOL "" FORCE)
+set(FEATURE_LUASQL OFF CACHE BOOL "" FORCE)
+set(FEATURE_RATING OFF CACHE BOOL "" FORCE)
+set(INSTALL_EXTRA OFF CACHE BOOL "" FORCE)
+set(INSTALL_OMNIBOT OFF CACHE BOOL "" FORCE)
+set(INSTALL_GEOIP OFF CACHE BOOL "" FORCE)
+set(INSTALL_WOLFADMIN OFF CACHE BOOL "" FORCE)
+
+# wasm32-unknown-emscripten contains the substring "x86"; don't treat it as desktop x86.
+set(ETL_X86 0)
+set(ARCH "wasm")
+set(BIN_SUFFIX "")
+set(LIB_SUFFIX ".mp.wasm.")
+
+set(CMAKE_EXECUTABLE_SUFFIX ".js")
+
+set(ETJS_LINK_FLAGS
+	"-sUSE_SDL=2"
+	"-sUSE_ZLIB=1"
+	"-sUSE_LIBJPEG=1"
+	"-sFULL_ES2=1"
+	"-sGL_UNSAFE_OPTS=0"
+	"-sMAX_WEBGL_VERSION=2"
+	"-sMIN_WEBGL_VERSION=2"
+	"-sALLOW_MEMORY_GROWTH=1"
+	"-sALLOW_TABLE_GROWTH=1"
+	"-sINITIAL_TABLE=4096"
+	"-sINITIAL_MEMORY=536870912"
+	"-sMAXIMUM_MEMORY=1073741824"
+	"-sSTACK_SIZE=2097152"
+	"-sGL_MAX_TEMP_BUFFER_SIZE=16777216"
+	"-sFORCE_FILESYSTEM=1"
+	"-sEXPORTED_RUNTIME_METHODS=['callMain','ccall','cwrap','FS','setCanvasSize']"
+	"-sEXPORTED_FUNCTIONS=['_main','_Cbuf_AddText','_ETJS_AddLook','_ETJS_KeyEvent','_ETJS_CharEvent','_ETJS_OpenCommunication','_Cvar_VariableIntegerValue']"
+	"-sEXIT_RUNTIME=0"
+	"-sINVOKE_RUN=0"
+	"-Wl,--allow-multiple-definition"
+	"-sENVIRONMENT=web"
+	"-sMAIN_MODULE=0"
+	"-sSOCKET_DEBUG=0"
+	"-lwebsocket.js"
+	"-lidbfs.js"
+	"-lGLEW"
+	"-lGL"
+	"--js-library" "${CMAKE_SOURCE_DIR}/../web-port/gl_arb.js"
+	"-sERROR_ON_UNDEFINED_SYMBOLS=0"
+	"-sDISABLE_EXCEPTION_CATCHING=1"
+	"-sNO_EXIT_RUNTIME=1"
+	"-sALLOW_UNIMPLEMENTED_SYSCALLS=1"
+	"-sALLOW_TABLE_GROWTH=1"
+	"-sRESERVED_FUNCTION_POINTERS=256"
+	"-Wl,--allow-multiple-definition"
+	"--profiling-funcs"
+)
+
+string(REPLACE ";" " " ETJS_LINK_FLAGS_STR "${ETJS_LINK_FLAGS}")
+set(CMAKE_C_FLAGS "-sUSE_SDL=2 -sUSE_ZLIB=1 -sUSE_LIBJPEG=1 -fno-strict-aliasing -DGL_GLEXT_PROTOTYPES=1")
+set(CMAKE_CXX_FLAGS "-sUSE_SDL=2 -sUSE_ZLIB=1 -sUSE_LIBJPEG=1")
+set(CMAKE_EXE_LINKER_FLAGS "${ETJS_LINK_FLAGS_STR}" CACHE STRING "ETJS wasm link flags" FORCE)
+
+add_definitions(-D__EMSCRIPTEN__=1)
+add_definitions(-DETLJS=1)
+add_definitions(-DNO_VM_COMPILED=1)
+add_definitions(-DFEATURE_RATING=1)
+add_definitions(-DCPUSTRING=\"emscripten-wasm\")
+
+# Vendored minizip (pk3)
+set(ETJS_MINIZIP_DIR "${CMAKE_SOURCE_DIR}/../third_party/minizip")
+if(NOT EXISTS "${ETJS_MINIZIP_DIR}/unzip.c")
+	set(ETJS_MINIZIP_DIR "${CMAKE_SOURCE_DIR}/third_party/minizip")
+endif()
+add_library(etjs_minizip STATIC
+	"${ETJS_MINIZIP_DIR}/unzip.c"
+	"${ETJS_MINIZIP_DIR}/ioapi.c"
+)
+target_include_directories(etjs_minizip PUBLIC "${ETJS_MINIZIP_DIR}")
+target_compile_definitions(etjs_minizip PUBLIC BUNDLED_MINIZIP=1 NOUNCRYPT=1 USE_FILE32API=1)
+
+# GLEW stub so renderer1 can compile against WebGL/legacy GL
+set(ETJS_WEBPORT "${CMAKE_SOURCE_DIR}/../web-port")
+if(NOT EXISTS "${ETJS_WEBPORT}/include/GL/glew.h")
+	set(ETJS_WEBPORT "${CMAKE_SOURCE_DIR}/web-port")
+endif()
+add_library(etjs_glew STATIC "${ETJS_WEBPORT}/glew_stub.c")
+target_include_directories(etjs_glew PUBLIC "${ETJS_WEBPORT}/include")
+target_compile_definitions(etjs_glew PUBLIC GLEW_STATIC=1)
+target_compile_options(etjs_glew PRIVATE -fvisibility=default)
+
+message(STATUS "ETJS minizip: ${ETJS_MINIZIP_DIR}")
+message(STATUS "ETJS webport: ${ETJS_WEBPORT}")
