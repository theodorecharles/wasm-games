#include "ui/menudef.h"
#include "ui/menumacros.h"

#define WINDOW_X		16
#define WINDOW_Y		16
#define WINDOW_WIDTH	__WINDOW_WIDTH-32
#define WINDOW_HEIGHT	448
#define MENU_WIDTH		128
#define MENU_HEIGHT		128
#define GROUP_NAME		"grpMain"

menuDef {
	name		"main_opener"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y MENU_WIDTH MENU_HEIGHT

	onOpen {
		open fadebox_black ;
		open background_1 ;
		setmenuitemcolor fadebox_black fadebox backcolor 0 0 0 1 ;
		fadeoutmenu fadebox_black ;
		open main ;
		close main_opener
	}
}

menuDef {
	name		"main"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y $evalint(WINDOW_WIDTH) WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onOpen {
		playlooped "sound/music/menu_server.wav"
	}

	onEsc {
		clearFocus ;
		open quit
	}

	itemDef {
		name		"etl_logo"
		rect		$evalint(__WINDOW_WIDTH/2-100-16) 124 200 200
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/et_logo_huge"
		visible		1
		decoration
	}

	SUBWINDOW( 0, 0, MENU_WIDTH, MENU_HEIGHT, _("WELCOME") )

	BUTTON( 6, 32, MENU_WIDTH-12, 18, _("JOIN GAME"), .3, 14, exec "etjs_joingame" )
	BUTTON( 6, 56, MENU_WIDTH-12, 18, _("MSGID_MENU_MAIN_OPTIONS"), .3, 14, close main ; open options )
	BUTTON( 6, 80, MENU_WIDTH-12, 18, _("MSGID_MENU_MAIN_QUIT"), .3, 14, clearFocus ; open quit )

	LABEL( 2, 450, 132, 10, "^y"ETLEGACY_VERSION, .2, ITEM_ALIGN_LEFT, 0, 8 )
}
