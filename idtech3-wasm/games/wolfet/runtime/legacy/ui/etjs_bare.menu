menudef {
	name "main"
	fullScreen 1
	visible 1
	rect 0 0 640 480
	style 1
	backcolor 0.2 0.15 0.1 1

	itemDef {
		name "title"
		type 1
		text "WOLFENSTEIN: ENEMY TERRITORY"
		rect 80 40 480 30
		textalign 1
		textscale 0.35
		forecolor 1 0.85 0.4 1
		visible 1
		decoration
	}

	itemDef {
		name "join"
		type 1
		text "JOIN GAME"
		rect 180 200 280 40
		textalign 1
		textscale 0.4
		forecolor 1 1 1 1
		visible 1
		action { exec "etjs_joingame" }
	}

	itemDef {
		name "namelabel"
		type 0
		text "Player name:"
		rect 180 150 280 20
		textscale 0.25
		forecolor 0.8 0.75 0.6 1
		visible 1
		decoration
	}

	itemDef {
		name "nameedit"
		type 4
		cvar "name"
		rect 180 168 280 24
		maxChars 32
		visible 1
	}
}
