#include "ui/menudef.h"
#include "ui/menumacros.h"

#define WINDOW_X      16
#define WINDOW_Y      16
#define WINDOW_WIDTH  128
#define WINDOW_HEIGHT 152
#define GROUP_NAME    "grpOptions"

menuDef {
	name       "options"
	visible    0
	fullscreen 0
	rect       WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style      WINDOW_STYLE_FILLED

	onEsc {
		conditionalscript etjs_ingame 0
			( "close options ; open ingame_main" )
			( "close options ; open main" )
	}

	WINDOW( _("OPTIONS"), 122 )

	BUTTON( 6, 32,  WINDOW_WIDTH-12, 18, _("MSGID_MENU_OPTION_GAME"),     .3, 14, close options ; open options_customise_game )
	BUTTON( 6, 56,  WINDOW_WIDTH-12, 18, _("MSGID_MENU_OPTION_VIEW"),     .3, 14, close options ; open options_customise_hud )
	BUTTON( 6, 80,  WINDOW_WIDTH-12, 18, _("MSGID_MENU_OPTION_CONTROLS"), .3, 14, close options ; open options_controls )
	BUTTON( 6, 104, WINDOW_WIDTH-12, 18, _("MSGID_MENU_OPTION_SYSTEM"),   .3, 14, close options ; open options_system )
	BUTTON( 6, 128, WINDOW_WIDTH-12, 18, _("MSGID_MENU_BACK"),            .3, 14,
		conditionalscript etjs_ingame 0
			( "close options ; open ingame_main" )
			( "close options ; open main" ) )
}
