# Dependencies and local caches
/node_modules/
/.cache/
/tmp-etjs-shots/
/.generated/
/.env
.DS_Store

# Upstream reference workspaces. ETJS pins ET: Legacy with a patch instead.
/etlegacy/
/quakejs/

# Original game installers/assets and downloaded third-party runtime data
/*.run
/*.zip
/game-data/
/vendor/
/local-assets/
/runtime/etmain/*.pk3
/runtime/legacy/*.pk3
/web/sound/music/*
!/web/sound/music/.gitkeep

# Generated WebAssembly client
/web/client/*
!/web/client/.gitkeep

# Dedicated-server state and locally generated credentials
/runtime/.rcon-password
/runtime/.admin-bans.json
/runtime/.last-start-map
/custom_maps/
/runtime/legacy/etconsole.log
/runtime/legacy/etconfig_server.cfg
/runtime/legacy/session/
/runtime/legacy/demos/
/runtime/legacy/profiles/
/runtime/legacy/screenshots/
/runtime/legacy/*.db
/runtime/legacy/*.db-*
/runtime/legacy/qagame*.so

# Native helper binaries
/tools/huffpack
/tools/q3huff
