////////// GAMETYPE //////////////////////////////////////////////////////// 

	//	SINGLEPLAYER	// 


	itemDef {
			name play
			text "GIOCATORE SINGOLO"
			type 1
			style 0		
			textstyle 6
			rect 2 398 100 14 
			textalign 0
			textfont UI_FONT_NORMAL
		textscale .20		
			textalignx 7
			textaligny 10
			textfont UI_FONT_NORMAL
			forecolor 1 1 1 1
			visible 0 
	
			action { }
	}




	itemDef {
			name loadgame
			text "CARICA PARTITA"
			type 1
			style 0	
			textstyle 6
			rect 70 396 72 14 
			textalign 0
			textfont UI_FONT_NORMAL
		textscale .20		
			textalignx 0
			textaligny 14
			textfont UI_FONT_NORMAL
			forecolor .9 .9 .9 .9
			visible 0
			mouseEnter { fadein message_accept }
			action {close main ; open load_menu ; play "sound/misc/zap.wav"; }
    	}
	





//	OPTIONS		// 


itemDef {
		name options
		text "OPZIONI"		
		type 1
		style 0	
		textstyle 6
		rect 426 398 56 14 
		textalign 0
		textfont UI_FONT_NORMAL
	textscale .20		
		textalignx 2
		textaligny 10
		textfont UI_FONT_NORMAL
		forecolor .9 .9 .9 1
		visible 1 
		mouseEnter {fadein message_accept }
		action {play "sound/misc/zap.wav" ; 
		close main ; 
		open setup_menu ;
		open control_menu
		} 
    }





itemDef {
      	name playselection
      	text "JOIN GAME"
		type 1
		style 0	
		textstyle 6
		rect 3 396 210 18
		textalign 1
		textfont UI_FONT_NORMAL
	textscale .255
		textalignx 105
		textaligny 12
		textfont UI_FONT_NORMAL
		forecolor .9 .9 .9 1
		visible 1
		mouseEnter { setcvar ui_wasmJoinTarget 1 }
		mouseExit { setcvar ui_wasmJoinTarget 0 }
		action {
play "sound/misc/zap.wav" ;
setcvar ui_wasmJoinRequested 1 ;
setcvar ui_wasmJoinTarget 1
}
    }
   



itemDef {
	name message_disable
	group grpmessage
	style 0 
	rect 320 430 128 30
	textalign 1
	textstyle 1
	textalignx 0
	textaligny 25
	textscale .35
	text "multiplayer attualmente disattivato"
	forecolor .9 .9 .9 .5
	decoration 
	visible 0
	}




