+// Current Xash defaults use dedicated commands. Retain the older command
+// spelling for installations with custom/legacy bindings; never change binds
+// merely to display a hint.
+static int UI_QuickSaveHintKey( const char *current, const char *legacy )
+{
+	const int key = KEY_GetKey( current );
+	return key >= 0 ? key : KEY_GetKey( legacy );
+}
