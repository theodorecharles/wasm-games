diff --git a/engine/common/host.c b/engine/common/host.c
--- a/engine/common/host.c
+++ b/engine/common/host.c
@@ -874,6 +874,15 @@ void GAME_EXPORT Host_Error( const char *error, ... )
 	Mod_FreeAll();
 
 	recursive = false;
+#if XASH_DEDICATED
+	// A managed web host cannot leave its bridge alive with no native match.
+	// Finish normal cleanup, then let its supervisor restart the whole host.
+	if( Sys_CheckParm( "-exit-on-host-error" ))
+	{
+		error_on_exit = 1;
+		Sys_Quit( "managed dedicated host error" );
+	}
+#endif
 	Host_AbortCurrentFrame();
 }
 
