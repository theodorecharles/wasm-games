 void CL_Quit_f( void )
 {
+#if XASH_EMSCRIPTEN
+	// The browser tab is the process; there is nothing to quit into.
+	// Swallow quit/exit so menu and console paths stay inert.
+	Con_Printf( "Close the browser tab to quit the game.\n" );
+#else
 	CL_Disconnect();
 	Sys_Quit( "command" );
+#endif
 }
 
