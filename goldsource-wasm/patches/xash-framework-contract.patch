 static struct inputstate_s
 {
 	float lastpitch, lastyaw;
@@ -215,6 +226,16 @@ void IN_SetRelativeMouseMode( qboolean set )
 
 	if( set && !s_bRawInput )
 	{
+#if XASH_EMSCRIPTEN
+		EmscriptenPointerlockChangeEvent status;
+
+		/* The framework is the only pointer-lock owner. Native relative mode
+		 * follows its explicit capture signal and the browser's current state. */
+		if( !wasm_game_input_captured ||
+			emscripten_get_pointerlock_status( &status ) != EMSCRIPTEN_RESULT_SUCCESS ||
+			!status.isActive )
+			return;
+#endif
 #if XASH_SDL >= 2
 		SDL_GetRelativeMouseState( NULL, NULL );
 #if XASH_SDL == 2
@@ -244,6 +265,61 @@ void IN_SetRelativeMouseMode( qboolean set )
 	}
 }
 
+#if XASH_EMSCRIPTEN
+EMSCRIPTEN_KEEPALIVE void WasmGame_SetInputCaptured( int captured );
+EMSCRIPTEN_KEEPALIVE void WasmGame_PointerMove( int x, int y );
+EMSCRIPTEN_KEEPALIVE void WasmGame_ControllerAction( int action, int pressed );
+
+EMSCRIPTEN_KEEPALIVE void WasmGame_SetInputCaptured( int captured )
+{
+	wasm_game_input_captured = captured ? true : false;
+	IN_SetRelativeMouseMode( wasm_game_input_captured );
+}
+
+EMSCRIPTEN_KEEPALIVE void WasmGame_PointerMove( int x, int y )
+{
+	wasm_game_pointer_x = x;
+	wasm_game_pointer_y = y;
+	wasm_game_pointer_valid = true;
+}
+
+static int WasmGame_ControllerKeyForAction( int action )
+{
+	switch( action )
+	{
+	case 0: return 'w';
+	case 1: return 's';
+	case 2: return 'a';
+	case 3: return 'd';
+	case 4: return K_MOUSE1;
+	case 5: return K_MOUSE2;
+	case 6: return K_SPACE;
+	case 7: return K_CTRL;
+	case 8: return 'r';
+	case 9: return 'e';
+	case 10: return K_MWHEELDOWN;
+	case 11: return K_MWHEELUP;
+	case 12: return K_TAB;
+	case 13: return K_ESCAPE;
+	case 14: return K_SHIFT;
+	case 15: return 'f';
+	case 16: return K_ENTER;
+	case 17: return K_UPARROW;
+	case 18: return K_DOWNARROW;
+	case 19: return K_LEFTARROW;
+	case 20: return K_RIGHTARROW;
+	default: return 0;
+	}
+}
+
+EMSCRIPTEN_KEEPALIVE void WasmGame_ControllerAction( int action, int pressed )
+{
+	int key = WasmGame_ControllerKeyForAction( action );
+	if( key )
+		Key_Event( key, pressed ? true : false );
+}
+#endif
+
 void IN_SetMouseGrab( qboolean set )
 {
 	static qboolean s_bMouseGrab;
@@ -352,7 +428,17 @@ static void IN_MouseMove( void )
-	Platform_GetMousePos( &x, &y );
-
-	VGui_MouseMove( x, y );
-
-	// if the menu is visible, move the menu cursor
-	UI_MouseMove( x, y );
+	Platform_GetMousePos( &x, &y );
+#if XASH_EMSCRIPTEN
+	/* The framework maps browser coordinates into the current native
+	 * backbuffer. SDL's browser-side absolute coordinates can otherwise lag
+	 * or use a different CSS scale after a dynamic resize. */
+	if( wasm_game_pointer_valid && !wasm_game_input_captured )
+	{
+		x = bound( 0, wasm_game_pointer_x, refState.width - 1 );
+		y = bound( 0, wasm_game_pointer_y, refState.height - 1 );
+	}
+#endif
+
+	VGui_MouseMove( x, y );
+
+	// if the menu is visible, move the menu cursor
+	UI_MouseMove( x, y );
 }
