+
 #define MAX_CMD_BUFFER        8000
 #define CL_CONNECTION_TIMEOUT 15.0f
 #define CL_CONNECTION_RETRIES 5
@@ -104,6 +108,74 @@ client_t		cl;
 client_static_t	cls;
 clgame_static_t	clgame;
 
+#if XASH_EMSCRIPTEN
+int WasmGame_RuntimeState( void );
+int WasmGame_CaptureIntent( void );
+int WasmGame_PlayerNameStatus( const char *expected );
+
+/* Browser-framework state contract. Keep this seam synchronous and derived
+ * only from authoritative client/menu/load state. */
+EMSCRIPTEN_KEEPALIVE int WasmGame_RuntimeState( void )
+{
+	if( !cls.initialized )
+		return 0; /* menu */
+
+	if( cls.key_dest == key_console || cls.key_dest == key_message )
+		return 0; /* menu */
+
+	if( cls.state == ca_cinematic || cl.intermission )
+		return 3; /* debrief */
+
+	if( cls.key_dest == key_menu || UI_IsVisible( ))
+		return cls.state == ca_active && !cl.background ? 2 : 0; /* paused/menu */
+
+	if( cl.paused )
+		return 2; /* paused */
+
+	if( cls.key_dest == key_game && !cl.background &&
+		( cls.state == ca_connecting || cls.state == ca_connected ||
+		  cls.state == ca_validate || cls.disable_screen ||
+		  GameState->curstate != STATE_RUNFRAME ||
+		  GameState->nextstate != STATE_RUNFRAME ))
+		return 4; /* loading */
+
+	if( cls.state == ca_active && cls.key_dest == key_game &&
+		cl.validsequence && Key_IsDown( K_TAB ))
+		return 3; /* scoreboard */
+
+	if( cls.state == ca_active && cls.key_dest == key_game &&
+		!cl.background && cl.validsequence && !cl.first_frame )
+		return 1; /* gameplay */
+
+	return cls.key_dest == key_game && !cl.background ? 4 : 0; /* loading/menu */
+}
+
+EMSCRIPTEN_KEEPALIVE int WasmGame_CaptureIntent( void )
+{
+	return WasmGame_RuntimeState() == 4;
+}
+
+/* 0: mismatch, 1: pending/local userinfo matches, 2: the active server's
+ * scoreboard entry for this client matches. */
+EMSCRIPTEN_KEEPALIVE int WasmGame_PlayerNameStatus( const char *expected )
+{
+	const char *local;
+
+	if( !COM_CheckString( expected ))
+		return 0;
+
+	local = Info_ValueForKey( cls.userinfo, "name" );
+	if( Q_stricmp( local, expected ))
+		return 0;
+
+	if( cls.state == ca_active && cl.playernum >= 0 && cl.playernum < MAX_CLIENTS &&
+		COM_CheckString( cl.players[cl.playernum].name ))
+		return Q_stricmp( cl.players[cl.playernum].name, expected ) ? 0 : 2;
+
+	return 1;
+}
+#endif
+
