 void*		in_mousecursor;
 qboolean	in_mouseactive;				// false when not focus app
 qboolean	in_mouseinitialized;
@@ -33,6 +38,12 @@ qboolean	in_mouse_suspended;
 POINT		in_lastvalidpos;
 qboolean	in_mouse_savedpos;
 static int in_mstate = 0;
+#if XASH_EMSCRIPTEN
+static qboolean wasm_game_input_captured;
+static qboolean wasm_game_pointer_valid;
+static int wasm_game_pointer_x;
+static int wasm_game_pointer_y;
