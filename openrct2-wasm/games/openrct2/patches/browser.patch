index 0000000000000000000000000000000000000000..f262d63271f49dff7fdc9cd3859deb139d83c528
--- /dev/null
+++ b/src/openrct2-ui/WasmGameFramework.cpp
@@ -0,0 +1,224 @@
+/*****************************************************************************
+ * Copyright (c) 2014-2026 OpenRCT2 developers
+ *
+ * For a complete list of all authors, please refer to contributors.md
+ * Interested in contributing? Visit https://github.com/OpenRCT2/OpenRCT2
+ *
+ * OpenRCT2 is licensed under the GNU General Public License version 3.
+ *****************************************************************************/
+
+#ifdef __EMSCRIPTEN__
+
+    #include <SDL.h>
+    #include <algorithm>
+    #include <cmath>
+    #include <emscripten.h>
+    #include <emscripten/html5.h>
+    #include <openrct2/Context.h>
+    #include <openrct2/Game.h>
+    #include <openrct2/OpenRCT2.h>
+    #include <openrct2/config/Config.h>
+    #include <openrct2/drawing/IDrawingEngine.h>
+    #include <openrct2/drawing/RenderTarget.h>
+    #include <openrct2/scenes/SceneManager.h>
+    #include <openrct2/ui/UiContext.h>
+    #include <openrct2-ui/input/MouseInput.h>
+
+namespace
+{
+    double _pointerX = 0;
+    double _pointerY = 0;
+
+    void ClampPointer()
+    {
+        // The runtime owns an OffscreenCanvas in a dedicated worker, so DOM
+        // selector APIs cannot resolve #canvas and report 0x0. Clamp against
+        // OpenRCT2's authoritative native viewport instead.
+        const int32_t width = std::max(1, OpenRCT2::ContextGetWidth());
+        const int32_t height = std::max(1, OpenRCT2::ContextGetHeight());
+        _pointerX = std::clamp(_pointerX, 0.0, static_cast<double>(width - 1));
+        _pointerY = std::clamp(_pointerY, 0.0, static_cast<double>(height - 1));
+    }
+} // namespace
+
+extern "C" {
+
+int32_t OpenRCT2Wasm_RuntimeState();
+uint32_t OpenRCT2Wasm_DrawCount();
+uint32_t OpenRCT2Wasm_FramebufferVariation();
+int32_t OpenRCT2Wasm_CursorX();
+int32_t OpenRCT2Wasm_CursorY();
+int32_t OpenRCT2Wasm_ContextWidth();
+int32_t OpenRCT2Wasm_ContextHeight();
+double OpenRCT2Wasm_WindowScale();
+void OpenRCT2Wasm_Resize(int32_t width, int32_t height);
+void OpenRCT2Wasm_PointerMove(double x, double y);
+void OpenRCT2Wasm_PointerButton(int32_t button, int32_t pressed, double x, double y);
+void OpenRCT2Wasm_PointerWheel(double deltaX, double deltaY);
+void OpenRCT2Wasm_Key(int32_t scancode, int32_t pressed, int32_t modifiers);
+void OpenRCT2Wasm_TextInput(const char* text);
+
+EMSCRIPTEN_KEEPALIVE int32_t OpenRCT2Wasm_RuntimeState()
+{
+    if (gCurrentDrawCount == 0)
+        return 0;
+    if (auto* context = OpenRCT2::GetContext(); context != nullptr)
+    {
+        if (auto* scenes = context->GetSceneManager(); scenes != nullptr)
+        {
+            auto* active = scenes->getActiveScene();
+            if (active == scenes->getPreloaderScene() || active == scenes->getIntroScene())
+                return 0;
+        }
+    }
+    if (gLegacyScene == LegacyScene::titleSequence)
+        return 1;
+    if (gLegacyScene == LegacyScene::playing && GameIsPaused())
+        return 3;
+    return 2;
+}
+
+EMSCRIPTEN_KEEPALIVE uint32_t OpenRCT2Wasm_DrawCount()
+{
+    return gCurrentDrawCount;
+}
+
+EMSCRIPTEN_KEEPALIVE uint32_t OpenRCT2Wasm_FramebufferVariation()
+{
+    auto* context = OpenRCT2::GetContext();
+    auto* engine = context == nullptr ? nullptr : context->GetDrawingEngine();
+    auto* target = engine == nullptr ? nullptr : engine->getRT();
+    if (target == nullptr || target->bits == nullptr || target->width <= 0 || target->height <= 0)
+        return 0;
+
+    const auto first = target->bits[0];
+    const uint64_t pixels = static_cast<uint64_t>(target->width) * target->height;
+    const uint64_t samples = std::min<uint64_t>(pixels, 4096);
+    uint32_t different = 0;
+    for (uint64_t i = 0; i < samples; i++)
+    {
+        const uint64_t linear = (i * pixels) / samples;
+        const auto y = static_cast<int32_t>(linear / target->width);
+        const auto x = static_cast<int32_t>(linear % target->width);
+        if (target->bits[y * target->LineStride() + x] != first)
+            different++;
+    }
+    return different;
+}
+
+EMSCRIPTEN_KEEPALIVE int32_t OpenRCT2Wasm_CursorX()
+{
+    return OpenRCT2::ContextGetCursorPosition().x;
+}
+
+EMSCRIPTEN_KEEPALIVE int32_t OpenRCT2Wasm_CursorY()
+{
+    return OpenRCT2::ContextGetCursorPosition().y;
+}
+
+EMSCRIPTEN_KEEPALIVE int32_t OpenRCT2Wasm_ContextWidth()
+{
+    return OpenRCT2::ContextGetWidth();
+}
+
+EMSCRIPTEN_KEEPALIVE int32_t OpenRCT2Wasm_ContextHeight()
+{
+    return OpenRCT2::ContextGetHeight();
+}
+
+EMSCRIPTEN_KEEPALIVE double OpenRCT2Wasm_WindowScale()
+{
+    return OpenRCT2::Config::Get().general.windowScale;
+}
+
+EMSCRIPTEN_KEEPALIVE void OpenRCT2Wasm_Resize(int32_t width, int32_t height)
+{
+    if (width < 1 || height < 1)
+        return;
+
+    _pointerX = width / 2.0;
+    _pointerY = height / 2.0;
+
+    SDL_Event event{};
+    event.type = SDL_WINDOWEVENT;
+    event.window.event = SDL_WINDOWEVENT_RESIZED;
+    event.window.data1 = width;
+    event.window.data2 = height;
+    SDL_PushEvent(&event);
+}
+
+EMSCRIPTEN_KEEPALIVE void OpenRCT2Wasm_PointerMove(double x, double y)
+{
+    _pointerX = std::isfinite(x) ? x : _pointerX;
+    _pointerY = std::isfinite(y) ? y : _pointerY;
+    ClampPointer();
+
+    if (auto* context = OpenRCT2::GetContext(); context != nullptr)
+    {
+        context->GetUiContext().SetCursorPosition(
+            { static_cast<int32_t>(std::lround(_pointerX)), static_cast<int32_t>(std::lround(_pointerY)) });
+    }
+
+}
+
+EMSCRIPTEN_KEEPALIVE void OpenRCT2Wasm_PointerButton(int32_t button, int32_t pressed, double x, double y)
+{
+    OpenRCT2Wasm_PointerMove(x, y);
+    const ScreenCoordsXY position = {
+        static_cast<int32_t>(std::lround(_pointerX)), static_cast<int32_t>(std::lround(_pointerY))
+    };
+
+    // The browser runtime lives in a dedicated application worker. SDL's DOM
+    // mouse bookkeeping is intentionally absent there, and queuing SDL mouse
+    // events loses the authoritative cursor/release state before OpenRCT2's
+    // input tick consumes it. Feed the engine's bounded native queue directly
+    // so hover, press, release and dragging all share the same coordinates.
+    if (button == 0)
+    {
+        OpenRCT2::StoreMouseInput(
+            pressed ? OpenRCT2::MouseState::leftPress : OpenRCT2::MouseState::leftRelease, position);
+    }
+    else if (button == 2)
+    {
+        OpenRCT2::StoreMouseInput(
+            pressed ? OpenRCT2::MouseState::rightPress : OpenRCT2::MouseState::rightRelease, position);
+    }
+}
+
+EMSCRIPTEN_KEEPALIVE void OpenRCT2Wasm_PointerWheel(double deltaX, double deltaY)
+{
+    SDL_Event event{};
+    event.type = SDL_MOUSEWHEEL;
+    event.wheel.x = static_cast<int32_t>(std::clamp(-deltaX, -3.0, 3.0));
+    event.wheel.y = static_cast<int32_t>(std::clamp(-deltaY, -3.0, 3.0));
+    SDL_PushEvent(&event);
+}
+
+EMSCRIPTEN_KEEPALIVE void OpenRCT2Wasm_Key(int32_t scancode, int32_t pressed, int32_t modifiers)
+{
+    if (scancode <= SDL_SCANCODE_UNKNOWN || scancode >= SDL_NUM_SCANCODES)
+        return;
+
+    SDL_Event event{};
+    event.type = pressed ? SDL_KEYDOWN : SDL_KEYUP;
+    event.key.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+    event.key.repeat = 0;
+    event.key.keysym.scancode = static_cast<SDL_Scancode>(scancode);
+    event.key.keysym.sym = SDL_GetKeyFromScancode(event.key.keysym.scancode);
+    event.key.keysym.mod = static_cast<SDL_Keymod>(modifiers);
+    SDL_PushEvent(&event);
+}
+
+EMSCRIPTEN_KEEPALIVE void OpenRCT2Wasm_TextInput(const char* text)
+{
+    if (text == nullptr || text[0] == '\0')
+        return;
+
+    SDL_Event event{};
+    event.type = SDL_TEXTINPUT;
+    SDL_strlcpy(event.text.text, text, sizeof(event.text.text));
+    SDL_PushEvent(&event);
+}
+}
+
+#endif
