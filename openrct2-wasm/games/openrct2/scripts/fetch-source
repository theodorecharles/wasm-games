#!/usr/bin/env bash
set -euo pipefail

game_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
engine_root="$(cd "${game_root}/../.." && pwd)"
source_dir="${OPENRCT2_SOURCE_DIR:-${engine_root}/.work/openrct2}"
repository="https://github.com/theodorecharles/openrct2-wasm.git"
commit="4a7ee146caab8888eb31e56a33c0559db89b17bd"
series_file="${game_root}/patches/series"

if [[ ! -d "${source_dir}/.git" ]]; then
  mkdir -p "$(dirname "${source_dir}")"
  git clone --filter=blob:none --no-checkout "${repository}" "${source_dir}" >&2
  git -C "${source_dir}" checkout --detach "${commit}" >&2
fi

actual_origin="$(git -C "${source_dir}" remote get-url origin)"
actual_commit="$(git -C "${source_dir}" rev-parse HEAD)"
if [[ "${actual_origin}" != "${repository}" || "${actual_commit}" != "${commit}" ]]; then
  printf 'Unexpected OpenRCT2 source checkout at %s.\n' "${source_dir}" >&2
  exit 1
fi

while IFS= read -r patch_name; do
  [[ -z "${patch_name}" || "${patch_name}" == \#* ]] && continue
  patch_file="${game_root}/patches/${patch_name}"
  if git -C "${source_dir}" apply --reverse --check "${patch_file}" 2>/dev/null; then
    continue
  fi
  git -C "${source_dir}" apply --check "${patch_file}"
  git -C "${source_dir}" apply "${patch_file}"
done < "${series_file}"

if [[ -n "$(git -C "${source_dir}" status --short --untracked-files=no | sed -n '/^[^ M]/p')" ]]; then
  printf 'OpenRCT2 checkout contains changes outside the applied patch.\n' >&2
  exit 1
fi

# Do not retain upstream Markdown in ignored build trees.
find "${source_dir}" -type f -name '*.md' -delete

printf '%s\n' "${source_dir}"
