#!/usr/bin/env bash

set -euo pipefail

readonly framework_commit="ad0226db55a2925bb250c6e31ca6786bd0dc73bd"
readonly framework_version="0.9.6"
repo_root="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)"
framework_root="${WASM_GAME_FRAMEWORK_ROOT:-/home/ted/Development/wasm/wasm-game-framework}"
site_root="$repo_root/build-framework/site"

if [[ "$(git -C "$framework_root" rev-parse HEAD)" != "$framework_commit" ]]; then
    printf 'wasm-game-framework must be pinned at %s.\n' "$framework_commit" >&2
    exit 1
fi
if [[ "$(node -p "require('$framework_root/package.json').version")" != "$framework_version" ]]; then
    printf 'wasm-game-framework package must be version %s.\n' "$framework_version" >&2
    exit 1
fi
for artifact in openrct2.js openrct2.wasm openrct2.data; do
    if [[ ! -s "$repo_root/build-framework/$artifact" ]]; then
        printf 'Missing framework runtime artifact: build-framework/%s\n' "$artifact" >&2
        exit 1
    fi
done

rm -rf -- "$site_root"
mkdir -p "$site_root/runtime"
cp -a "$repo_root/web/." "$site_root/"
install -m 0644 "$repo_root/build-framework/openrct2.js" "$site_root/runtime/openrct2.js"
install -m 0644 "$repo_root/build-framework/openrct2.wasm" "$site_root/runtime/openrct2.wasm"
install -m 0644 "$repo_root/build-framework/openrct2.data" "$site_root/runtime/openrct2.data"
install -m 0644 "$repo_root/resources/logo/icon.ico" "$site_root/openrct2.ico"
convert "$repo_root/resources/logo/icon_x512.png" -resize 192x192 \
    +set date:create +set date:modify -define png:exclude-chunks=date,time \
    "$site_root/openrct2-192.png"
install -m 0644 "$repo_root/resources/logo/icon_x512.png" "$site_root/openrct2-512.png"
"$framework_root/scripts/install-browser-package.sh" "$site_root" copy
node "$framework_root/scripts/check-game-package.js" "$site_root"

printf 'Staged OpenRCT2 framework package at %s\n' "$site_root"
