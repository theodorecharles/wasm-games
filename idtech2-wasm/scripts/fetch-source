#!/usr/bin/env bash
set -euo pipefail

engine_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repository="https://github.com/theodorecharles/idtech2-wasm.git"
variant="${1:-}"

case "${variant}" in
  quake)
    commit="0023db327bc1db00068284b70e1db45857aeee35"
    source_dir="${IDTECH2_Q1_SOURCE_DIR:-${engine_root}/.work/source/quake}"
    series_file="${engine_root}/games/quake/patches/series"
    ;;
  quake2)
    commit="69599f5a7b3c543f33a5cec34811f09a98fbeb45"
    source_dir="${IDTECH2_Q2_SOURCE_DIR:-${engine_root}/.work/source/quake2}"
    series_file="${engine_root}/games/quake2/patches/series"
    ;;
  *)
    printf 'Usage: %s quake|quake2\n' "${0##*/}" >&2
    exit 2
    ;;
esac

if [[ ! -d "${source_dir}/.git" ]]; then
  mkdir -p "$(dirname "${source_dir}")"
  git clone --filter=blob:none --no-checkout "${repository}" "${source_dir}" >&2
  git -C "${source_dir}" checkout --detach "${commit}" >&2
fi

actual_origin="$(git -C "${source_dir}" remote get-url origin)"
actual_commit="$(git -C "${source_dir}" rev-parse HEAD)"
if [[ "${actual_origin}" != "${repository}" || "${actual_commit}" != "${commit}" ]]; then
  printf 'Unexpected %s source checkout at %s.\n' "${variant}" "${source_dir}" >&2
  exit 1
fi

patch_root="$(dirname "${series_file}")"
while IFS= read -r patch_name; do
  [[ -z "${patch_name}" || "${patch_name}" == \#* ]] && continue
  patch_file="${patch_root}/${patch_name}"
  if git -C "${source_dir}" apply --reverse --check "${patch_file}" 2>/dev/null; then
    continue
  fi
  git -C "${source_dir}" apply --check "${patch_file}"
  git -C "${source_dir}" apply "${patch_file}"
done < "${series_file}"

find "${source_dir}" -type f -name '*.md' -delete

printf '%s\n' "${source_dir}"
