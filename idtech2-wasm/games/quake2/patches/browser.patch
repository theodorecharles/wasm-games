new file mode 100644
index 00000000..f61e1236
--- /dev/null
+++ b/src/backends/web/hunk.c
@@ -0,0 +1,67 @@
+/*
+ * Copyright (C) 1997-2001 Id Software, Inc.
+ * Copyright (C) 2026 quake2-wasm contributors
+ *
+ * GPL-2.0-or-later. Browser replacement for the native mmap hunk.
+ */
+
+#include <stdlib.h>
+
+#include "../../common/header/common.h"
+
+static byte *membase;
+static size_t maxhunksize;
+static size_t curhunksize;
+
+void *
+Hunk_Begin(int maxsize)
+{
+	maxhunksize = (size_t)maxsize + sizeof(size_t) + 32;
+	curhunksize = 0;
+	membase = malloc(maxhunksize);
+
+	if (!membase)
+	{
+		Sys_Error("unable to allocate %d hunk bytes", maxsize);
+	}
+
+	*((size_t *)membase) = 0;
+	return membase + sizeof(size_t);
+}
+
+void *
+Hunk_Alloc(int size)
+{
+	byte *result;
+	size = (size + 31) & ~31;
+
+	if (curhunksize + (size_t)size + sizeof(size_t) > maxhunksize)
+	{
+		Sys_Error("%s: overflow %zu > %zu", __func__,
+			curhunksize + (size_t)size, maxhunksize);
+	}
+
+	result = membase + sizeof(size_t) + curhunksize;
+	curhunksize += (size_t)size;
+	return result;
+}
+
+int
+Hunk_End(void)
+{
+	*((size_t *)membase) = curhunksize + sizeof(size_t);
+	return (int)curhunksize;
+}
+
+void
+Hunk_Free(void *base)
+{
+	if (base)
+	{
+		free(((byte *)base) - sizeof(size_t));
+	}
+
+	membase = NULL;
+	maxhunksize = 0;
+	curhunksize = 0;
+}
diff --git a/src/backends/web/main.c b/src/backends/web/main.c
new file mode 100644
index 00000000..bafa2858
--- /dev/null
+++ b/src/backends/web/main.c
@@ -0,0 +1,377 @@
+/*
+ * Copyright (C) 1997-2001 Id Software, Inc.
+ * Copyright (C) 2026 quake2-wasm contributors
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include <emscripten.h>
+
+#include "../../client/header/client.h"
+#include "../../client/header/keyboard.h"
+#include "../../client/vid/header/vid.h"
+#include "../../common/header/common.h"
+
+qboolean q2web_input_captured = false;
+static qboolean q2web_started = false;
+static qboolean q2web_controls_announced = false;
+static qboolean q2web_capture_intent = false;
+#define Q2WEB_CONTROLLER_KEYS 512
+static byte q2web_controller_keys[Q2WEB_CONTROLLER_KEYS];
+
+EM_JS(void, Q2Web_NotifyPersistence, (int immediate), {
+	if (typeof Module.quake2PersistenceChanged === 'function')
+		Module.quake2PersistenceChanged(Boolean(immediate));
+});
+
+void
+Q2Web_PersistenceChanged(qboolean immediate)
+{
+	Q2Web_NotifyPersistence(immediate ? 1 : 0);
+}
+
+EMSCRIPTEN_KEEPALIVE void
+Q2Web_WriteConfiguration(void)
+{
+	if (q2web_started)
+	{
+		CL_WriteConfiguration();
+	}
+}
+
+static int
+Q2Web_TranslateControllerKey(int key)
+{
+	if (key > 0 && key < 128)
+	{
+		return key;
+	}
+	switch (key)
+	{
+		case 1001: return K_UPARROW;
+		case 1002: return K_DOWNARROW;
+		case 1003: return K_LEFTARROW;
+		case 1004: return K_RIGHTARROW;
+		case 1010: return K_SHIFT;
+		case 1020: return K_MOUSE1;
+		case 1021: return K_MOUSE2;
+		case 1030: return K_MWHEELDOWN;
+		case 1031: return K_MWHEELUP;
+		default: return 0;
+	}
+}
+
+EMSCRIPTEN_KEEPALIVE void
+Q2Web_ControllerKey(int browser_key, int down)
+{
+	int key;
+
+	if (!q2web_started)
+	{
+		return;
+	}
+	key = Q2Web_TranslateControllerKey(browser_key);
+	if (!key || key >= Q2WEB_CONTROLLER_KEYS || q2web_controller_keys[key] == (down ? 1 : 0))
+	{
+		return;
+	}
+	q2web_controller_keys[key] = down ? 1 : 0;
+	Key_Event(key, down ? true : false, true);
+}
+
+EMSCRIPTEN_KEEPALIVE void
+Q2Web_ControllerReleaseAll(void)
+{
+	int key;
+
+	for (key = 0; key < Q2WEB_CONTROLLER_KEYS; ++key)
+	{
+		if (q2web_controller_keys[key])
+		{
+			Key_Event(key, false, true);
+			q2web_controller_keys[key] = 0;
+		}
+	}
+}
+
+void
+Q2Web_ArmCaptureIntent(void)
+{
+	q2web_capture_intent = true;
+}
+
+void
+Q2Web_ConfigureControls(void)
+{
+	Key_SetBinding('w', "+forward");
+	Key_SetBinding('s', "+back");
+	Key_SetBinding('a', "+moveleft");
+	Key_SetBinding('d', "+moveright");
+	Key_SetBinding(K_SPACE, "+moveup");
+	Key_SetBinding('e', "+use");
+	Key_SetBinding(K_MOUSE1, "+attack");
+	Key_SetBinding(K_MOUSE2, "+moveup");
+	Key_SetBinding(K_MWHEELDOWN, "weapprev");
+	Key_SetBinding(K_MWHEELUP, "weapnext");
+	Key_SetBinding(K_TAB, "+scores");
+	Key_SetBinding(K_SHIFT, "+speed");
+	Key_SetBinding('c', "+movedown");
+	Key_SetBinding('q', "weapnext");
+	Key_SetBinding('z', "");
+	Cvar_Set("sensitivity", "4");
+	Cvar_Set("m_filter", "0");
+	Cvar_Set("horplus", "1");
+	if (!q2web_controls_announced)
+	{
+		Com_Printf("[quake2-wasm] browser controls: WASD, sensitivity 4, mouse look/fire, Space jump, E use\n");
+		q2web_controls_announced = true;
+	}
+}
+
+EMSCRIPTEN_KEEPALIVE void
+Q2Web_SetInputCaptured(int captured)
+{
+	q2web_input_captured = captured ? true : false;
+	if (!q2web_input_captured)
+	{
+		Key_MarkAllUp();
+	}
+}
+
+EMSCRIPTEN_KEEPALIVE void
+Q2Web_EnsureMenu(void)
+{
+	if (!q2web_started || cls.key_dest != key_game)
+	{
+		return;
+	}
+	Key_Event(K_ESCAPE, true, true);
+	Key_Event(K_ESCAPE, false, true);
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_RuntimeState(void)
+{
+	if (!q2web_started || cls.key_dest == key_console || cls.key_dest == key_message)
+	{
+		q2web_capture_intent = false;
+		return 0; /* menu / text input: host pointer must remain released */
+	}
+	if (cls.key_dest == key_menu)
+	{
+		q2web_capture_intent = false;
+		return cls.state == ca_active ? 2 : 0;
+	}
+	if (cls.state != ca_active || !cl.refresh_prepped)
+	{
+		return 4; /* joining or starting a local game */
+	}
+	if (Cvar_VariableValue("paused") != 0.0f)
+	{
+		q2web_capture_intent = false;
+		return 2;
+	}
+	if (cl.cinematictime > 0 || cl.frame.playerstate.pmove.pm_type == PM_FREEZE)
+	{
+		q2web_capture_intent = false;
+		return 3;
+	}
+	q2web_capture_intent = false;
+	return cls.key_dest == key_game ? 1 : 0;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_CaptureIntent(void)
+{
+	return q2web_capture_intent && Q2Web_RuntimeState() == 4;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_ControlsMask(void)
+{
+	int mask = 0;
+	if (keybindings['w'] && strcmp(keybindings['w'], "+forward") == 0) mask |= 1;
+	if (keybindings['s'] && strcmp(keybindings['s'], "+back") == 0) mask |= 2;
+	if (keybindings['a'] && strcmp(keybindings['a'], "+moveleft") == 0) mask |= 4;
+	if (keybindings['d'] && strcmp(keybindings['d'], "+moveright") == 0) mask |= 8;
+	if (keybindings['z'] && keybindings['z'][0] == '\0') mask |= 16;
+	if (Cvar_VariableValue("sensitivity") == 4.0f) mask |= 32;
+	if (Cvar_VariableValue("m_filter") == 0.0f) mask |= 64;
+	if (Cvar_VariableValue("horplus") == 1.0f) mask |= 128;
+	return mask;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_RenderWidth(void)
+{
+	return viddef.width;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_RenderHeight(void)
+{
+	return viddef.height;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_ViewWidth(void)
+{
+	return cl.refdef.width;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_ViewHeight(void)
+{
+	return cl.refdef.height;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_FovX100(void)
+{
+	return (int)(cl.refdef.fov_x * 100.0f);
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_FovY100(void)
+{
+	return (int)(cl.refdef.fov_y * 100.0f);
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_Connected(void)
+{
+	return cls.state == ca_active ? 1 : 0;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_OriginX100(void)
+{
+	return (int)(cl.refdef.vieworg[0] * 100.0f);
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_OriginY100(void)
+{
+	return (int)(cl.refdef.vieworg[1] * 100.0f);
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_OriginZ100(void)
+{
+	return (int)(cl.refdef.vieworg[2] * 100.0f);
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_YawX100(void)
+{
+	return (int)(cl.refdef.viewangles[YAW] * 100.0f);
+}
+
+EMSCRIPTEN_KEEPALIVE void
+Q2Web_ApplyQuality(int level)
+{
+	if (level < 0)
+	{
+		level = 0;
+	}
+	else if (level > 2)
+	{
+		level = 2;
+	}
+
+	Cvar_SetValue("cl_particles", level > 0);
+	Cvar_SetValue("cl_lights", level > 0);
+	Cvar_SetValue("r_shadows", level > 1);
+	Cvar_SetValue("r_anisotropic", level == 0 ? 2 : (level == 1 ? 8 : 16));
+}
+
+EMSCRIPTEN_KEEPALIVE void
+Q2Web_ResizeViewport(int width, int height)
+{
+	if (!q2web_started || width < 320 || height < 200 || width > 8192 || height > 8192)
+	{
+		return;
+	}
+	if ((int)Cvar_VariableValue("r_customwidth") == width &&
+		(int)Cvar_VariableValue("r_customheight") == height)
+	{
+		return;
+	}
+	Cvar_SetValue("r_mode", -1);
+	Cvar_SetValue("r_customwidth", width);
+	Cvar_SetValue("r_customheight", height);
+	if (!GLimp_ResizeWebViewport(width, height))
+	{
+		return;
+	}
+	cl.force_refdef = true;
+	Com_Printf("[quake2-wasm] browser viewport: %dx%d\n", width, height);
+}
+
+int
+main(int argc, char **argv)
+{
+	Sys_SetupFPU();
+
+	for (int i = 0; i < argc; ++i)
+	{
+		if (strcmp(argv[i], "-portable") == 0)
+		{
+			is_portable = true;
+		}
+		else if (strcmp(argv[i], "-datadir") == 0)
+		{
+			struct stat sb;
+
+			if (++i >= argc)
+			{
+				fprintf(stderr, "-datadir needs an argument\n");
+				return 1;
+			}
+
+			if (stat(argv[i], &sb) != 0 || !S_ISDIR(sb.st_mode))
+			{
+				fprintf(stderr, "-datadir %s is not a directory: %s\n",
+					argv[i], strerror(errno));
+				return 1;
+			}
+
+			Q_strlcpy(datadir, argv[i], sizeof(datadir));
+		}
+		else if (strcmp(argv[i], "-userdir") == 0)
+		{
+			struct stat sb;
+
+			if (++i >= argc)
+			{
+				fprintf(stderr, "-userdir needs an argument\n");
+				return 1;
+			}
+			if (argv[i][0] != '/' || strstr(argv[i], "..") ||
+				strlen(argv[i]) >= MAX_OSPATH || stat(argv[i], &sb) != 0 || !S_ISDIR(sb.st_mode))
+			{
+				fprintf(stderr, "-userdir %s is not a valid mounted directory\n", argv[i]);
+				return 1;
+			}
+			Q2Web_SetHomeDir(argv[i]);
+		}
+	}
+
+	printf("[quake2-wasm] browser filesystem ready; starting Quake II\n");
+	/* Qcommon_Init installs Emscripten's main loop with
+	 * simulate_infinite_loop=true, so control deliberately never reaches the
+	 * statement after it.  Publish readiness before entering that loop;
+	 * modularized JavaScript cannot call these exports until initialization has
+	 * unwound back to the factory promise. */
+	q2web_started = true;
+	Qcommon_Init(argc, argv);
+	return 0;
+}
diff --git a/src/backends/web/network.c b/src/backends/web/network.c
new file mode 100644
index 00000000..8b271490
--- /dev/null
+++ b/src/backends/web/network.c
@@ -0,0 +1,392 @@
+/*
+ * Copyright (C) 1997-2001 Id Software, Inc.
+ * Copyright (C) 2026 quake2-wasm contributors
+ *
+ * GPL-2.0-or-later. Browser multiplayer carries the original Quake II UDP
+ * datagrams unchanged through a framework-managed binary WebSocket relay.
+ */
+
+#include <arpa/inet.h>
+#include <emscripten/emscripten.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../../common/header/common.h"
+
+#define MAX_LOOPBACK 4
+#define Q2WEB_QUEUE_PACKETS 256
+
+typedef struct
+{
+	byte data[MAX_MSGLEN];
+	int datalen;
+} loopmsg_t;
+
+typedef struct
+{
+	loopmsg_t msgs[MAX_LOOPBACK];
+	int get;
+	int send;
+} loopback_t;
+
+static loopback_t loopbacks[2];
+static loopmsg_t q2web_packets[Q2WEB_QUEUE_PACKETS];
+static int q2web_head;
+static int q2web_tail;
+static int q2web_count;
+static int q2web_received;
+static int q2web_sent;
+static int q2web_open;
+static netadr_t q2web_remote_address;
+netadr_t net_local_adr;
+
+EMSCRIPTEN_KEEPALIVE void
+Q2Web_NetworkReceive(const byte *data, int length)
+{
+	loopmsg_t *packet;
+
+	if (!data || length <= 0 || length > MAX_MSGLEN)
+	{
+		return;
+	}
+
+	if (q2web_count == Q2WEB_QUEUE_PACKETS)
+	{
+		q2web_head = (q2web_head + 1) % Q2WEB_QUEUE_PACKETS;
+		q2web_count--;
+	}
+
+	packet = &q2web_packets[q2web_tail];
+	packet->datalen = length;
+	memcpy(packet->data, data, length);
+	q2web_tail = (q2web_tail + 1) % Q2WEB_QUEUE_PACKETS;
+	q2web_count++;
+	q2web_received++;
+}
+
+EMSCRIPTEN_KEEPALIVE void
+Q2Web_NetworkOpened(void)
+{
+	q2web_open = 1;
+}
+
+EMSCRIPTEN_KEEPALIVE void
+Q2Web_NetworkClosed(void)
+{
+	q2web_open = 0;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_NetworkState(void)
+{
+	return q2web_open;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_NetworkPacketsReceived(void)
+{
+	return q2web_received;
+}
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_NetworkPacketsSent(void)
+{
+	return q2web_sent;
+}
+
+EM_JS(int, Q2Web_OpenSocket, (), {
+	var url = Module.quake2WebSocketUrl || "";
+	if (!url) return 0;
+	if (Module.__quake2WebSocket && Module.__quake2WebSocket.readyState <= 1) {
+		if (Module.__quake2WebSocket.readyState === 1) Module._Q2Web_NetworkOpened();
+		return 1;
+	}
+	var socket = new WebSocket(url);
+	var pending = [];
+	socket.binaryType = 'arraybuffer';
+	Module.__quake2WebSocket = socket;
+	Module.__quake2WebSocketPending = pending;
+	socket.onopen = function () {
+		Module._Q2Web_NetworkOpened();
+		for (var index = 0; index < pending.length; index++) socket.send(pending[index]);
+		pending.length = 0;
+	};
+	socket.onmessage = function (event) {
+		var bytes = new Uint8Array(event.data);
+		if (!bytes.length) return;
+		var pointer = Module._malloc(bytes.length);
+		HEAPU8.set(bytes, pointer);
+		Module._Q2Web_NetworkReceive(pointer, bytes.length);
+		Module._free(pointer);
+	};
+	socket.onclose = function () { Module._Q2Web_NetworkClosed(); };
+	socket.onerror = function () { Module._Q2Web_NetworkClosed(); };
+	return 1;
+});
+
+EM_JS(int, Q2Web_SendDatagram, (const byte *data, int length), {
+	var socket = Module.__quake2WebSocket;
+	if (!socket || socket.readyState > 1) return 0;
+	var packet = HEAPU8.slice(data, data + length);
+	if (socket.readyState === 1) socket.send(packet);
+	else {
+		var pending = Module.__quake2WebSocketPending || (Module.__quake2WebSocketPending = []);
+		if (pending.length >= 256) pending.shift();
+		pending.push(packet);
+	}
+	return length;
+});
+
+EM_JS(void, Q2Web_CloseSocket, (), {
+	var socket = Module.__quake2WebSocket;
+	Module.__quake2WebSocket = null;
+	Module.__quake2WebSocketPending = [];
+	if (socket && socket.readyState <= 1) socket.close(1000, 'Quake II client shutdown');
+});
+
+EMSCRIPTEN_KEEPALIVE int
+Q2Web_NetworkConnect(void)
+{
+	return Q2Web_OpenSocket();
+}
+
+void
+NET_Init(void)
+{
+	memset(loopbacks, 0, sizeof(loopbacks));
+	memset(q2web_packets, 0, sizeof(q2web_packets));
+	memset(&net_local_adr, 0, sizeof(net_local_adr));
+	memset(&q2web_remote_address, 0, sizeof(q2web_remote_address));
+	net_local_adr.type = NA_LOOPBACK;
+	q2web_remote_address.type = NA_IP;
+	q2web_remote_address.ip[0] = 127;
+	q2web_remote_address.ip[3] = 1;
+	q2web_remote_address.port = htons(PORT_SERVER);
+	q2web_head = q2web_tail = q2web_count = 0;
+	q2web_received = q2web_sent = q2web_open = 0;
+	Q2Web_OpenSocket();
+	Com_Printf("[quake2-wasm] network: loopback and managed WebSocket datagrams enabled\n");
+}
+
+void
+NET_Shutdown(void)
+{
+	Q2Web_CloseSocket();
+	q2web_open = 0;
+	q2web_count = 0;
+}
+
+void
+NET_Config(qboolean multiplayer)
+{
+	if (multiplayer)
+	{
+		Q2Web_OpenSocket();
+	}
+}
+
+qboolean
+NET_CompareAdr(netadr_t a, netadr_t b)
+{
+	if (a.type != b.type)
+	{
+		return false;
+	}
+
+	if (a.type == NA_LOOPBACK)
+	{
+		return true;
+	}
+
+	if (a.type == NA_IP)
+	{
+		return memcmp(a.ip, b.ip, 4) == 0 && a.port == b.port;
+	}
+
+	if (a.type == NA_IP6)
+	{
+		return memcmp(a.ip, b.ip, 16) == 0 && a.port == b.port;
+	}
+
+	return false;
+}
+
+qboolean
+NET_CompareBaseAdr(netadr_t a, netadr_t b)
+{
+	if (a.type != b.type)
+	{
+		return false;
+	}
+
+	if (a.type == NA_LOOPBACK)
+	{
+		return true;
+	}
+
+	if (a.type == NA_IP)
+	{
+		return memcmp(a.ip, b.ip, 4) == 0;
+	}
+
+	if (a.type == NA_IP6)
+	{
+		return memcmp(a.ip, b.ip, 16) == 0;
+	}
+
+	return false;
+}
+
+char *
+NET_AdrToString(netadr_t a)
+{
+	static char result[80];
+
+	if (a.type == NA_LOOPBACK)
+	{
+		Com_sprintf(result, sizeof(result), "loopback");
+	}
+	else if (a.type == NA_IP)
+	{
+		Com_sprintf(result, sizeof(result), "%u.%u.%u.%u:%u",
+			a.ip[0], a.ip[1], a.ip[2], a.ip[3], ntohs(a.port));
+	}
+	else
+	{
+		Com_sprintf(result, sizeof(result), "unsupported");
+	}
+
+	return result;
+}
+
+qboolean
+NET_StringToAdr(const char *string, netadr_t *address)
+{
+	const char *colon;
+	unsigned int octets[4];
+	unsigned long port = PORT_SERVER;
+
+	memset(address, 0, sizeof(*address));
+	if (!strcmp(string, "localhost") || !strcmp(string, "loopback"))
+	{
+		address->type = NA_LOOPBACK;
+		return true;
+	}
+
+	if (sscanf(string, "%u.%u.%u.%u", &octets[0], &octets[1], &octets[2], &octets[3]) != 4 ||
+		octets[0] > 255 || octets[1] > 255 || octets[2] > 255 || octets[3] > 255)
+	{
+		return false;
+	}
+
+	colon = strrchr(string, ':');
+	if (colon && colon[1])
+	{
+		port = strtoul(colon + 1, NULL, 10);
+		if (!port || port > 65535)
+		{
+			return false;
+		}
+	}
+
+	address->type = NA_IP;
+	address->ip[0] = (byte)octets[0];
+	address->ip[1] = (byte)octets[1];
+	address->ip[2] = (byte)octets[2];
+	address->ip[3] = (byte)octets[3];
+	address->port = htons((unsigned short)port);
+	q2web_remote_address = *address;
+	return true;
+}
+
+qboolean
+NET_IsLocalAddress(netadr_t address)
+{
+	return address.type == NA_LOOPBACK;
+}
+
+static qboolean
+NET_GetLoopPacket(netsrc_t socket, netadr_t *from, sizebuf_t *message)
+{
+	loopback_t *loop = &loopbacks[socket];
+	int index;
+
+	if (loop->send - loop->get > MAX_LOOPBACK)
+	{
+		loop->get = loop->send - MAX_LOOPBACK;
+	}
+
+	if (loop->get >= loop->send)
+	{
+		return false;
+	}
+
+	index = loop->get & (MAX_LOOPBACK - 1);
+	loop->get++;
+	memcpy(message->data, loop->msgs[index].data, loop->msgs[index].datalen);
+	message->cursize = loop->msgs[index].datalen;
+	*from = net_local_adr;
+	return true;
+}
+
+qboolean
+NET_GetPacket(netsrc_t socket, netadr_t *from, sizebuf_t *message)
+{
+	loopmsg_t *packet;
+
+	if (NET_GetLoopPacket(socket, from, message))
+	{
+		return true;
+	}
+	if (socket != NS_CLIENT || !q2web_count)
+	{
+		return false;
+	}
+
+	packet = &q2web_packets[q2web_head];
+	memcpy(message->data, packet->data, packet->datalen);
+	message->cursize = packet->datalen;
+	*from = q2web_remote_address;
+	q2web_head = (q2web_head + 1) % Q2WEB_QUEUE_PACKETS;
+	q2web_count--;
+	return true;
+}
+
+void
+NET_SendPacket(netsrc_t socket, int length, void *data, netadr_t to)
+{
+	loopback_t *loop;
+	int index;
+
+	if (to.type != NA_LOOPBACK)
+	{
+		if ((to.type == NA_IP || to.type == NA_IP6) && length > 0 && length <= MAX_MSGLEN)
+		{
+			q2web_remote_address = to;
+			if (Q2Web_SendDatagram(data, length) > 0)
+			{
+				q2web_sent++;
+			}
+		}
+		return;
+	}
+
+	loop = &loopbacks[socket ^ 1];
+	index = loop->send & (MAX_LOOPBACK - 1);
+	loop->send++;
+
+	if (length > MAX_MSGLEN)
+	{
+		length = MAX_MSGLEN;
+	}
+
+	memcpy(loop->msgs[index].data, data, length);
+	loop->msgs[index].datalen = length;
+}
+
+void
+NET_Sleep(int msec)
+{
+	(void)msec;
+}
