new file mode 100644
index 00000000..d8cd98da
--- /dev/null
+++ b/web/pre.js
@@ -0,0 +1,81 @@
+/* Browser filesystem bootstrap for the native-source Quake II build. */
+
+Module.preRun = Module.preRun || [];
+Module.preRun.push(function quake2PrepareFilesystem() {
+  const expansion = ['xatrix', 'rogue'].includes(Module.quake2Expansion)
+    ? Module.quake2Expansion
+    : '';
+  const dependency = 'quake2-owner-data';
+  const expected = new Map([
+    ['pak0.pak', { size: 183997730, mountName: 'pak0.pak' }],
+    ['pak1.pak', { size: 12992754, mountName: 'pak1.pak' }],
+    ['pak2.pak', { size: 45055, mountName: 'pak2.pak' }]
+  ]);
+  if (expansion === 'xatrix') {
+    expected.set('xatrix-pak0.pak', { size: 93310499, mountName: 'pak0.pak' });
+  } else if (expansion === 'rogue') {
+    expected.set('rogue-pak0.pak', { size: 109117652, mountName: 'pak0.pak' });
+  }
+
+  function status(message) {
+    Module.setStatus?.(message);
+    console.info(`[quake2-wasm] ${message}`);
+  }
+
+  async function validatePreparedEntries(dataSet) {
+    const entries = Array.from(dataSet?.entries || []);
+    const byKey = new Map(entries.map(entry => [String(entry.policy?.key || '').toLowerCase(), entry]));
+    if (entries.length !== expected.size) throw new Error('Quake II game-data set must contain exactly three PAKs.');
+
+    for (const [key, rule] of expected) {
+      const entry = byKey.get(key);
+      if (!entry || !(entry.file instanceof Blob) || entry.file.size !== rule.size || entry.mountName !== rule.mountName) {
+        throw new Error(`Rejected prepared Quake II game file: ${key}.`);
+      }
+      const header = new Uint8Array(await entry.file.slice(0, 4).arrayBuffer());
+      if (header.length !== 4 || header[0] !== 0x50 || header[1] !== 0x41 ||
+          header[2] !== 0x43 || header[3] !== 0x4b) {
+        throw new Error(`${key} does not have a valid PACK header.`);
+      }
+    }
+    return entries;
+  }
+
+  addRunDependency(dependency);
+  (async function prepare() {
+    if (!globalThis.WasmGameFramework) throw new Error('Shared wasm-game-framework package is unavailable.');
+    const entries = await validatePreparedEntries(Module.quake2OwnerData);
+
+    const baseEntries = entries.filter(entry => !String(entry.policy?.key || '').includes('-pak0.pak'));
+    const expansionEntries = entries.filter(entry => String(entry.policy?.key || '') === `${expansion}-pak0.pak`);
+    FS.mkdirTree('/data/baseq2');
+    status('Mounting registered Quake II data from this browser…');
+    await WasmGameFramework.mountOwnerFiles(FS, baseEntries, {
+      root: '/data/baseq2',
+      mode: 'memfs',
+      chunkBytes: 16 * 1024 * 1024,
+      onProgress(detail) {
+        if (detail.phase !== 'mounting') return;
+        const percent = detail.total ? Math.floor(detail.copied * 100 / detail.total) : 0;
+        status(`Mounting registered Quake II data… ${percent}%`);
+      }
+    });
+    if (expansion) {
+      FS.mkdirTree(`/data/${expansion}`);
+      await WasmGameFramework.mountOwnerFiles(FS, expansionEntries, {
+        root: `/data/${expansion}`,
+        mode: 'memfs',
+        chunkBytes: 16 * 1024 * 1024
+      });
+      FS.chmod(`/data/${expansion}`, 0o555);
+    }
+    FS.chmod('/data/baseq2', 0o555);
+    FS.chmod('/data', 0o555);
+    status('Starting Quake II…');
+  })().catch(error => {
+    console.error('[quake2-wasm] startup failed', error);
+    Module.quake2AssetFailed = true;
+    Module.onAssetError?.(error);
+    try { abort(error); } catch (_) {}
+  }).finally(() => removeRunDependency(dependency));
+});
