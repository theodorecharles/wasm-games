+EMSCRIPTEN_KEEPALIVE void Q1_BrowserControllerKey(int browser_key, int down)
+{
+    int key;
+
+    if (!host_started)
+        return;
+    key = Q1_TranslateBrowserControllerKey(browser_key);
+    if (!key || key >= BROWSER_CONTROLLER_KEYS || browser_controller_keys[key] == (down ? 1 : 0))
+        return;
+    browser_controller_keys[key] = down ? 1 : 0;
+    Key_Event(key, down ? true : false);
+}
