+
+EM_JS(void, Q1_NotifyBrowserPersistence, (int immediate), {
+    if (typeof Module.quakePersistenceChanged === 'function')
+        Module.quakePersistenceChanged(Boolean(immediate));
+});
+
+void Sys_BrowserPersistenceChanged(qboolean immediate)
+{
