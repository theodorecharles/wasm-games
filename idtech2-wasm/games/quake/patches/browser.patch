+
+void Sys_DebugNumber(int y, int val) { (void)y; (void)val; }
+
+void Sys_Printf(char *fmt, ...)
+{
+    va_list args;
+    if (nostdout)
+        return;
+    va_start(args, fmt);
+    vprintf(fmt, args);
+    va_end(args);
+}
+void Sys_Warn(char *warning, ...)
+{
+    va_list args;
+    va_start(args, warning);
+    vfprintf(stderr, warning, args);
+    va_end(args);
+}
+
+void Sys_Error(char *error, ...)
+{
+    va_list args;
+    fprintf(stderr, "[Quake WASM] fatal: ");
+    va_start(args, error);
+    vfprintf(stderr, error, args);
+    va_end(args);
+    fprintf(stderr, "\n");
+
+    /*
+     * A fatal Quake error commonly means that the zone or hunk is already
+     * inconsistent.  The native ports attempt a graceful Host_Shutdown here,
+     * but doing so can turn the useful first failure into a second WebAssembly
+     * bounds trap while SDL tears down input or audio.  The page owns those
+     * browser resources and releases them on reload, so preserve the original
+     * C call stack and stop immediately.
+     */
+    emscripten_log(EM_LOG_ERROR | EM_LOG_JS_STACK,
+                   "[Quake WASM] fatal engine call stack");
+    emscripten_cancel_main_loop();
+    abort();
+}
+
+void Sys_Quit(void)
+{
+    emscripten_cancel_main_loop();
+    if (host_started)
+        Host_Shutdown();
+    exit(0);
+}
+
+void Sys_Init(void)
+{
+    Cvar_RegisterVariable(&browser_defaults_version);
+}
+void Sys_MakeCodeWriteable(unsigned long startaddr, unsigned long length)
+{
+    (void)startaddr;
+    (void)length;
+}
+void Sys_LowFPPrecision(void) {}
+void Sys_HighFPPrecision(void) {}
+void Sys_Sleep(void) {}
+void Sys_LineRefresh(void) {}
+void Sys_EditFile(char *filename) { (void)filename; }
+
+int Sys_FileTime(char *path)
+{
+    struct stat info;
+    return stat(path, &info) == -1 ? -1 : (int)info.st_mtime;
+}
+
+void Sys_mkdir(char *path)
+{
+    if (mkdir(path, 0777) == -1 && errno != EEXIST)
+        Sys_Warn("Could not create %s: %s\n", path, strerror(errno));
+}
+
+int Sys_FileOpenRead(char *path, int *handle)
+{
+    struct stat info;
+    *handle = open(path, O_RDONLY);
+    if (*handle == -1)
+        return -1;
+    if (fstat(*handle, &info) == -1)
+        Sys_Error("Error stating %s", path);
+    return (int)info.st_size;
+}
+
+int Sys_FileOpenWrite(char *path)
+{
+    int handle = open(path, O_RDWR | O_CREAT | O_TRUNC, 0666);
+    if (handle == -1)
+        Sys_Error("Error opening %s: %s", path, strerror(errno));
+    return handle;
+}
+
+void Sys_FileClose(int handle) { close(handle); }
+void Sys_FileSeek(int handle, int position) { lseek(handle, position, SEEK_SET); }
+int Sys_FileRead(int handle, void *dest, int count) { return (int)read(handle, dest, (size_t)count); }
+int Sys_FileWrite(int handle, void *src, int count) { return (int)write(handle, src, (size_t)count); }
+
+void Sys_DebugLog(char *file, char *fmt, ...)
+{
+    char text[1024];
+    va_list args;
+    int handle;
+    va_start(args, fmt);
+    vsnprintf(text, sizeof(text), fmt, args);
+    va_end(args);
+    handle = open(file, O_WRONLY | O_CREAT | O_APPEND, 0666);
+    if (handle != -1) {
+        write(handle, text, strlen(text));
+        close(handle);
+    }
+}
+
+double Sys_FloatTime(void)
+{
+    return emscripten_get_now() / 1000.0;
+}
+
+char *Sys_ConsoleInput(void) { return NULL; }
+
+static void Quake_Frame(void)
+{
+    double now = Sys_FloatTime();
+    double elapsed = now - frame_oldtime;
+    int frame_before;
+
+    if (elapsed < 0.001)
+        return;
+    if (elapsed > 0.25)
+        elapsed = 0.25;
+    frame_oldtime = now;
+    frame_before = host_framecount;
+    Host_Frame(elapsed);
+    /* Host_Init only queues quake.rc; the first Host_Frame executes its
+     * default/config bindings. Apply browser defaults afterward so the 1996
+     * A=look-up and Z=look-down layout cannot overwrite WASD. */
+    if (!browser_controls_configured && host_framecount > frame_before) {
+        ConfigureBrowserControls();
+        browser_controls_configured = true;
+    }
+}
+
+int main(int argc, char **argv)
+{
+    quakeparms_t parms;
+    int memory_megabytes = 32;
+    int memory_arg;
+
+    memset(&parms, 0, sizeof(parms));
+    COM_InitArgv(argc, argv);
+    browser_modernized = COM_CheckParm("-modernized") != 0;
+
+    memory_arg = COM_CheckParm("-mem");
+    if (memory_arg && memory_arg + 1 < com_argc)
+        memory_megabytes = (int)Q_atof(com_argv[memory_arg + 1]);
+
+    parms.argc = com_argc;
+    parms.argv = com_argv;
+    parms.memsize = memory_megabytes * 1024 * 1024;
+    parms.membase = malloc((size_t)parms.memsize);
+    parms.basedir = "/";
+    if (!parms.membase)
+        Sys_Error("Unable to allocate %d MB for Quake", memory_megabytes);
+
+    printf("[Quake WASM] starting %s software renderer\n",
+           browser_modernized ? "modernized dynamic" : "original 640x480");
+    printf("[Quake WASM] data root: /id1\n");
+    Host_Init(&parms);
+    host_started = true;
+    Sys_Init();
+
+    frame_oldtime = Sys_FloatTime();
+    /* Multiplayer clients must continue sending acknowledgements when a
+     * second Chrome tab is foregrounded. requestAnimationFrame is suspended
+     * for background tabs, so use the cooperative timeout scheduler. */
+    emscripten_set_main_loop(Quake_Frame, 60, 1);
+    return 0;
+}
