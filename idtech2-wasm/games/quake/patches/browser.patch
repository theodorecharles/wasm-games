+static int TranslateKey(SDL_Keycode key)
+{
+    switch (key) {
+    case SDLK_PAGEUP: return K_PGUP;
+    case SDLK_PAGEDOWN: return K_PGDN;
+    case SDLK_HOME: return K_HOME;
+    case SDLK_END: return K_END;
+    case SDLK_LEFT: return K_LEFTARROW;
+    case SDLK_RIGHT: return K_RIGHTARROW;
+    case SDLK_DOWN: return K_DOWNARROW;
+    case SDLK_UP: return K_UPARROW;
+    case SDLK_ESCAPE: return K_ESCAPE;
+    case SDLK_RETURN:
+    case SDLK_KP_ENTER: return K_ENTER;
+    case SDLK_TAB: return K_TAB;
+    case SDLK_F1: return K_F1;
+    case SDLK_F2: return K_F2;
+    case SDLK_F3: return K_F3;
+    case SDLK_F4: return K_F4;
+    case SDLK_F5: return K_F5;
+    case SDLK_F6: return K_F6;
+    case SDLK_F7: return K_F7;
+    case SDLK_F8: return K_F8;
+    case SDLK_F9: return K_F9;
+    case SDLK_F10: return K_F10;
+    case SDLK_F11: return K_F11;
+    case SDLK_F12: return K_F12;
+    case SDLK_BACKSPACE: return K_BACKSPACE;
+    case SDLK_DELETE: return K_DEL;
+    case SDLK_PAUSE: return K_PAUSE;
+    case SDLK_LSHIFT:
+    case SDLK_RSHIFT: return K_SHIFT;
+    case SDLK_LCTRL:
+    case SDLK_RCTRL: return K_CTRL;
+    case SDLK_LALT:
+    case SDLK_RALT: return K_ALT;
+    case SDLK_INSERT: return K_INS;
+    case SDLK_KP_MULTIPLY: return '*';
+    case SDLK_KP_PLUS: return '+';
+    case SDLK_KP_MINUS: return '-';
+    case SDLK_KP_DIVIDE: return '/';
+    default:
+        if (key >= 32 && key <= 126)
+            return (int)key;
+        return 0;
+    }
+}
+
+void Sys_SendKeyEvents(void)
+{
+    SDL_Event event;
+    int key;
+    byte key_down_this_poll[256];
+
+    memset(key_down_this_poll, 0, sizeof(key_down_this_poll));
+    for (key = 0; key < 256; ++key) {
+        if (key_release_pending[key]) {
+            Key_Event(key, false);
+            key_release_pending[key] = 0;
+        }
+    }
+
+    while (SDL_PollEvent(&event)) {
+        switch (event.type) {
+        case SDL_KEYDOWN:
+        case SDL_KEYUP:
+            if (event.key.repeat)
+                break;
+            key = TranslateKey(event.key.keysym.sym);
+            if (key && event.type == SDL_KEYDOWN) {
+                Key_Event(key, true);
+                key_down_this_poll[key] = 1;
+            } else if (key && key_down_this_poll[key]) {
+                /* Remote-control and accessibility clients can emit a full
+                 * key press between two animation frames. Keep that press
+                 * down for one native frame so Quake's movement sampler sees
+                 * the same input a physical keyboard would provide. */
+                key_release_pending[key] = 1;
+            } else if (key) {
+                Key_Event(key, false);
+            }
+            break;
+        case SDL_MOUSEMOTION:
+            mouse_x += (float)event.motion.xrel;
+            mouse_y += (float)event.motion.yrel;
+            break;
+        case SDL_MOUSEBUTTONDOWN:
+        case SDL_MOUSEBUTTONUP:
+            if (event.button.button == SDL_BUTTON_LEFT)
+                key = K_MOUSE1;
+            else if (event.button.button == SDL_BUTTON_RIGHT)
+                key = K_MOUSE2;
+            else if (event.button.button == SDL_BUTTON_MIDDLE)
+                key = K_MOUSE3;
+            else
+                key = 0;
+            if (key)
+                Key_Event(key, event.type == SDL_MOUSEBUTTONDOWN);
+            break;
+        case SDL_MOUSEWHEEL:
+            key = event.wheel.y > 0 ? K_MWHEELUP : K_MWHEELDOWN;
+            Key_Event(key, true);
+            Key_Event(key, false);
+            break;
+        case SDL_WINDOWEVENT:
+            if (event.window.event == SDL_WINDOWEVENT_FOCUS_LOST) {
+                memset(key_release_pending, 0, sizeof(key_release_pending));
+                Key_ClearStates();
+            }
+            break;
+        case SDL_QUIT:
+            Sys_Quit();
+            break;
+        }
+    }
+}
+
+void VID_SetPalette(unsigned char *palette)
+{
+    int i;
+    memcpy(palette_copy, palette, sizeof(palette_copy));
+    for (i = 0; i < 256; ++i) {
+        unsigned r = palette[i * 3];
+        unsigned g = palette[i * 3 + 1];
+        unsigned b = palette[i * 3 + 2];
+        d_8to24table[i] = 0xff000000u | (r << 16) | (g << 8) | b;
+        d_8to16table[i] = (unsigned short)(((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3));
+    }
+}
+
+void VID_ShiftPalette(unsigned char *palette) { VID_SetPalette(palette); }
+
+void VID_Init(unsigned char *palette)
+{
+    if (SDL_Init(SDL_INIT_VIDEO) != 0)
+        Sys_Error("SDL video initialization failed: %s", SDL_GetError());
+
+    window = SDL_CreateWindow("Quake", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
+        BASEWIDTH, BASEHEIGHT, SDL_WINDOW_SHOWN);
+    if (!window)
+        Sys_Error("SDL window creation failed: %s", SDL_GetError());
+
+    renderer = SDL_CreateRenderer(window, -1, SDL_RENDERER_SOFTWARE);
+    if (!renderer)
+        Sys_Error("SDL renderer creation failed: %s", SDL_GetError());
+
+    /* The software water warp owns a fixed WARP_WIDTH x WARP_HEIGHT scratch
+     * surface even when the normal framebuffer is larger.  Advertising the
+     * 640x480 framebuffer as the warp limit makes D_DrawSpans8 paint hundreds
+     * of kilobytes past that scratch buffer and into the Quake zone. */
+    vid.maxwarpwidth = WARP_WIDTH;
+    vid.maxwarpheight = WARP_HEIGHT;
+    vid.numpages = 1;
+    vid.colormap = host_colormap;
+    vid.fullbright = 256 - LittleLong(*((int *)vid.colormap + 2048));
+    if (!VID_ResizeBuffers(BASEWIDTH, BASEHEIGHT))
+        Sys_Error("Not enough memory for browser video mode");
+
+    VID_SetPalette(palette);
+}
+
+void VID_Shutdown(void)
+{
+    free(rgba_buffer);
+    rgba_buffer = NULL;
+    free(video_allocation);
+    video_allocation = NULL;
+    if (texture) SDL_DestroyTexture(texture);
+    if (renderer) SDL_DestroyRenderer(renderer);
+    if (window) SDL_DestroyWindow(window);
+    texture = NULL;
+    renderer = NULL;
+    window = NULL;
+    SDL_QuitSubSystem(SDL_INIT_VIDEO);
+}
+
+void VID_Update(vrect_t *rects)
+{
+    int count = vid.width * vid.height;
+    int i;
+    (void)rects;
+    for (i = 0; i < count; ++i)
+        rgba_buffer[i] = d_8to24table[vid.buffer[i]];
+    SDL_UpdateTexture(texture, NULL, rgba_buffer, vid.width * (int)sizeof(*rgba_buffer));
+    SDL_RenderClear(renderer);
+    SDL_RenderCopy(renderer, texture, NULL, NULL);
+    SDL_RenderPresent(renderer);
+}
+
+void D_BeginDirectRect(int x, int y, byte *pbitmap, int width, int height)
+{
+    int row;
+    /* File loads begin before VID_Init while the startup WAD is discovered. */
+    if (!vid.buffer || !vid.width || !vid.height)
+        return;
+    if (x < 0)
+        x = vid.width + x - 1;
+    for (row = 0; row < height; ++row)
+        memcpy(vid.buffer + (y + row) * vid.rowbytes + x, pbitmap + row * width, width);
+}
+
+void D_EndDirectRect(int x, int y, int width, int height)
+{
+    (void)x; (void)y; (void)width; (void)height;
+}
+
+void IN_Init(void)
+{
+    Cvar_RegisterVariable(&m_filter);
+    mouse_buttons = 3;
+    (void)mouse_buttons;
+}
+
+EMSCRIPTEN_KEEPALIVE void Q1_BrowserSetInputCaptured(int captured)
+{
+    /* SDL's Emscripten backend requests pointer lock when relative mode is
+     * enabled.  That must happen only after the browser has accepted a real
+     * canvas gesture, never during engine initialization or launcher Play. */
+    SDL_SetRelativeMouseMode(captured ? SDL_TRUE : SDL_FALSE);
+    if (!captured) {
+        mouse_x = mouse_y = 0.0f;
+        old_mouse_x = old_mouse_y = 0.0f;
+        Key_ClearStates();
+    }
+}
+
+EMSCRIPTEN_KEEPALIVE void Q1_BrowserControllerLook(float x, float y)
+{
+    mouse_x += x;
+    mouse_y += y;
+}
+
+void IN_Shutdown(void) { SDL_SetRelativeMouseMode(SDL_FALSE); }
+void IN_Commands(void) {}
+
+void IN_Move(usercmd_t *cmd)
+{
+    float mx = mouse_x;
+    float my = mouse_y;
+
+    if (m_filter.value) {
+        mx = (mx + old_mouse_x) * 0.5f;
+        my = (my + old_mouse_y) * 0.5f;
+    }
+    old_mouse_x = mouse_x;
+    old_mouse_y = mouse_y;
+    mouse_x = mouse_y = 0.0f;
+
+    mx *= sensitivity.value;
+    my *= sensitivity.value;
+    if ((in_strafe.state & 1) || (lookstrafe.value && (in_mlook.state & 1)))
+        cmd->sidemove += m_side.value * mx;
+    else
+        cl.viewangles[YAW] -= m_yaw.value * mx;
+
+    V_StopPitchDrift();
+    if (!(in_strafe.state & 1)) {
+        cl.viewangles[PITCH] += m_pitch.value * my;
+        if (cl.viewangles[PITCH] > 80)
+            cl.viewangles[PITCH] = 80;
+        if (cl.viewangles[PITCH] < -70)
+            cl.viewangles[PITCH] = -70;
+    } else if ((in_strafe.state & 1) && noclip_anglehack) {
+        cmd->upmove -= m_forward.value * my;
+    } else {
+        cmd->forwardmove -= m_forward.value * my;
+    }
+}
