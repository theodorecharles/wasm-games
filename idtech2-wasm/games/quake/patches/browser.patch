+static int Q1_TranslateBrowserControllerKey(int key)
+{
+    if (key > 0 && key < 128)
+        return key;
+    switch (key) {
+    case 1001: return K_UPARROW;
+    case 1002: return K_DOWNARROW;
+    case 1003: return K_LEFTARROW;
+    case 1004: return K_RIGHTARROW;
+    case 1010: return K_SHIFT;
+    case 1020: return K_MOUSE1;
+    case 1021: return K_MOUSE2;
+    case 1030: return K_MWHEELDOWN;
+    case 1031: return K_MWHEELUP;
+    default: return 0;
+    }
+}
