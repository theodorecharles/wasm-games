+
+EMSCRIPTEN_KEEPALIVE int Q1_BrowserRuntimeState(void)
+{
+    if (!host_started)
+    {
+        browser_capture_intent = false;
+        return 0;
+    }
+    if (key_dest != key_game)
+    {
+        browser_capture_intent = false;
+        return (sv.active || cls.state == ca_connected) ? 2 : 0;
+    }
+    /* Menu code raises this bit synchronously for New Game, Load, Save, and
+     * Resume.  Honor it before stale demo/loading state is drained by the
+     * next native frame so pointer lock can use this exact trusted event. */
+    if (browser_capture_intent && cls.demoplayback)
+        return 4;
+    /* An attract demo is not player-controllable gameplay.  Reporting it as
+     * gameplay made an ordinary canvas click hide the cursor and request
+     * pointer lock even though Quake was only playing a demo. */
+    if (cls.demoplayback)
+    {
+        browser_capture_intent = false;
+        return 0;
+    }
+    if (cl.intermission)
+    {
+        browser_capture_intent = false;
+        return 3;
+    }
+    if (sv.paused)
+    {
+        browser_capture_intent = false;
+        return 2;
+    }
+    if (scr_disabled_for_loading || cls.state != ca_connected || cls.signon != SIGNONS)
+        return 4;
+    browser_capture_intent = false;
+    return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE int Q1_BrowserCaptureIntent(void)
+{
+    return browser_capture_intent && Q1_BrowserRuntimeState() == 4;
+}
+
+EMSCRIPTEN_KEEPALIVE int Q1_BrowserControlsMask(void)
+{
+    int mask = 0;
+    if (browser_controls_configured) mask |= 1;
+    if (keybindings['w'] && !strcmp(keybindings['w'], "+forward")) mask |= 2;
+    if (keybindings['s'] && !strcmp(keybindings['s'], "+back")) mask |= 4;
+    if (keybindings['a'] && !strcmp(keybindings['a'], "+moveleft")) mask |= 8;
+    if (keybindings['d'] && !strcmp(keybindings['d'], "+moveright")) mask |= 16;
+    if (keybindings['z'] && keybindings['z'][0] == 0) mask |= 32;
+    if (sensitivity.value == 8.0f) mask |= 64;
+    if (Cvar_VariableValue("m_filter") == 0.0f) mask |= 128;
+    return mask;
+}
+
+EMSCRIPTEN_KEEPALIVE int Q1_BrowserControlsValid(void)
+{
+    return Q1_BrowserControlsMask() == 255;
+}
