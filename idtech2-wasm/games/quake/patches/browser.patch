+EMSCRIPTEN_KEEPALIVE int Q1_BrowserModernized(void)
+{
+    return Sys_BrowserModernized() ? 1 : 0;
+}
+
+EMSCRIPTEN_KEEPALIVE int Q1_BrowserPixelAspectX1000(void)
