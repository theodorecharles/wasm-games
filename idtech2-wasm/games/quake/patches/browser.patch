diff --git a/WinQuake/net_websocket.c b/WinQuake/net_websocket.c
new file mode 100644
index 00000000..76e26272
--- /dev/null
+++ b/WinQuake/net_websocket.c
@@ -0,0 +1,279 @@
+/*
+ * Browser datagram transport for the original Quake networking layer.
+ * Each browser WebSocket is paired with a unique UDP socket by the suite
+ * supervisor, preserving Quake's ordinary datagram protocol unchanged.
+ */
+#include "quakedef.h"
+#include "net_udp.h"
+
+#include <emscripten/emscripten.h>
+
+#define Q1WEB_QUEUE_PACKETS 128
+#define Q1WEB_PACKET_BYTES 2048
+#define Q1WEB_AF_INET 2
+
+typedef struct
+{
+    int length;
+    byte data[Q1WEB_PACKET_BYTES];
+} q1web_packet_t;
+
+static q1web_packet_t q1web_queue[Q1WEB_QUEUE_PACKETS];
+static int q1web_head;
+static int q1web_tail;
+static int q1web_count;
+static int q1web_received;
+static int q1web_sent;
+static int q1web_open;
+static int q1web_server_port;
+
+static void Q1Web_SetAddress(struct qsockaddr *addr, int port)
+{
+    Q_memset(addr, 0, sizeof(*addr));
+    addr->sa_family = Q1WEB_AF_INET;
+    addr->sa_data[0] = (unsigned char)((port >> 8) & 255);
+    addr->sa_data[1] = (unsigned char)(port & 255);
+    addr->sa_data[2] = 127;
+    addr->sa_data[3] = 0;
+    addr->sa_data[4] = 0;
+    addr->sa_data[5] = 1;
+}
+
+EMSCRIPTEN_KEEPALIVE void Q1Web_NetworkReceive(const byte *data, int length)
+{
+    q1web_packet_t *packet;
+
+    if (!data || length <= 0 || length > Q1WEB_PACKET_BYTES)
+        return;
+
+    if (q1web_count == Q1WEB_QUEUE_PACKETS)
+    {
+        q1web_head = (q1web_head + 1) % Q1WEB_QUEUE_PACKETS;
+        q1web_count--;
+    }
+
+    packet = &q1web_queue[q1web_tail];
+    packet->length = length;
+    Q_memcpy(packet->data, data, length);
+    q1web_tail = (q1web_tail + 1) % Q1WEB_QUEUE_PACKETS;
+    q1web_count++;
+    q1web_received++;
+}
+
+EMSCRIPTEN_KEEPALIVE void Q1Web_NetworkOpened(void)
+{
+    q1web_open = 1;
+}
+
+EMSCRIPTEN_KEEPALIVE void Q1Web_NetworkClosed(void)
+{
+    q1web_open = 0;
+}
+
+EMSCRIPTEN_KEEPALIVE int Q1Web_NetworkState(void)
+{
+    return q1web_open;
+}
+
+EMSCRIPTEN_KEEPALIVE int Q1Web_NetworkPacketsReceived(void)
+{
+    return q1web_received;
+}
+
+EMSCRIPTEN_KEEPALIVE int Q1Web_NetworkPacketsSent(void)
+{
+    return q1web_sent;
+}
+
+EM_JS(int, Q1Web_OpenSocket, (), {
+    var url = Module.quakeWebSocketUrl || "";
+    if (!url) return 0;
+    if (Module.__quakeWebSocket && Module.__quakeWebSocket.readyState <= 1) return 1;
+    var socket = new WebSocket(url);
+    var pending = [];
+    socket.binaryType = 'arraybuffer';
+    Module.__quakeWebSocket = socket;
+    Module.__quakeWebSocketPending = pending;
+    socket.onopen = function () {
+        Module._Q1Web_NetworkOpened();
+        for (var i = 0; i < pending.length; i++) socket.send(pending[i]);
+        pending.length = 0;
+    };
+    socket.onmessage = function (event) {
+        var bytes = new Uint8Array(event.data);
+        if (!bytes.length) return;
+        var ptr = Module._malloc(bytes.length);
+        HEAPU8.set(bytes, ptr);
+        Module._Q1Web_NetworkReceive(ptr, bytes.length);
+        Module._free(ptr);
+    };
+    socket.onclose = function () { Module._Q1Web_NetworkClosed(); };
+    socket.onerror = function () { Module._Q1Web_NetworkClosed(); };
+    return 1;
+});
+
+EM_JS(int, Q1Web_SendPacket, (const byte *data, int length), {
+    var socket = Module.__quakeWebSocket;
+    if (!socket || socket.readyState > 1) return 0;
+    var packet = HEAPU8.slice(data, data + length);
+    if (socket.readyState === 1) socket.send(packet);
+    else {
+        var pending = Module.__quakeWebSocketPending || (Module.__quakeWebSocketPending = []);
+        if (pending.length >= 256) pending.shift();
+        pending.push(packet);
+    }
+    return length;
+});
+
+EM_JS(void, Q1Web_CloseSocket, (), {
+    var socket = Module.__quakeWebSocket;
+    Module.__quakeWebSocket = null;
+    Module.__quakeWebSocketPending = [];
+    if (socket && socket.readyState <= 1) socket.close(1000, 'Quake client shutdown');
+});
+
+int UDP_Init(void)
+{
+    q1web_head = q1web_tail = q1web_count = 0;
+    q1web_received = q1web_sent = q1web_open = 0;
+    q1web_server_port = DEFAULTnet_hostport;
+    if (!Q1Web_OpenSocket())
+        return -1;
+    Q_strcpy(my_tcpip_address, "browser relay");
+    tcpipAvailable = true;
+    return 1;
+}
+
+void UDP_Shutdown(void)
+{
+    Q1Web_CloseSocket();
+    q1web_open = 0;
+    q1web_count = 0;
+    tcpipAvailable = false;
+}
+
+void UDP_Listen(qboolean state)
+{
+    (void)state;
+}
+
+int UDP_OpenSocket(int port)
+{
+    (void)port;
+    return 1;
+}
+
+int UDP_CloseSocket(int socket)
+{
+    (void)socket;
+    return 0;
+}
+
+int UDP_Connect(int socket, struct qsockaddr *addr)
+{
+    (void)socket;
+    (void)addr;
+    return 0;
+}
+
+int UDP_CheckNewConnections(void)
+{
+    return -1;
+}
+
+int UDP_Read(int socket, byte *buf, int len, struct qsockaddr *addr)
+{
+    q1web_packet_t *packet;
+    int copied;
+
+    (void)socket;
+    if (!q1web_count)
+        return 0;
+
+    packet = &q1web_queue[q1web_head];
+    copied = packet->length < len ? packet->length : len;
+    Q_memcpy(buf, packet->data, copied);
+    q1web_head = (q1web_head + 1) % Q1WEB_QUEUE_PACKETS;
+    q1web_count--;
+    Q1Web_SetAddress(addr, q1web_server_port);
+    return copied;
+}
+
+int UDP_Write(int socket, byte *buf, int len, struct qsockaddr *addr)
+{
+    int result;
+
+    (void)socket;
+    (void)addr;
+    result = Q1Web_SendPacket(buf, len);
+    if (result > 0)
+        q1web_sent++;
+    return result ? len : -1;
+}
+
+int UDP_Broadcast(int socket, byte *buf, int len)
+{
+    return UDP_Write(socket, buf, len, NULL);
+}
+
+char *UDP_AddrToString(struct qsockaddr *addr)
+{
+    static char text[32];
+    sprintf(text, "127.0.0.1:%d", UDP_GetSocketPort(addr));
+    return text;
+}
+
+int UDP_StringToAddr(char *string, struct qsockaddr *addr)
+{
+    char *colon;
+    int port;
+
+    port = DEFAULTnet_hostport;
+    colon = Q_strrchr(string, ':');
+    if (colon && colon[1])
+        port = Q_atoi(colon + 1);
+    Q1Web_SetAddress(addr, port);
+    return 0;
+}
+
+int UDP_GetSocketAddr(int socket, struct qsockaddr *addr)
+{
+    (void)socket;
+    Q1Web_SetAddress(addr, DEFAULTnet_hostport);
+    return 0;
+}
+
+int UDP_GetNameFromAddr(struct qsockaddr *addr, char *name)
+{
+    Q_strcpy(name, UDP_AddrToString(addr));
+    return 0;
+}
+
+int UDP_GetAddrFromName(char *name, struct qsockaddr *addr)
+{
+    return UDP_StringToAddr(name, addr);
+}
+
+int UDP_AddrCompare(struct qsockaddr *addr1, struct qsockaddr *addr2)
+{
+    if (addr1->sa_family != addr2->sa_family)
+        return -1;
+    if (Q_memcmp(addr1->sa_data + 2, addr2->sa_data + 2, 4))
+        return -1;
+    if (addr1->sa_data[0] != addr2->sa_data[0] || addr1->sa_data[1] != addr2->sa_data[1])
+        return 1;
+    return 0;
+}
+
+int UDP_GetSocketPort(struct qsockaddr *addr)
+{
+    return ((int)addr->sa_data[0] << 8) | addr->sa_data[1];
+}
+
+int UDP_SetSocketPort(struct qsockaddr *addr, int port)
+{
+    addr->sa_data[0] = (unsigned char)((port >> 8) & 255);
+    addr->sa_data[1] = (unsigned char)(port & 255);
+    q1web_server_port = port;
+    return 0;
+}
diff --git a/WinQuake/snd_emscripten.c b/WinQuake/snd_emscripten.c
new file mode 100644
index 00000000..2ce0b8ca
--- /dev/null
+++ b/WinQuake/snd_emscripten.c
@@ -0,0 +1,210 @@
+/*
+Copyright (C) 1996-1997 Id Software, Inc.
+
+This program is free software; you can redistribute it and/or
+modify it under the terms of the GNU General Public License
+as published by the Free Software Foundation; either version 2
+of the License, or (at your option) any later version.
+
+Browser SDL2 DMA bridge for the original Quake mixer.
+*/
+
+#include <SDL2/SDL.h>
+#include <emscripten/emscripten.h>
+#include <string.h>
+
+#include "quakedef.h"
+
+#define QUAKE_DMA_SAMPLES 65536
+#define QUAKE_AUDIO_RATE 44100
+
+static SDL_AudioDeviceID audio_device;
+static volatile int dma_sample_pos;
+static qboolean audio_started;
+static volatile unsigned int audio_callbacks;
+static volatile unsigned int audio_nonzero_callbacks;
+
+/* SDL creates its Web Audio context after the framework's Play gesture has
+ * crossed asynchronous data/persistence work.  Resume that engine-owned
+ * context explicitly on later trusted canvas/key gestures. */
+EM_JS(int, SNDDMA_ResumeAudioJS, (), {
+    const context = Module.SDL2 && Module.SDL2.audioContext;
+    if (!context)
+        return 0;
+    if (context.state === 'suspended' && typeof context.resume === 'function') {
+        const pending = context.resume();
+        if (pending && typeof pending.catch === 'function')
+            pending.catch(() => {});
+    }
+    return context.state === 'running' ? 2 : 1;
+});
+
+EM_JS(int, SNDDMA_AudioStateJS, (), {
+    const context = Module.SDL2 && Module.SDL2.audioContext;
+    if (!context)
+        return 0;
+    if (context.state === 'running')
+        return 2;
+    if (context.state === 'suspended')
+        return 1;
+    return 3;
+});
+
+EMSCRIPTEN_KEEPALIVE int SNDDMA_BrowserResumeAudio(void)
+{
+    return SNDDMA_ResumeAudioJS();
+}
+
+EMSCRIPTEN_KEEPALIVE int SNDDMA_BrowserAudioState(void)
+{
+    return SNDDMA_AudioStateJS();
+}
+
+EMSCRIPTEN_KEEPALIVE unsigned int SNDDMA_BrowserCallbacks(void)
+{
+    return audio_callbacks;
+}
+
+EMSCRIPTEN_KEEPALIVE unsigned int SNDDMA_BrowserNonzeroCallbacks(void)
+{
+    return audio_nonzero_callbacks;
+}
+
+static void SNDDMA_AudioCallback(void *userdata, Uint8 *stream, int length)
+{
+    int bytes_per_sample;
+    int ring_bytes;
+    int byte_pos;
+    int copy_bytes;
+
+    (void)userdata;
+    audio_callbacks++;
+
+    if (!audio_started || !shm || !shm->buffer || !shm->soundalive) {
+        memset(stream, 0, (size_t)length);
+        return;
+    }
+
+    bytes_per_sample = shm->samplebits / 8;
+    ring_bytes = shm->samples * bytes_per_sample;
+    byte_pos = dma_sample_pos * bytes_per_sample;
+
+    while (length > 0) {
+        int index;
+        copy_bytes = ring_bytes - byte_pos;
+        if (copy_bytes > length)
+            copy_bytes = length;
+        memcpy(stream, shm->buffer + byte_pos, (size_t)copy_bytes);
+        for (index = 0; index < copy_bytes; ++index) {
+            if (stream[index] != 0) {
+                audio_nonzero_callbacks++;
+                break;
+            }
+        }
+        stream += copy_bytes;
+        length -= copy_bytes;
+        byte_pos = (byte_pos + copy_bytes) % ring_bytes;
+    }
+
+    dma_sample_pos = byte_pos / bytes_per_sample;
+    shm->samplepos = dma_sample_pos;
+}
+
+qboolean SNDDMA_Init(void)
+{
+    SDL_AudioSpec desired;
+    SDL_AudioSpec obtained;
+
+    if (audio_device)
+        return true;
+
+    if (SDL_InitSubSystem(SDL_INIT_AUDIO) != 0) {
+        Con_Printf("[Quake WASM] SDL audio initialization failed: %s\n",
+                   SDL_GetError());
+        return false;
+    }
+
+    memset(&desired, 0, sizeof(desired));
+    desired.freq = QUAKE_AUDIO_RATE;
+    desired.format = AUDIO_S16SYS;
+    desired.channels = 2;
+    desired.samples = 1024;
+    desired.callback = SNDDMA_AudioCallback;
+
+    audio_device = SDL_OpenAudioDevice(NULL, 0, &desired, &obtained,
+                                       SDL_AUDIO_ALLOW_FREQUENCY_CHANGE);
+    if (!audio_device) {
+        Con_Printf("[Quake WASM] SDL audio device failed: %s\n", SDL_GetError());
+        SDL_QuitSubSystem(SDL_INIT_AUDIO);
+        return false;
+    }
+
+    if (obtained.format != AUDIO_S16SYS || obtained.channels != 2) {
+        Con_Printf("[Quake WASM] unsupported SDL audio format %u/%u\n",
+                   (unsigned)obtained.format, (unsigned)obtained.channels);
+        SDL_CloseAudioDevice(audio_device);
+        audio_device = 0;
+        SDL_QuitSubSystem(SDL_INIT_AUDIO);
+        return false;
+    }
+
+    shm = &sn;
+    memset((void *)shm, 0, sizeof(*shm));
+    shm->splitbuffer = false;
+    shm->samplebits = 16;
+    shm->speed = obtained.freq;
+    shm->channels = obtained.channels;
+    shm->samples = QUAKE_DMA_SAMPLES;
+    shm->submission_chunk = 1;
+    shm->buffer = Hunk_AllocName(QUAKE_DMA_SAMPLES * 2, "sound dma");
+    if (!shm->buffer) {
+        SDL_CloseAudioDevice(audio_device);
+        audio_device = 0;
+        SDL_QuitSubSystem(SDL_INIT_AUDIO);
+        return false;
+    }
+
+    memset(shm->buffer, 0, QUAKE_DMA_SAMPLES * 2);
+    shm->gamealive = true;
+    shm->soundalive = true;
+    dma_sample_pos = 0;
+    audio_started = false;
+    audio_callbacks = 0;
+    audio_nonzero_callbacks = 0;
+
+    Con_Printf("[Quake WASM] SDL audio: %d Hz, stereo, 16-bit\n",
+               shm->speed);
+    return true;
+}
+
+int SNDDMA_GetDMAPos(void)
+{
+    if (!audio_device || !shm)
+        return 0;
+    shm->samplepos = dma_sample_pos;
+    return dma_sample_pos;
+}
+
+void SNDDMA_Submit(void)
+{
+    if (audio_device && !audio_started) {
+        audio_started = true;
+        SDL_PauseAudioDevice(audio_device, 0);
+    }
+}
+
+void SNDDMA_Shutdown(void)
+{
+    audio_started = false;
+    if (audio_device) {
+        SDL_PauseAudioDevice(audio_device, 1);
+        SDL_CloseAudioDevice(audio_device);
+        audio_device = 0;
+    }
+    if (shm) {
+        shm->soundalive = false;
+        shm->gamealive = false;
+    }
+    shm = NULL;
+    SDL_QuitSubSystem(SDL_INIT_AUDIO);
+}
