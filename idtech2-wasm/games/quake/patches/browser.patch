+static qboolean VID_ResizeBuffers(int width, int height)
+{
+    SDL_Texture *new_texture;
+    byte *new_video_allocation;
+    unsigned *new_rgba_buffer;
+    int zbuffer_size;
+    int cache_size;
+    int framebuffer_size;
+    int allocation_size;
+
+    if (width == (int)vid.width && height == (int)vid.height && texture && video_allocation && rgba_buffer)
+        return true;
+
+    zbuffer_size = width * height * (int)sizeof(*d_pzbuffer);
+    cache_size = D_SurfaceCacheForRes(width, height);
+    framebuffer_size = width * height;
+    allocation_size = zbuffer_size + cache_size + framebuffer_size;
+    new_video_allocation = malloc((size_t)allocation_size);
+    new_rgba_buffer = malloc((size_t)width * height * sizeof(*new_rgba_buffer));
+    new_texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ARGB8888,
+        SDL_TEXTUREACCESS_STREAMING, width, height);
+    if (!new_video_allocation || !new_rgba_buffer || !new_texture) {
+        free(new_video_allocation);
+        free(new_rgba_buffer);
+        if (new_texture)
+            SDL_DestroyTexture(new_texture);
+        return false;
+    }
+
+    if (video_allocation)
+        D_FlushCaches();
+    free(video_allocation);
+    free(rgba_buffer);
+    if (texture)
+        SDL_DestroyTexture(texture);
+
+    video_allocation = new_video_allocation;
+    rgba_buffer = new_rgba_buffer;
+    texture = new_texture;
+    vid_buffersize = allocation_size;
+    d_pzbuffer = (short *)video_allocation;
+    vid.buffer = video_allocation + zbuffer_size + cache_size;
+    vid.conbuffer = vid.buffer;
+    D_InitCaches(video_allocation + zbuffer_size, cache_size);
+
+    vid.width = vid.conwidth = width;
+    vid.height = vid.conheight = height;
+    vid.rowbytes = vid.conrowbytes = width;
+    /* Quake's vid.aspect is pixel aspect, not display aspect. The historical
+     * formula forces every framebuffer back to a 4:3 projection and therefore
+     * stretches a wide, square-pixel browser framebuffer horizontally.
+     * Modernized uses square pixels; Original remains the fixed 640x480 mode
+     * where both formulas evaluate to 1.0. */
+    vid.aspect = Sys_BrowserModernized()
+        ? 1.0f
+        : ((float)height / (float)width) * (320.0f / 240.0f);
+    vid.recalc_refdef = true;
+    memset(vid.buffer, 0, (size_t)framebuffer_size);
+    memset(rgba_buffer, 0, (size_t)width * height * sizeof(*rgba_buffer));
+
+    SDL_SetWindowSize(window, width, height);
+    SDL_RenderSetLogicalSize(renderer, width, height);
+    Con_Printf("[Quake WASM] software framebuffer: %dx%d\n", width, height);
+    return true;
+}
+
+EMSCRIPTEN_KEEPALIVE void Q1_BrowserResize(int requested_width, int requested_height)
+{
+    float scale;
+    int width;
+    int height;
+
+    if (!Sys_BrowserModernized() || !renderer)
+        return;
+    width = requested_width;
+    height = requested_height;
+    if (width < 320)
+        width = 320;
+    if (height < 200)
+        height = 200;
+    scale = 1.0f;
+    if (width > MAXWIDTH)
+        scale = (float)MAXWIDTH / (float)width;
+    if (height * scale > MAXHEIGHT)
+        scale = (float)MAXHEIGHT / (float)height;
+    width = (int)(width * scale) & ~1;
+    height = (int)(height * scale) & ~1;
+    if (!VID_ResizeBuffers(width, height))
+        Con_Printf("[Quake WASM] could not resize framebuffer to %dx%d\n", width, height);
+}
+
+EMSCRIPTEN_KEEPALIVE int Q1_BrowserRenderWidth(void)
+{
