+EMSCRIPTEN_KEEPALIVE void Q1_BrowserOpenMenu(void)
+{
+    if (!host_started || key_dest != key_game)
+        return;
+    Key_Event(K_ESCAPE, true);
+    Key_Event(K_ESCAPE, false);
+}
+
+/* Menu input normally reaches SDL on the next animation frame. Dispatching
+ * Enter/Escape through this narrow seam lets the adapter observe the native
+ * menu transition during the original trusted browser key event, which is
+ * the only reliable time to request pointer lock. */
+EMSCRIPTEN_KEEPALIVE int Q1_BrowserDispatchMenuKey(int key)
+{
+    if (!host_started || key_dest != key_menu)
+        return 0;
+    if (key == 13)
+        M_Keydown(K_ENTER);
+    else if (key == 27)
+        M_Keydown(K_ESCAPE);
+    else
+        return 0;
+    return 1;
+}
