+EMSCRIPTEN_KEEPALIVE void Q1_BrowserControllerReleaseAll(void)
+{
+    int key;
+
+    for (key = 0; key < BROWSER_CONTROLLER_KEYS; ++key) {
+        if (browser_controller_keys[key]) {
+            Key_Event(key, false);
+            browser_controller_keys[key] = 0;
+        }
+    }
+}
+
+static void ConfigureBrowserControls(void)
+{
+    /* Apply the browser layout once, after quake.rc/config.cfg have executed.
+     * The archived version marker lets later launches retain the player's own
+     * sensitivity, key bindings, and other config choices. */
+    if (browser_defaults_version.value >= 2.0f)
+        return;
+    Key_SetBinding('w', "+forward");
+    Key_SetBinding('s', "+back");
+    Key_SetBinding('a', "+moveleft");
+    Key_SetBinding('d', "+moveright");
+    Key_SetBinding(' ', "+jump");
+    Key_SetBinding('e', "+use");
+    Key_SetBinding(K_MOUSE1, "+attack");
+    Key_SetBinding(K_MOUSE2, "+jump");
+    Key_SetBinding(K_MWHEELDOWN, "impulse 12");
+    Key_SetBinding(K_MWHEELUP, "impulse 10");
+    Key_SetBinding(K_TAB, "+showscores");
+    Key_SetBinding(K_SHIFT, "+speed");
+    Key_SetBinding('c', "+movedown");
+    Key_SetBinding('q', "impulse 10");
+    Key_SetBinding('f', "impulse 1");
+    Key_SetBinding('z', "");
+    Cvar_Set("lookstrafe", "0");
+    Cvar_Set("lookspring", "0");
+    Cvar_Set("m_filter", "0");
+    Cvar_Set("sensitivity", "8");
+    Cvar_Set("wasm_browser_defaults_version", "2");
+    Host_WriteConfiguration();
+    Q1_NotifyBrowserPersistence(1);
+    Con_Printf("[Quake WASM] browser controls: WASD, sensitivity 8, mouse look/fire, Space jump, E use\n");
+}
