      "description": "Original or high-resolution dynamic software-rendered Quake.",
      "loadingTitle": "Starting Quake…",
      "icon": "/quake.ico",
      "iconPixelated": true,
      "background": "/quake-512.png",
      "backgroundPosition": "center",
      "backgroundSize": "contain",
      "pwa": {
        "id": "/apps/idtech2/quake",
        "name": "Quake",
        "shortName": "Quake",
        "description": "Original Quake engine in the id Tech 2 WASM suite.",
