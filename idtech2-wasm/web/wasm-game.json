        "backgroundColor": "#000000",
        "icons": [
          { "src": "/quake-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
          { "src": "/quake-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
