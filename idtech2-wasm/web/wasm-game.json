      },
      "displayMode": "4:3",
      "canvasWidth": 640,
      "canvasHeight": 480,
      "pixelated": true,
      "nativeManaged": true,
      "syncBackbuffer": false,
      "controller": {
        "mode": "disabled"
      },
      "persistence": {
        "root": "/persistent/idtech2/{variant}",
        "debounceMs": 750,
        "intervalMs": 5000,
        "requestDurability": true
      },
      "graphics": true,
      "advanced": true,
      "fps": false,
      "dynamicQuality": false,
      "profiles": [
        { "value": "original", "label": "Original — 640×480, 4:3" },
        { "value": "modernized", "label": "Modernized — dynamic high-resolution software renderer" }
      ],
      "defaultProfile": "original",
      "defaultPlayerName": "Ranger",
      "provisioningText": "Select pak0.pak and pak1.pak from the Quake game-data folder. Matching files are cached in this browser after exact validation.",
      "theme": {
        "accent": "#a3472a",
