{
  "id": "idtech1-family",
  "title": "id Tech 1 WASM Suite",
  "kicker": "Native Doom-engine family source ports",
  "description": "Classic id Tech 1 games in the browser.",
  "adapter": "/game-adapter.js",
  "preferencesNamespace": "idtech1-family",
  "defaultVariant": "doom",
  "defaultProfile": "smooth",
  "defaultFps": 120,
  "fpsTargets": [60, 90, 120],
  "identity": false,
  "graphics": true,
  "advanced": true,
  "dynamicQuality": false,
  "fullscreen": true,
  "defaultFullscreen": false,
  "controller": {
    "mode": "disabled"
  },
  "persistence": {
    "root": "/persistent/idtech1/{variant}",
    "debounceMs": 750,
    "intervalMs": 5000,
    "requestDurability": true
  },
  "pointerLock": true,
  "menuCursor": "none",
  "nativeManaged": true,
  "syncBackbuffer": false,
  "canvasWidth": 960,
  "canvasHeight": 720,
  "maxDpr": 1,
  "theme": {
    "panel": "rgb(18 10 9 / 96%)",
    "field": "#180d0c"
  },
  "variants": {
    "doom": {
      "title": "Doom / Ultimate Doom",
      "engine": "Crispy Doom / DSDA-Doom",
      "description": "Chocolate-like original, fixed 4:3 smooth, or native-resolution Modernized play.",
      "icon": "/assets/doom.png",
      "iconPixelated": false,
      "background": "/assets/background-doom.svg",
      "backgroundPosition": "center",
      "backgroundSize": "cover",
      "pwa": {
        "id": "/apps/idtech1/doom",
        "shortName": "Doom",
        "themeColor": "#a8241c",
        "backgroundColor": "#100807",
        "icons": [
          { "src": "/assets/doom-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
          { "src": "/assets/doom-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
        ]
      },
      "displayMode": "4:3",
      "resizeTransition": "immediate",
      "pixelated": false,
      "fps": true,
      "profiles": [
        { "value": "original", "label": "Original — Chocolate-like" },
        { "value": "smooth", "label": "Smooth — Crispy, uncapped" },
        { "value": "modernized", "label": "Modernized — DSDA dynamic" }
      ],
      "theme": { "accent": "#a8241c", "accent-strong": "#ef675d", "border": "#6c2923" }
