+static void D_RunFrame(void)
+{
+    static int oldgametic;
+
+    I_StartFrame();
+    TryRunTics();
+
+    if (oldgametic < gametic)
+    {
+        S_UpdateSounds(players[consoleplayer].mo);
+        oldgametic = gametic;
+    }
+    D_Display();
+
+    if (crispy->post_rendering_hook)
+    {
+        crispy->post_rendering_hook();
+        crispy->post_rendering_hook = NULL;
+    }
+}
