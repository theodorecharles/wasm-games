 class FAutoSegIterator
 {
 	public:
 		FAutoSegIterator(REGINFO &head, REGINFO &tail)
 		{
+#ifdef __EMSCRIPTEN__
+			if ( &head == &ARegHead ) { Head = __start_areg; Tail = __stop_areg; }
+			else if ( &head == &CRegHead ) { Head = __start_creg; Tail = __stop_creg; }
+			else if ( &head == &GRegHead ) { Head = __start_greg; Tail = __stop_greg; }
+			else if ( &head == &MRegHead ) { Head = __start_mreg; Tail = __stop_mreg; }
+			else { Head = __start_yreg; Tail = __stop_yreg; }
+			Probe = Head;
+			BeforeFirst = true;
+#else
 			// Weirdness. Mingw's linker puts these together backwards.
 			if (&head <= &tail)
 			{
@@ -75,28 +94,45 @@ class FAutoSegIterator
 				Tail = &head;
 			}
 			Probe = Head;
+#endif
 		}
 		REGINFO operator*() const
 		{
+#ifdef __EMSCRIPTEN__
+			return !BeforeFirst && Probe < Tail ? *Probe : 0;
+#else
 			return *Probe;
+#endif
 		}
 		FAutoSegIterator &operator++()
 		{
+#ifdef __EMSCRIPTEN__
+			if ( BeforeFirst ) BeforeFirst = false;
+			else if ( Probe < Tail ) ++Probe;
+			while ( Probe < Tail && *Probe == 0 ) ++Probe;
+#else
 			do
 			{
 				++Probe;
 			} while (*Probe == 0 && Probe < Tail);
+#endif
 			return *this;
 		}
 		void Reset()
 		{
 			Probe = Head;
+#ifdef __EMSCRIPTEN__
+			BeforeFirst = true;
+#endif
 		}
 
 	protected:
 		REGINFO *Probe;
 		REGINFO *Head;
 		REGINFO *Tail;
+#ifdef __EMSCRIPTEN__
+		bool BeforeFirst;
+#endif
 };
 
 #endif
