+static SDLKey I_BrowserSDLKey( int keycode )
+{
+	switch ( keycode )
+	{
+	case 1073742049: return SDLK_LSHIFT;
+	case 1073741903: return SDLK_RIGHT;
+	case 1073741904: return SDLK_LEFT;
+	case 1073741905: return SDLK_DOWN;
+	case 1073741906: return SDLK_UP;
+	default: return static_cast<SDLKey>( keycode );
+	}
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void I_BrowserControllerKey( int keycode, int pressed )
+{
+	SDL_Event event;
+	memset( &event, 0, sizeof( event ) );
+	event.type = pressed ? SDL_KEYDOWN : SDL_KEYUP;
+	event.key.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+	event.key.keysym.sym = I_BrowserSDLKey( keycode );
+	MessagePump( event );
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void I_BrowserControllerMouse( int dx, int dy )
+{
+	if ( dx || dy ) PostMouseMove( dx * 3, -dy * 2 );
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void I_BrowserControllerButton( int button, int pressed )
+{
+	SDL_Event event;
+	memset( &event, 0, sizeof( event ) );
+	event.type = pressed ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+	event.button.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+	event.button.button = static_cast<Uint8>( button );
+	MessagePump( event );
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void I_BrowserControllerWheel( int y )
+{
+	if ( y == 0 ) return;
+	I_BrowserControllerButton( y > 0 ? 4 : 5, 1 );
+	I_BrowserControllerButton( y > 0 ? 4 : 5, 0 );
+}
+#endif
