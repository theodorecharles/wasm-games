+static void network_BrowserOpenWebSocket( void )
+{
+	const char *url = Args->CheckValue( "-wss" );
+	if ( url == NULL || !emscripten_websocket_is_supported( ) )
+	{
+		Printf( TEXTCOLOR_RED "A browser WebSocket relay URL is required for multiplayer.\n" );
+		return;
