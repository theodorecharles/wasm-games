+	EmscriptenWebSocketCreateAttributes attributes;
+	emscripten_websocket_init_create_attributes( &attributes );
+	attributes.url = url;
+	attributes.createOnMainThread = EM_TRUE;
+	g_BrowserWebSocket = emscripten_websocket_new( &attributes );
+	if ( g_BrowserWebSocket <= 0 )
+	{
+		Printf( TEXTCOLOR_RED "Could not create the browser UDP relay WebSocket.\n" );
+		return;
+	}
+	emscripten_websocket_set_onopen_callback( g_BrowserWebSocket, NULL, network_BrowserWebSocketOpen );
+	emscripten_websocket_set_onclose_callback( g_BrowserWebSocket, NULL, network_BrowserWebSocketClose );
+	emscripten_websocket_set_onerror_callback( g_BrowserWebSocket, NULL, network_BrowserWebSocketError );
+	emscripten_websocket_set_onmessage_callback( g_BrowserWebSocket, NULL, network_BrowserWebSocketMessage );
+}
