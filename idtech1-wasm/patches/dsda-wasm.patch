@@ -94,9 +94,20 @@ void gld_StaticLightAlpha(float light, float alpha)
 {
   player_t *player = &players[displayplayer];
 
+#ifdef __EMSCRIPTEN__
+  if (player->fixedcolormap)
+    light = 1.0f;
+  else
+    /* RGBA8 textures are authored for display gamma.  A direct linear
+       multiply makes DSDA's normal sector levels much darker in WebGL than
+       either the software colormap or desktop shader. */
+    light = sqrtf(BETWEEN(0.0f, 1.0f, light));
+  glColor4f(light, light, light, alpha);
+#else
   glColor4f(1.0f, 1.0f, 1.0f, alpha);
 
   glsl_SetLightLevel((player->fixedcolormap ? 1.0f : light));
+#endif
 }
 
