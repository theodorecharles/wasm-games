diff --git a/prboom2/src/wasm/gl_compat.c b/prboom2/src/wasm/gl_compat.c
new file mode 100644
index 0000000..fc31a97
--- /dev/null
+++ b/prboom2/src/wasm/gl_compat.c
@@ -0,0 +1,197 @@
+#include <float.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define GL_GLEXT_PROTOTYPES 1
+#include <GL/gl.h>
+#include <GL/glext.h>
+#include <GL/glu.h>
+#include <tesselator.h>
+
+typedef void (*begin_callback_t)(GLenum);
+typedef void (*end_callback_t)(void);
+typedef void (*error_callback_t)(GLenum);
+typedef void (*vertex_callback_t)(void *);
+
+typedef struct
+{
+  TESStesselator *tess;
+  TESSreal *contour;
+  void **contour_data;
+  int contour_count;
+  int contour_capacity;
+  int contour_data_capacity;
+  void **input_data;
+  int input_count;
+  int input_capacity;
+  begin_callback_t begin;
+  end_callback_t end;
+  error_callback_t error;
+  vertex_callback_t vertex;
+} wasm_tess_t;
+
+static int grow(void **buffer, int *capacity, int required, size_t item_size)
+{
+  int next = *capacity ? *capacity : 32;
+  void *resized;
+  while (next < required) next *= 2;
+  if (next == *capacity) return 1;
+  resized = realloc(*buffer, (size_t)next * item_size);
+  if (!resized) return 0;
+  *buffer = resized;
+  *capacity = next;
+  return 1;
+}
+
+void glTexGenf(GLenum coord, GLenum pname, GLfloat param)
+{
+  (void)coord;
+  (void)pname;
+  (void)param;
+}
+
+void glTexGenfv(GLenum coord, GLenum pname, const GLfloat *params)
+{
+  (void)coord;
+  (void)pname;
+  (void)params;
+}
+
+void glGetTexImage(GLenum target, GLint level, GLenum format, GLenum type,
+                   void *pixels)
+{
+  GLint texture = 0;
+  GLint previous = 0;
+  GLint width = 0;
+  GLint height = 0;
+  GLuint framebuffer = 0;
+  if (target != GL_TEXTURE_2D || format != GL_RGBA || type != GL_UNSIGNED_BYTE)
+    return;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+  glGetTexLevelParameteriv(target, level, GL_TEXTURE_WIDTH, &width);
+  glGetTexLevelParameteriv(target, level, GL_TEXTURE_HEIGHT, &height);
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &previous);
+  glGenFramebuffers(1, &framebuffer);
+  glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+  glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, target,
+                         (GLuint)texture, level);
+  if (glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE)
+    glReadPixels(0, 0, width, height, format, type, pixels);
+  glBindFramebuffer(GL_FRAMEBUFFER, (GLuint)previous);
+  glDeleteFramebuffers(1, &framebuffer);
+}
+
+GLUtesselator *gluNewTess(void)
+{
+  wasm_tess_t *wrapper = calloc(1, sizeof(*wrapper));
+  if (!wrapper) return NULL;
+  wrapper->tess = tessNewTess(NULL);
+  if (!wrapper->tess)
+  {
+    free(wrapper);
+    return NULL;
+  }
+  return (GLUtesselator *)wrapper;
+}
+
+void gluDeleteTess(GLUtesselator *tess)
+{
+  wasm_tess_t *wrapper = (wasm_tess_t *)tess;
+  if (!wrapper) return;
+  if (wrapper->tess) tessDeleteTess(wrapper->tess);
+  free(wrapper->contour);
+  free(wrapper->contour_data);
+  free(wrapper->input_data);
+  free(wrapper);
+}
+
+void gluTessCallback(GLUtesselator *tess, GLenum which, _GLUfuncptr callback)
+{
+  wasm_tess_t *wrapper = (wasm_tess_t *)tess;
+  switch (which)
+  {
+    case GLU_TESS_BEGIN: wrapper->begin = (begin_callback_t)callback; break;
+    case GLU_TESS_END: wrapper->end = (end_callback_t)callback; break;
+    case GLU_TESS_ERROR: wrapper->error = (error_callback_t)callback; break;
+    case GLU_TESS_VERTEX: wrapper->vertex = (vertex_callback_t)callback; break;
+    default: break;
+  }
+}
+
+void gluTessBeginPolygon(GLUtesselator *tess, GLvoid *data)
+{
+  wasm_tess_t *wrapper = (wasm_tess_t *)tess;
+  (void)data;
+  wrapper->input_count = 0;
+  wrapper->contour_count = 0;
+}
+
+void gluTessBeginContour(GLUtesselator *tess)
+{
+  ((wasm_tess_t *)tess)->contour_count = 0;
+}
+
+void gluTessVertex(GLUtesselator *tess, GLdouble *location, GLvoid *data)
+{
+  wasm_tess_t *wrapper = (wasm_tess_t *)tess;
+  int next = wrapper->contour_count + 1;
+  if (!grow((void **)&wrapper->contour, &wrapper->contour_capacity, next * 3,
+            sizeof(*wrapper->contour)) ||
+      !grow((void **)&wrapper->contour_data, &wrapper->contour_data_capacity, next,
+            sizeof(*wrapper->contour_data)))
+  {
+    if (wrapper->error) wrapper->error(GLU_OUT_OF_MEMORY);
+    return;
+  }
+  wrapper->contour[wrapper->contour_count * 3 + 0] = (TESSreal)location[0];
+  wrapper->contour[wrapper->contour_count * 3 + 1] = (TESSreal)location[1];
+  wrapper->contour[wrapper->contour_count * 3 + 2] = (TESSreal)location[2];
+  wrapper->contour_data[wrapper->contour_count++] = data;
+}
+
+void gluTessEndContour(GLUtesselator *tess)
+{
+  wasm_tess_t *wrapper = (wasm_tess_t *)tess;
+  int required = wrapper->input_count + wrapper->contour_count;
+  if (!wrapper->contour_count) return;
+  tessAddContour(wrapper->tess, 3, wrapper->contour,
+                 3 * (int)sizeof(*wrapper->contour), wrapper->contour_count);
+  if (!grow((void **)&wrapper->input_data, &wrapper->input_capacity, required,
+            sizeof(*wrapper->input_data)))
+  {
+    if (wrapper->error) wrapper->error(GLU_OUT_OF_MEMORY);
+    return;
+  }
+  memcpy(wrapper->input_data + wrapper->input_count, wrapper->contour_data,
+         (size_t)wrapper->contour_count * sizeof(*wrapper->input_data));
+  wrapper->input_count = required;
+  wrapper->contour_count = 0;
+}
+
+void gluTessEndPolygon(GLUtesselator *tess)
+{
+  wasm_tess_t *wrapper = (wasm_tess_t *)tess;
+  const TESSindex *elements;
+  const TESSindex *source_indices;
+  int element_count;
+  int i;
+  if (!tessTesselate(wrapper->tess, TESS_WINDING_ODD, TESS_POLYGONS, 3, 3, NULL))
+  {
+    if (wrapper->error) wrapper->error(GLU_TESS_ERROR8);
+    return;
+  }
+  elements = tessGetElements(wrapper->tess);
+  source_indices = tessGetVertexIndices(wrapper->tess);
+  element_count = tessGetElementCount(wrapper->tess);
+  if (wrapper->begin) wrapper->begin(GL_TRIANGLES);
+  for (i = 0; i < element_count * 3; ++i)
+  {
+    TESSindex output_index = elements[i];
+    TESSindex source_index;
+    if (output_index == TESS_UNDEF) continue;
+    source_index = source_indices[output_index];
+    if (source_index != TESS_UNDEF && source_index < wrapper->input_count && wrapper->vertex)
+      wrapper->vertex(wrapper->input_data[source_index]);
+  }
+  if (wrapper->end) wrapper->end();
+}
