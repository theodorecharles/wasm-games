+	unsigned long uLen = pStream->GetLen();
+	if (!uLen) {
+		pStream->Release();
+		return false;
+	}
+	char *pData = new char[uLen];
+	pStream->Read(pData, uLen);
+	pStream->Release();
+	bool bOk = bute.Parse(pData, uLen);
+	delete[] pData;
+	return bOk;
+}
